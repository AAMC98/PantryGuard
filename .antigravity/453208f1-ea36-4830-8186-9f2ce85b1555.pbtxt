        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Estimate typical shelf-life days based on category"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function getEstimatedExpiryDate(category: ProductCategory, isCannedOrPreserved = false): string {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const d = new Date();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let daysToAdd = 7;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (isCannedOrPreserved) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    daysToAdd = 365;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    switch (category) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      case \'lacteos\':"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        daysToAdd = 12;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        break;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      case \'proteinas\':"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        daysToAdd = 5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        break;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      case \'verduras\':"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        daysToAdd = 7;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        break;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      case \'frutas\':"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        daysToAdd = 6;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        break;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      case \'granos\':"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        daysToAdd = 180;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        break;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      case \'bebidas\':"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        daysToAdd = 60;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        break;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      default:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        daysToAdd = 30;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  d.setDate(d.getDate() + daysToAdd);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return d.toISOString().split(\'T\')[0];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
