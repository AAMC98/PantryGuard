  file_change {
    absolute_path_uri: "file:///src/components/BarcodeScannerModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useEffect, useRef, useState } from \'react\';\nimport { Html5Qrcode } from \'html5-qrcode\';\nimport { UserPreferences } from \'../types\';\nimport { translations } from \'../utils/i18n\';\nimport { BARCODE_CATALOG, lookupBarcode } from \'../utils/barcodeService\';\n\ninterface BarcodeScannerModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onScanSuccess: (barcode: string, foundData?: any) => void;\n  preferences: UserPreferences;\n}\n\nexport const BarcodeScannerModal: React.FC<BarcodeScannerModalProps> = ({\n  isOpen,\n  onClose,\n  onScanSuccess,\n  preferences,\n}) => {\n  const t = translations[preferences.language];\n  const [torchOn, setTorchOn] = useState(false);\n  const [manualModalOpen, setManualModalOpen] = useState(false);\n  const [manualCode, setManualCode] = useState(\'\');\n  const [cameraError, setCameraError] = useState<string | null>(null);\n  const [isScanning, setIsScanning] = useState(false);\n\n  const html5QrCodeRef = useRef<Html5Qrcode | null>(null);\n  const isStartingRef = useRef(false);\n  const scannerContainerId = \'pantry-guard-barcode-reader\';\n\n  // Sample quick barcodes for simulation\n  const sampleBarcodes = [\n    { code: \'7501000654321\', name: \'Yogurt Griego Natural (7501000654321)\' },\n    { code: \'7501000123456\', name: \'Leche Entera Pasteurizada (7501000123456)\' },\n    { code: \'7501055300075\', name: \'Cereal Corn Flakes (7501055300075)\' },\n    { code: \'7501000789123\', name: \'Huevos de Granja (7501000789123)\' },\n    { code: \'7501000456789\', name: \'Arroz Grano Largo (7501000456789)\' },\n    { code: \'7501000987654\', name: \'Avena en Hojuelas (7501000987654)\' },\n    { code: \'7501011122334\', name: \'At\303\272n en Agua (7501011122334)\' },\n  ];\n\n  // Helper to safely stop & clean up scanner\n  const safelyStopScanner = async (scanner: Html5Qrcode | null) => {\n    if (!scanner) return;\n    try {\n      if (scanner.isScanning) {\n        await scanner.stop();\n      }\n    } catch {\n      // Ignore already stopped or abort error\n    }\n    try {\n      scanner.clear();\n    } catch {\n      // Ignore clear error if DOM node was already removed\n    }\n  };\n\n  const handleScanDone = async (code: string) => {\n    // Play sound feedback\n    try {\n      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = \'sine\';\n      osc.frequency.setValueAtTime(880, ctx.currentTime);\n      gain.gain.setValueAtTime(0.2, ctx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start();\n      osc.stop(ctx.currentTime + 0.15);\n    } catch {\n      // Audio context might be restricted\n    }\n\n    // Stop camera before notifying\n    const scanner = html5QrCodeRef.current;\n    html5QrCodeRef.current = null;\n    await safelyStopScanner(scanner);\n\n    const data = await lookupBarcode(code);\n    onScanSuccess(code, data);\n  };\n\n  const handleClose = async () => {\n    const scanner = html5QrCodeRef.current;\n    html5QrCodeRef.current = null;\n    await safelyStopScanner(scanner);\n    onClose();\n  };\n\n  useEffect(() => {\n    if (!isOpen) return;\n\n    let isMounted = true;\n    setCameraError(null);\n    setIsScanning(false);\n    setTorchOn(false);\n\n    const startScanner = async () => {\n      if (!isMounted) return;\n      const el = document.getElementById(scannerContainerId);\n      if (!el) return;\n\n      try {\n        isStartingRef.current = true;\n        const scanner = new Html5Qrcode(scannerContainerId);\n        html5QrCodeRef.current = scanner;\n\n        const config = {\n          fps: 15,\n          qrbox: { width: 280, height: 200 },\n          aspectRatio: 1.3333,\n        };\n\n        await scanner.start(\n          { facingMode: \'environment\' },\n          config,\n          (decodedText) => {\n            if (isMounted) {\n              handleScanDone(decodedText);\n            }\n          },\n          () => {\n            // Ignore scan errors (frame not recognized)\n          }\n        );\n\n        isStartingRef.current = false;\n\n        if (!isMounted) {\n          await safelyStopScanner(scanner);\n          return;\n        }\n\n        setIsScanning(true);\n      } catch (err: any) {\n        isStartingRef.current = false;\n        console.warn(\'Camera scan initialization notice:\', err);\n        if (isMounted) {\n          setCameraError(t.scanner.cameraError);\n          setIsScanning(false);\n        }\n      }\n    };\n\n    // Small delay to ensure DOM element is rendered\n    const timer = setTimeout(() => {\n      startScanner();\n    }, 200);\n\n    return () => {\n      isMounted = false;\n      clearTimeout(timer);\n      const scanner = html5QrCodeRef.current;\n      html5QrCodeRef.current = null;\n      if (scanner) {\n        safelyStopScanner(scanner).catch(() => {});\n      }\n    };\n  }, [isOpen]);\n\n  const toggleFlashlight = async () => {\n    try {\n      if (html5QrCodeRef.current && html5QrCodeRef.current.isScanning) {\n        // Toggle torch if supported\n        const track = (html5QrCodeRef.current as any).getRunningTrackCameraCapabilities?.();\n        if (track && track.torch) {\n          await (html5QrCodeRef.current as any).applyVideoConstraints({\n            advanced: [{ torch: !torchOn }],\n          });\n        }\n      }\n      setTorchOn(!torchOn);\n    } catch {\n      setTorchOn(!torchOn);\n    }\n  };\n\n  const handleSimulate = (code?: string) => {\n    const chosen = code || sampleBarcodes[Math.floor(Math.random() * sampleBarcodes.length)].code;\n    handleScanDone(chosen);\n  };\n\n  const handleManualSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!manualCode.trim()) return;\n    setManualModalOpen(false);\n    handleScanDone(manualCode.trim());\n  };\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black flex flex-col justify-between overflow-hidden\">\n      {/* Background Camera Viewport */}\n      <div className=\"absolute inset-0 z-0 flex items-center justify-center bg-[#111318]\">\n        <div id={scannerContainerId} className=\"w-full h-full object-cover\"></div>\n        {cameraError && (\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-black/80 z-10\">\n            <span className=\"material-symbols-outlined text-5xl text-[#ff7a2b] mb-3\">\n              videocam_off\n            </span>\n            <p className=\"text-white text-base max-w-sm mb-4\">\n              {t.scanner.cameraError}\n            </p>\n            <p className=\"text-white/70 text-xs max-w-xs\">\n              Usa los botones de abajo para simular el escaneo o ingresar el c\303\263digo manualmente.\n            </p>\n          </div>\n        )}\n      </div>\n\n      {/* Top Controls */}\n      <div className=\"relative z-20 flex justify-between items-center p-4 pt-safe-top mt-2\">\n        <button\n          onClick={handleClose}\n          aria-label=\"Cerrar esc\303\241ner\"\n          className=\"w-12 h-12 flex items-center justify-center rounded-full bg-black/40 backdrop-blur-md text-white hover:bg-black/60 transition-colors\"\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">close</span>\n        </button>\n\n        <h3 className=\"text-white font-semibold text-base drop-shadow-md\">\n          {t.scanner.title}\n        </h3>\n\n        <button\n          onClick={toggleFlashlight}\n          aria-label={t.scanner.flashlight}\n          className={`w-12 h-12 flex items-center justify-center rounded-full backdrop-blur-md text-white transition-colors ${\n            torchOn ? \'bg-[#096430]\' : \'bg-black/40 hover:bg-black/60\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">\n            {torchOn ? \'flashlight_off\' : \'flashlight_on\'}\n          </span>\n        </button>\n      </div>\n\n      {/* Center Reticle Viewport Overlay */}\n      <div className=\"relative z-10 flex-grow flex flex-col items-center justify-center px-6 pointer-events-none\">\n        <p className=\"text-white font-semibold text-lg text-center mb-6 drop-shadow-lg px-4 bg-black/30 py-1.5 rounded-full backdrop-blur-sm\">\n          {t.scanner.instruction}\n        </p>\n\n        {/* Reticle Box */}\n        <div className=\"relative w-full max-w-xs aspect-[4/3] rounded-2xl border border-white/20 overflow-hidden shadow-[0_0_0_9999px_rgba(0,0,0,0.55)]\">\n          {/* Corner Accents */}\n          <div className=\"absolute top-0 left-0 w-8 h-8 border-t-4 border-l-4 border-[#87d897] rounded-tl-xl\"></div>\n          <div className=\"absolute top-0 right-0 w-8 h-8 border-t-4 border-r-4 border-[#87d897] rounded-tr-xl\"></div>\n          <div className=\"absolute bottom-0 left-0 w-8 h-8 border-b-4 border-l-4 border-[#87d897] rounded-bl-xl\"></div>\n          <div className=\"absolute bottom-0 right-0 w-8 h-8 border-b-4 border-r-4 border-[#87d897] rounded-br-xl\"></div>\n\n          {/* Laser Scanning Line */}\n          <div className=\"absolute left-0 right-0 h-1 bg-[#87d897] shadow-[0_0_12px_3px_rgba(135,216,151,0.9)] animate-scan-line\"></div>\n\n          {/* Central Barcode Target Icon */}\n          <div className=\"absolute inset-0 flex items-center justify-center opacity-30\">\n            <span className=\"material-symbols-outlined text-6xl text-white\">\n              barcode_scanner\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Controls */}\n      <div className=\"relative z-20 p-4 pb-8 flex flex-col gap-3 max-w-md mx-auto w-full\">\n        {/* Simulate Scan Button */}\n        <button\n          onClick={() => handleSimulate()}\n          className=\"w-full py-3.5 px-6 rounded-xl bg-[#004a21] hover:bg-[#096430] active:scale-98 border border-[#87d897]/40 text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-lg transition-all\"\n        >\n          <span className=\"material-symbols-outlined text-[20px]\">check_circle</span>\n          {t.scanner.simulateSuccess}\n        </button>\n\n        {/* Enter Code Manually Button */}\n        <button\n          onClick={() => setManualModalOpen(true)}\n          className=\"w-full py-3.5 px-6 rounded-xl bg-white/20 hover:bg-white/30 active:scale-98 backdrop-blur-md border border-white/30 text-white font-semibold text-sm flex items-center justify-center gap-2 transition-all\"\n        >\n          <span className=\"material-symbols-outlined text-[20px]\">keyboard</span>\n          {t.scanner.manualInput}\n        </button>\n\n        {/* Quick sample pills */}\n        <div className=\"flex gap-2 overflow-x-auto no-scrollbar pt-1\">\n          {sampleBarcodes.slice(0, 4).map((s) => (\n            <button\n              key={s.code}\n              onClick={() => handleSimulate(s.code)}\n              className=\"text-xs text-white/90 bg-black/60 hover:bg-[#004a21] border border-white/20 rounded-full px-3 py-1 whitespace-nowrap transition-colors\"\n            >\n              {s.name.split(\' \')[0]}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Manual Input Dialog */}\n      {manualModalOpen && (\n        <div className=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#1e2124] rounded-2xl p-6 w-full max-w-sm shadow-2xl border border-[#e1e2e8] dark:border-[#404940]\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h4 className=\"font-bold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n                {t.scanner.enterBarcodeTitle}\n              </h4>\n              <button\n                onClick={() => setManualModalOpen(false)}\n                className=\"text-[#707a6f] hover:text-[#191c20] dark:hover:text-white\"\n              >\n                <span className=\"material-symbols-outlined\">close</span>\n              </button>\n            </div>\n\n            <form onSubmit={handleManualSubmit} className=\"flex flex-col gap-4\">\n              <div>\n                <label className=\"text-xs font-medium text-[#404940] dark:text-[#bfc9bd] block mb-1.5\">\n                  {t.productModal.barcodeLabel}\n                </label>\n                <input\n                  type=\"text\"\n                  value={manualCode}\n                  onChange={(e) => setManualCode(e.target.value)}\n                  placeholder={t.scanner.enterBarcodePlaceholder}\n                  className=\"w-full px-3.5 py-2.5 rounded-lg border border-[#707a6f] dark:border-[#404940] bg-white dark:bg-[#2e3135] text-[#191c20] dark:text-white text-sm focus:outline-none focus:border-[#003d87] focus:ring-1 focus:ring-[#003d87]\"\n                  autoFocus\n                />\n              </div>\n\n              {/* Sample quick buttons inside manual */}\n              <div className=\"flex flex-col gap-1.5\">\n                <span className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd]\">\n                  C\303\263digos r\303\241pidos de prueba:\n                </span>\n                <div className=\"grid grid-cols-2 gap-1.5\">\n                  {sampleBarcodes.slice(0, 4).map((s) => (\n                    <button\n                      key={s.code}\n                      type=\"button\"\n                      onClick={() => setManualCode(s.code)}\n                      className=\"text-[11px] text-left p-1.5 rounded bg-[#f2f3f9] dark:bg-[#2e3135] hover:bg-[#e1e2e8] dark:hover:bg-[#404940] text-[#191c20] dark:text-white truncate\"\n                    >\n                      {s.name.split(\' \')[0]}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex gap-2 justify-end mt-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setManualModalOpen(false)}\n                  className=\"px-4 py-2 text-xs font-medium text-[#404940] dark:text-[#bfc9bd] hover:bg-[#f2f3f9] dark:hover:bg-[#2e3135] rounded-lg\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={!manualCode.trim()}\n                  className=\"px-4 py-2 text-xs font-semibold bg-[#004a21] hover:bg-[#096430] disabled:opacity-50 text-white rounded-lg transition-colors shadow-sm\"\n                >\n                  {t.scanner.searchProduct}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
      replacement_content: "import React, { useEffect, useRef, useState } from \'react\';\nimport { Html5Qrcode, Html5QrcodeSupportedFormats } from \'html5-qrcode\';\nimport { UserPreferences } from \'../types\';\nimport { translations } from \'../utils/i18n\';\nimport { lookupBarcode } from \'../utils/barcodeService\';\n\ninterface BarcodeScannerModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onScanSuccess: (barcode: string, foundData?: any) => void;\n  preferences: UserPreferences;\n}\n\nexport const BarcodeScannerModal: React.FC<BarcodeScannerModalProps> = ({\n  isOpen,\n  onClose,\n  onScanSuccess,\n  preferences,\n}) => {\n  const t = translations[preferences?.language || \'es\'];\n  const [torchOn, setTorchOn] = useState(false);\n  const [manualModalOpen, setManualModalOpen] = useState(false);\n  const [manualCode, setManualCode] = useState(\'\');\n  const [cameraError, setCameraError] = useState<string | null>(null);\n  const [, setIsScanning] = useState(false);\n\n  const html5QrCodeRef = useRef<Html5Qrcode | null>(null);\n  const isStartingRef = useRef(false);\n  const scannerContainerId = \'pantry-guard-barcode-reader\';\n\n  // Sample quick barcodes for simulation\n  const sampleBarcodes = [\n    { code: \'7501000654321\', name: \'Yogurt Griego (7501000654321)\' },\n    { code: \'7501000123456\', name: \'Leche Entera (7501000123456)\' },\n    { code: \'7501055300075\', name: \'Cereal Corn Flakes (7501055300075)\' },\n    { code: \'7501000789123\', name: \'Huevos de Granja (7501000789123)\' },\n    { code: \'7501000456789\', name: \'Arroz Grano Largo (7501000456789)\' },\n    { code: \'7501000987654\', name: \'Avena en Hojuelas (7501000987654)\' },\n    { code: \'7501011122334\', name: \'At\303\272n en Agua (7501011122334)\' },\n  ];\n\n  // Helper to safely stop & clean up scanner\n  const safelyStopScanner = async (scanner: Html5Qrcode | null) => {\n    if (!scanner) return;\n    try {\n      if (scanner.isScanning) {\n        await scanner.stop();\n      }\n    } catch {\n      // Ignore already stopped or abort error\n    }\n    try {\n      scanner.clear();\n    } catch {\n      // Ignore clear error if DOM node was already removed\n    }\n  };\n\n  const handleScanDone = async (code: string) => {\n    // Play sound feedback\n    try {\n      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = \'sine\';\n      osc.frequency.setValueAtTime(880, ctx.currentTime);\n      gain.gain.setValueAtTime(0.2, ctx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start();\n      osc.stop(ctx.currentTime + 0.15);\n    } catch {\n      // Audio context might be restricted\n    }\n\n    // Stop camera before notifying\n    const scanner = html5QrCodeRef.current;\n    html5QrCodeRef.current = null;\n    await safelyStopScanner(scanner);\n\n    const data = await lookupBarcode(code);\n    onScanSuccess(code, data);\n  };\n\n  const handleClose = async () => {\n    const scanner = html5QrCodeRef.current;\n    html5QrCodeRef.current = null;\n    await safelyStopScanner(scanner);\n    onClose();\n  };\n\n  useEffect(() => {\n    if (!isOpen) return;\n\n    let isMounted = true;\n    setCameraError(null);\n    setIsScanning(false);\n    setTorchOn(false);\n\n    const startScanner = async () => {\n      if (!isMounted) return;\n      const el = document.getElementById(scannerContainerId);\n      if (!el) return;\n\n      try {\n        isStartingRef.current = true;\n        \n        // Supported common grocery and retail barcode formats\n        const formats = [\n          Html5QrcodeSupportedFormats.EAN_13,\n          Html5QrcodeSupportedFormats.EAN_8,\n          Html5QrcodeSupportedFormats.UPC_A,\n          Html5QrcodeSupportedFormats.UPC_E,\n          Html5QrcodeSupportedFormats.CODE_128,\n          Html5QrcodeSupportedFormats.CODE_39,\n          Html5QrcodeSupportedFormats.QR_CODE,\n        ];\n\n        const scanner = new Html5Qrcode(scannerContainerId, {\n          formatsToSupport: formats,\n          verbose: false,\n        });\n        html5QrCodeRef.current = scanner;\n\n        const config = {\n          fps: 15,\n          qrbox: (viewfinderWidth: number, viewfinderHeight: number) => {\n            const edge = Math.min(viewfinderWidth, viewfinderHeight);\n            const width = Math.min(Math.floor(edge * 0.85), 320);\n            const height = Math.min(Math.floor(width * 0.65), 200);\n            return { width, height };\n          },\n        };\n\n        await scanner.start(\n          { facingMode: \'environment\' },\n          config,\n          (decodedText) => {\n            if (isMounted) {\n              handleScanDone(decodedText);\n            }\n          },\n          () => {\n            // Ignore frame decode errors\n          }\n        );\n\n        isStartingRef.current = false;\n\n        if (!isMounted) {\n          await safelyStopScanner(scanner);\n          return;\n        }\n\n        setIsScanning(true);\n      } catch (err: any) {\n        isStartingRef.current = false;\n        console.warn(\'Camera scan initialization notice:\', err);\n        if (isMounted) {\n          setCameraError(t.scanner.cameraError);\n          setIsScanning(false);\n        }\n      }\n    };\n\n    // Small delay to ensure DOM element is rendered\n    const timer = setTimeout(() => {\n      startScanner();\n    }, 150);\n\n    return () => {\n      isMounted = false;\n      clearTimeout(timer);\n      const scanner = html5QrCodeRef.current;\n      html5QrCodeRef.current = null;\n      if (scanner) {\n        safelyStopScanner(scanner).catch(() => {});\n      }\n    };\n  }, [isOpen]);\n\n  const toggleFlashlight = async () => {\n    try {\n      if (html5QrCodeRef.current && html5QrCodeRef.current.isScanning) {\n        const track = (html5QrCodeRef.current as any).getRunningTrackCameraCapabilities?.();\n        if (track && track.torch) {\n          await (html5QrCodeRef.current as any).applyVideoConstraints({\n            advanced: [{ torch: !torchOn }],\n          });\n        }\n      }\n      setTorchOn(!torchOn);\n    } catch {\n      setTorchOn(!torchOn);\n    }\n  };\n\n  const handleSimulate = (code?: string) => {\n    const chosen = code || sampleBarcodes[Math.floor(Math.random() * sampleBarcodes.length)].code;\n    handleScanDone(chosen);\n  };\n\n  const handleManualSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!manualCode.trim()) return;\n    setManualModalOpen(false);\n    handleScanDone(manualCode.trim());\n  };\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-[#0c0e12] flex flex-col justify-between overflow-hidden h-[100dvh] w-screen select-none\">\n      {/* Background Camera Viewport */}\n      <div className=\"absolute inset-0 z-0 overflow-hidden bg-black flex items-center justify-center\">\n        <div id={scannerContainerId} className=\"w-full h-full\"></div>\n        {cameraError && (\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-black/85 z-10 pointer-events-auto\">\n            <span className=\"material-symbols-outlined text-5xl text-[#ff7a2b] mb-3\">\n              videocam_off\n            </span>\n            <p className=\"text-white text-base font-semibold max-w-sm mb-2\">\n              {t.scanner.cameraError}\n            </p>\n            <p className=\"text-white/80 text-xs max-w-xs mb-4\">\n              Usa la simulaci\303\263n o ingresa el c\303\263digo num\303\251rico manualmente.\n            </p>\n            <button\n              onClick={() => handleSimulate()}\n              className=\"px-5 py-2.5 bg-[#004a21] hover:bg-[#096430] text-white font-semibold text-xs rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-1.5\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">check_circle</span>\n              <span>{t.scanner.simulateSuccess}</span>\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Top Controls */}\n      <div className=\"relative z-20 flex justify-between items-center px-4 py-3 pt-[env(safe-area-inset-top,12px)] bg-gradient-to-b from-black/80 via-black/40 to-transparent\">\n        <button\n          onClick={handleClose}\n          aria-label=\"Cerrar esc\303\241ner\"\n          className=\"w-10 h-10 sm:w-11 sm:h-11 flex items-center justify-center rounded-full bg-black/50 backdrop-blur-md text-white hover:bg-black/70 active:scale-95 transition-all\"\n        >\n          <span className=\"material-symbols-outlined text-[22px]\">close</span>\n        </button>\n\n        <h3 className=\"text-white font-bold text-sm sm:text-base drop-shadow-md\">\n          {t.scanner.title}\n        </h3>\n\n        <button\n          onClick={toggleFlashlight}\n          aria-label={t.scanner.flashlight}\n          className={`w-10 h-10 sm:w-11 sm:h-11 flex items-center justify-center rounded-full backdrop-blur-md text-white active:scale-95 transition-all ${\n            torchOn ? \'bg-[#096430]\' : \'bg-black/50 hover:bg-black/70\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-[22px]\">\n            {torchOn ? \'flashlight_off\' : \'flashlight_on\'}\n          </span>\n        </button>\n      </div>\n\n      {/* Center Reticle Viewport Overlay */}\n      <div className=\"relative z-10 flex-grow flex flex-col items-center justify-center px-4 pointer-events-none my-auto\">\n        <p className=\"text-white font-medium text-xs sm:text-sm text-center mb-4 drop-shadow-md px-3.5 py-1.5 rounded-full bg-black/50 backdrop-blur-sm border border-white/10\">\n          {t.scanner.instruction}\n        </p>\n\n        {/* Reticle Box */}\n        <div className=\"relative w-full max-w-[280px] sm:max-w-xs aspect-[4/3] rounded-2xl border border-white/30 overflow-hidden bg-black/20 backdrop-blur-[0.5px] shadow-[0_0_24px_rgba(0,0,0,0.7)]\">\n          {/* Corner Accents */}\n          <div className=\"absolute top-0 left-0 w-7 h-7 border-t-4 border-l-4 border-[#87d897] rounded-tl-xl\"></div>\n          <div className=\"absolute top-0 right-0 w-7 h-7 border-t-4 border-r-4 border-[#87d897] rounded-tr-xl\"></div>\n          <div className=\"absolute bottom-0 left-0 w-7 h-7 border-b-4 border-l-4 border-[#87d897] rounded-bl-xl\"></div>\n          <div className=\"absolute bottom-0 right-0 w-7 h-7 border-b-4 border-r-4 border-[#87d897] rounded-br-xl\"></div>\n\n          {/* Laser Scanning Line */}\n          <div className=\"absolute left-0 right-0 h-1 bg-[#87d897] shadow-[0_0_12px_3px_rgba(135,216,151,0.9)] animate-scan-line\"></div>\n\n          {/* Central Barcode Target Icon */}\n          <div className=\"absolute inset-0 flex items-center justify-center opacity-25\">\n            <span className=\"material-symbols-outlined text-5xl text-white\">\n              barcode_scanner\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Controls */}\n      <div className=\"relative z-20 px-4 py-4 pb-[env(safe-area-inset-bottom,20px)] flex flex-col gap-2.5 max-w-md mx-auto w-full bg-gradient-to-t from-black/90 via-black/50 to-transparent\">\n        {/* Simulate Scan Button */}\n        <button\n          onClick={() => handleSimulate()}\n          className=\"w-full py-3 px-4 rounded-xl bg-[#004a21] hover:bg-[#096430] active:scale-98 border border-[#87d897]/40 text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-lg transition-all\"\n        >\n          <span className=\"material-symbols-outlined text-[18px]\">check_circle</span>\n          {t.scanner.simulateSuccess}\n        </button>\n\n        {/* Enter Code Manually Button */}\n        <button\n          onClick={() => setManualModalOpen(true)}\n          className=\"w-full py-2.5 px-4 rounded-xl bg-white/15 hover:bg-white/25 active:scale-98 backdrop-blur-md border border-white/20 text-white font-semibold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all\"\n        >\n          <span className=\"material-symbols-outlined text-[18px]\">keyboard</span>\n          {t.scanner.manualInput}\n        </button>\n\n        {/* Quick sample pills */}\n        <div className=\"flex gap-1.5 overflow-x-auto no-scrollbar pt-0.5 justify-center\">\n          {sampleBarcodes.slice(0, 4).map((s) => (\n            <button\n              key={s.code}\n              onClick={() => handleSimulate(s.code)}\n              className=\"text-[11px] text-white/90 bg-black/60 hover:bg-[#004a21] border border-white/20 rounded-full px-2.5 py-1 whitespace-nowrap transition-colors\"\n            >\n              {s.name.split(\' \')[0]}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Manual Input Dialog */}\n      {manualModalOpen && (\n        <div className=\"fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#1e2124] rounded-2xl p-5 sm:p-6 w-full max-w-sm shadow-2xl border border-[#e1e2e8] dark:border-[#404940]\">\n            <div className=\"flex justify-between items-center mb-3\">\n              <h4 className=\"font-bold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n                {t.scanner.enterBarcodeTitle}\n              </h4>\n              <button\n                onClick={() => setManualModalOpen(false)}\n                className=\"text-[#707a6f] hover:text-[#191c20] dark:hover:text-white p-1\"\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">close</span>\n              </button>\n            </div>\n\n            <form onSubmit={handleManualSubmit} className=\"flex flex-col gap-3.5\">\n              <div>\n                <label className=\"text-xs font-medium text-[#404940] dark:text-[#bfc9bd] block mb-1.5\">\n                  {t.productModal.barcodeLabel}\n                </label>\n                <input\n                  type=\"text\"\n                  value={manualCode}\n                  onChange={(e) => setManualCode(e.target.value)}\n                  placeholder={t.scanner.enterBarcodePlaceholder}\n                  className=\"w-full px-3 py-2 rounded-lg border border-[#707a6f] dark:border-[#404940] bg-white dark:bg-[#2e3135] text-[#191c20] dark:text-white text-sm focus:outline-none focus:border-[#003d87] focus:ring-1 focus:ring-[#003d87]\"\n                  autoFocus\n                />\n              </div>\n\n              {/* Sample quick buttons inside manual */}\n              <div className=\"flex flex-col gap-1\">\n                <span className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd]\">\n                  C\303\263digos r\303\241pidos de prueba:\n                </span>\n                <div className=\"grid grid-cols-2 gap-1.5\">\n                  {sampleBarcodes.slice(0, 4).map((s) => (\n                    <button\n                      key={s.code}\n                      type=\"button\"\n                      onClick={() => setManualCode(s.code)}\n                      className=\"text-[11px] text-left p-1.5 rounded bg-[#f2f3f9] dark:bg-[#2e3135] hover:bg-[#e1e2e8] dark:hover:bg-[#404940] text-[#191c20] dark:text-white truncate\"\n                    >\n                      {s.name.split(\' \')[0]}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex gap-2 justify-end mt-1\">\n                <button\n                  type=\"button\"\n                  onClick={() => setManualModalOpen(false)}\n                  className=\"px-3.5 py-2 text-xs font-medium text-[#404940] dark:text-[#bfc9bd] hover:bg-[#f2f3f9] dark:hover:bg-[#2e3135] rounded-lg\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={!manualCode.trim()}\n                  className=\"px-4 py-2 text-xs font-semibold bg-[#004a21] hover:bg-[#096430] disabled:opacity-50 text-white rounded-lg transition-colors shadow-sm\"\n                >\n                  {t.scanner.searchProduct}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
