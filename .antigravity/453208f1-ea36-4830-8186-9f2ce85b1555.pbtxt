  file_change {
    absolute_path_uri: "file:///src/components/AuthModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { UserPreferences, UserProfile } from \'../types\';\nimport { translations } from \'../utils/i18n\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onLogin: (user: UserProfile) => void;\n  preferences: UserPreferences;\n  onShowToast: (message: string) => void;\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  onLogin,\n  preferences,\n  onShowToast,\n}) => {\n  const t = translations[preferences.language];\n  const [isRegister, setIsRegister] = useState(false);\n  const [name, setName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [householdName, setHouseholdName] = useState(\'\');\n  const [isLoading, setIsLoading] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email.trim() || !password) return;\n\n    setIsLoading(true);\n    setTimeout(() => {\n      const initials = (name || email.split(\'@\')[0])\n        .split(\' \')\n        .map((p) => p[0])\n        .slice(0, 2)\n        .join(\'\')\n        .toUpperCase();\n\n      const userProfile: UserProfile = {\n        id: `usr-${Date.now()}`,\n        name: name.trim() || \'Juan P\303\251rez\',\n        email: email.trim(),\n        initials: initials || \'J\',\n        householdName: householdName.trim() || \'Hogar Familiar\',\n        lastSyncedAt: new Date().toISOString(),\n      };\n\n      onLogin(userProfile);\n      setIsLoading(false);\n      onShowToast(\n        isRegister\n          ? \'\302\241Cuenta creada y datos respaldados!\'\n          : \'\302\241Sesi\303\263n iniciada con \303\251xito!\'\n      );\n      onClose();\n    }, 600);\n  };\n\n  const handleQuickDemo = (demoEmail: string, demoName: string) => {\n    onLogin({\n      id: \'usr-1\',\n      name: demoName,\n      email: demoEmail,\n      initials: demoName.charAt(0),\n      householdName: \'Casa Familiar P\303\251rez\',\n      lastSyncedAt: new Date().toISOString(),\n    });\n    onShowToast(\'Sesi\303\263n activa: \' + demoName);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs p-4 animate-in fade-in\">\n      <div className=\"bg-white dark:bg-[#1e2124] rounded-[24px] p-6 w-full max-w-sm shadow-2xl border border-[#e1e2e8] dark:border-[#404940] flex flex-col gap-4\">\n        {/* Header */}\n        <div className=\"flex justify-between items-center\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-[#004a21] text-[#87d897] flex items-center justify-center font-bold\">\n              <span className=\"material-symbols-outlined text-[18px]\">lock</span>\n            </div>\n            <h3 className=\"text-lg font-bold text-[#191c20] dark:text-[#f8f9ff]\">\n              {isRegister ? \'Crear Cuenta\' : \'Iniciar Sesi\303\263n\'}\n            </h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"w-8 h-8 rounded-full flex items-center justify-center text-[#707a6f] hover:bg-[#f2f3f9] dark:hover:bg-[#2e3135]\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n          {isRegister\n            ? \'Guarda tu despensa en la nube y sincroniza con todos tus dispositivos.\'\n            : \'Inicia sesi\303\263n para respaldar tus productos y compartir con tu hogar.\'}\n        </p>\n\n        <form onSubmit={handleSubmit} className=\"flex flex-col gap-3\">\n          {isRegister && (\n            <>\n              <div>\n                <label className=\"text-xs font-semibold text-[#404940] dark:text-[#bfc9bd] block mb-1\">\n                  Nombre completo\n                </label>\n                <input\n                  type=\"text\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  placeholder=\"Juan P\303\251rez\"\n                  className=\"w-full px-3.5 py-2.5 rounded-lg border border-[#bfc9bd] dark:border-[#404940] bg-[#f8f9ff] dark:bg-[#2e3135] text-xs text-[#191c20] dark:text-white focus:outline-none focus:border-[#003d87]\"\n                  required\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-semibold text-[#404940] dark:text-[#bfc9bd] block mb-1\">\n                  Nombre del hogar o despensa\n                </label>\n                <input\n                  type=\"text\"\n                  value={householdName}\n                  onChange={(e) => setHouseholdName(e.target.value)}\n                  placeholder=\"Ej. Casa Familiar\"\n                  className=\"w-full px-3.5 py-2.5 rounded-lg border border-[#bfc9bd] dark:border-[#404940] bg-[#f8f9ff] dark:bg-[#2e3135] text-xs text-[#191c20] dark:text-white focus:outline-none focus:border-[#003d87]\"\n                />\n              </div>\n            </>\n          )}\n\n          <div>\n            <label className=\"text-xs font-semibold text-[#404940] dark:text-[#bfc9bd] block mb-1\">\n              Correo electr\303\263nico\n            </label>\n            <input\n              type=\"email\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n              placeholder=\"juan@example.com\"\n              className=\"w-full px-3.5 py-2.5 rounded-lg border border-[#bfc9bd] dark:border-[#404940] bg-[#f8f9ff] dark:bg-[#2e3135] text-xs text-[#191c20] dark:text-white focus:outline-none focus:border-[#003d87]\"\n              required\n            />\n          </div>\n\n          <div>\n            <label className=\"text-xs font-semibold text-[#404940] dark:text-[#bfc9bd] block mb-1\">\n              Contrase\303\261a\n            </label>\n            <input\n              type=\"password\"\n              value={password}\n              onChange={(e) => setPassword(e.target.value)}\n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              className=\"w-full px-3.5 py-2.5 rounded-lg border border-[#bfc9bd] dark:border-[#404940] bg-[#f8f9ff] dark:bg-[#2e3135] text-xs text-[#191c20] dark:text-white focus:outline-none focus:border-[#003d87]\"\n              required\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={isLoading}\n            className=\"w-full py-3 bg-[#004a21] hover:bg-[#096430] active:scale-98 text-white rounded-full text-xs font-semibold transition-all shadow-sm flex items-center justify-center gap-2 mt-1\"\n          >\n            {isLoading ? (\n              <>\n                <span className=\"material-symbols-outlined text-[18px] animate-spin\">\n                  sync\n                </span>\n                <span>Procesando...</span>\n              </>\n            ) : (\n              <span>{isRegister ? \'Registrarse\' : \'Iniciar Sesi\303\263n\'}</span>\n            )}\n          </button>\n        </form>\n\n        <div className=\"flex flex-col gap-2 pt-2 border-t border-[#e1e2e8] dark:border-[#2e3135] text-center\">\n          <button\n            onClick={() => setIsRegister(!isRegister)}\n            className=\"text-xs text-[#003d87] dark:text-[#aec6ff] font-semibold hover:underline\"\n          >\n            {isRegister\n              ? \'\302\277Ya tienes una cuenta? Inicia sesi\303\263n aqu\303\255\'\n              : \'\302\277No tienes cuenta? Reg\303\255strate aqu\303\255\'}\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => handleQuickDemo(\'juan@example.com\', \'Juan P\303\251rez\')}\n            className=\"text-[11px] text-[#707a6f] hover:text-[#191c20] dark:hover:text-white underline mt-1\"\n          >\n            Entrar como usuario Demo (Juan P\303\251rez)\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
