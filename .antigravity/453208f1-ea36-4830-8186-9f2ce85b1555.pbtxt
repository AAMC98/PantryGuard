    replacement_infos {
      original_chunk {
        target_content: "    try {\n      const response = await fetch(\'/api/ai/ask-advisor\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          question: userMsg.text,\n          products: validPantryItems,\n          preferences,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}`);\n      }\n\n      const data = await response.json();\n      const assistantMsg: ChatMessage = {\n        id: `chef-${Date.now()}`,\n        sender: \'assistant\',\n        text: data.answer || (isSpanish ? \'\302\241Recibido! Buen provecho.\' : \'Got it! Enjoy cooking.\'),\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n\n      setChatMessages((prev) => [...prev, assistantMsg]);\n    } catch (err) {\n      console.error(\'Chef chat error:\', err);\n      const fallbackMsg: ChatMessage = {\n        id: `chef-err-${Date.now()}`,\n        sender: \'assistant\',\n        text: isSpanish\n          ? \'Para tus ingredientes pr\303\263ximos a caducar, te sugiero saltearlos con un toque de aceite de oliva, ajo y tus especias favoritas. \302\241Recuerda desechar siempre los productos ya vencidos!\'\n          : \'For your near-expiry ingredients, saut\303\251ing them with olive oil, garlic, and fresh seasoning is always a delicious quick rescue! Remember to never consume expired items.\',\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setChatMessages((prev) => [...prev, fallbackMsg]);\n    } finally {\n      setIsChefAsking(false);\n    }"
        replacement_content: "    try {\n      const response = await fetch(\'/api/ai/ask-advisor\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          question: userMsg.text,\n          history: chatMessages.slice(-6).map((m) => ({ sender: m.sender, text: m.text })),\n          products: validPantryItems,\n          preferences,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}`);\n      }\n\n      const data = await response.json();\n      const assistantMsg: ChatMessage = {\n        id: `chef-${Date.now()}`,\n        sender: \'assistant\',\n        text: data.answer || (isSpanish ? \'\302\241Recibido! Buen provecho.\' : \'Got it! Enjoy cooking.\'),\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n\n      setChatMessages((prev) => [...prev, assistantMsg]);\n    } catch (err) {\n      console.error(\'Chef chat error:\', err);\n      const fallbackMsg: ChatMessage = {\n        id: `chef-err-${Date.now()}`,\n        sender: \'assistant\',\n        text: isSpanish\n          ? \'Para aprovechar tus alimentos antes de que caduquen, te recomiendo preparar un salteado r\303\241pido, crema vegetal o tortilla combinando los ingredientes m\303\241s frescos de tu despensa.\'\n          : \'For your near-expiry ingredients, saut\303\251ing them with olive oil, garlic, and fresh seasoning is always a delicious quick rescue! Remember to never consume expired items.\',\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setChatMessages((prev) => [...prev, fallbackMsg]);\n    } finally {\n      setIsChefAsking(false);\n    }"
      }
      num_matches: 1
    }
  }
