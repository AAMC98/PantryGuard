  file_change {
    absolute_path_uri: "file:///src/utils/imageBarcodeDecoder.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { BrowserMultiFormatReader } from \'@zxing/browser\';\nimport {\n  BarcodeFormat,\n  DecodeHintType,\n  BinaryBitmap,\n  HybridBinarizer,\n  RGBLuminanceSource,\n  MultiFormatReader,\n} from \'@zxing/library\';\n\n/**\n * Robust Multi-Engine Barcode Reader for Static Images / Photos\n * 1. Native window.BarcodeDetector (if available on Chrome/Safari/Edge/Android)\n * 2. ZXing BrowserMultiFormatReader on raw image\n * 3. Multi-angle & contrast preprocessing on HTML5 Canvas\n */\nexport async function decodeBarcodeFromImageFile(file: File): Promise<string | null> {\n  const imageUrl = URL.createObjectURL(file);\n\n  try {\n    const img = await loadImage(imageUrl);\n\n    // Strategy 1: Native BarcodeDetector (High performance on modern Android & Desktop Chrome/Safari)\n    if (\'BarcodeDetector\' in window) {\n      try {\n        const formats = [\n          \'ean_13\',\n          \'ean_8\',\n          \'upc_a\',\n          \'upc_e\',\n          \'code_128\',\n          \'code_39\',\n          \'code_93\',\n          \'qr_code\',\n          \'data_matrix\',\n          \'itf\',\n        ];\n        const detector = new (window as any).BarcodeDetector({ formats });\n        const barcodes = await detector.detect(img);\n        if (barcodes && barcodes.length > 0) {\n          const rawValue = barcodes[0].rawValue || barcodes[0].displayValue;\n          if (rawValue) {\n            return rawValue.trim();\n          }\n        }\n      } catch (err) {\n        console.debug(\'Native BarcodeDetector pass skipped:\', err);\n      }\n    }\n\n    // Strategy 2: ZXing Multi-Format Reader with all hints enabled\n    const hints = new Map<DecodeHintType, any>();\n    hints.set(DecodeHintType.POSSIBLE_FORMATS, [\n      BarcodeFormat.EAN_13,\n      BarcodeFormat.EAN_8,\n      BarcodeFormat.UPC_A,\n      BarcodeFormat.UPC_E,\n      BarcodeFormat.CODE_128,\n      BarcodeFormat.CODE_39,\n      BarcodeFormat.CODE_93,\n      BarcodeFormat.ITF,\n      BarcodeFormat.QR_CODE,\n    ]);\n    hints.set(DecodeHintType.TRY_HARDER, true);\n\n    const codeReader = new BrowserMultiFormatReader(hints);\n    try {\n      const zxingResult = await codeReader.decodeFromImageUrl(imageUrl);\n      if (zxingResult && zxingResult.getText()) {\n        return zxingResult.getText().trim();\n      }\n    } catch {\n      // Continue to canvas preprocessing\n    }\n\n    // Strategy 3: Multi-angle (0\302\260, 90\302\260, 180\302\260, 270\302\260) and High-Contrast canvas pre-pass\n    const canvasResult = await scanWithRotationsAndContrast(img, hints);\n    if (canvasResult) {\n      return canvasResult;\n    }\n\n    return null;\n  } finally {\n    URL.revokeObjectURL(imageUrl);\n  }\n}\n\nfunction loadImage(src: string): Promise<HTMLImageElement> {\n  return new Promise((resolve, reject) => {\n    const img = new Image();\n    img.crossOrigin = \'anonymous\';\n    img.onload = () => resolve(img);\n    img.onerror = (e) => reject(e);\n    img.src = src;\n  });\n}\n\nasync function scanWithRotationsAndContrast(\n  img: HTMLImageElement,\n  hints: Map<DecodeHintType, any>\n): Promise<string | null> {\n  const angles = [0, 90, 180, 270];\n  const reader = new MultiFormatReader();\n  reader.setHints(hints);\n\n  const canvas = document.createElement(\'canvas\');\n  const ctx = canvas.getContext(\'2d\', { willReadFrequently: true });\n  if (!ctx) return null;\n\n  for (const angle of angles) {\n    const isRotated = angle === 90 || angle === 270;\n    const width = isRotated ? img.naturalHeight : img.naturalWidth;\n    const height = isRotated ? img.naturalWidth : img.naturalHeight;\n\n    // Constrain max resolution for snappy image analysis (max 1280px)\n    const maxDim = 1280;\n    let scale = 1;\n    if (width > maxDim || height > maxDim) {\n      scale = Math.min(maxDim / width, maxDim / height);\n    }\n\n    canvas.width = Math.floor(width * scale);\n    canvas.height = Math.floor(height * scale);\n\n    ctx.save();\n    ctx.translate(canvas.width / 2, canvas.height / 2);\n    ctx.rotate((angle * Math.PI) / 180);\n    ctx.drawImage(\n      img,\n      (-img.naturalWidth * scale) / 2,\n      (-img.naturalHeight * scale) / 2,\n      img.naturalWidth * scale,\n      img.naturalHeight * scale\n    );\n    ctx.restore();\n\n    // 1st pass: Standard luminance\n    try {\n      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);\n      const luminanceSource = new RGBLuminanceSource(\n        new Uint8ClampedArray(imageData.data.buffer),\n        canvas.width,\n        canvas.height\n      );\n      const binaryBitmap = new BinaryBitmap(new HybridBinarizer(luminanceSource));\n      const res = reader.decode(binaryBitmap);\n      if (res && res.getText()) {\n        return res.getText().trim();\n      }\n    } catch {\n      // Continue to contrast pass\n    }\n\n    // 2nd pass: Contrast enhanced grayscale\n    try {\n      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);\n      const data = imageData.data;\n      for (let i = 0; i < data.length; i += 4) {\n        // Grayscale conversion\n        const gray = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];\n        // High contrast curve\n        const factor = (259 * (128 + 100)) / (255 * (259 - 100));\n        const contrasted = factor * (gray - 128) + 128;\n        const clamped = Math.max(0, Math.min(255, contrasted));\n        data[i] = clamped;\n        data[i + 1] = clamped;\n        data[i + 2] = clamped;\n      }\n      ctx.putImageData(imageData, 0, 0);\n\n      const luminanceSource = new RGBLuminanceSource(\n        new Uint8ClampedArray(data.buffer),\n        canvas.width,\n        canvas.height\n      );\n      const binaryBitmap = new BinaryBitmap(new HybridBinarizer(luminanceSource));\n      const res = reader.decode(binaryBitmap);\n      if (res && res.getText()) {\n        return res.getText().trim();\n      }\n    } catch {\n      // Try next angle\n    }\n  }\n\n  return null;\n}\n"
