    instruction: "Remove live chat JSX section from bottom of AIInsightsView"
    replacement_infos {
      original_chunk {
        target_content: "              <button\n                onClick={() => setActiveRecipeDetails(null)}\n                className=\"px-6 py-2.5 rounded-xl bg-[#096430] hover:bg-[#075026] text-white text-xs sm:text-sm font-bold shadow transition-all active:scale-95\"\n              >\n                {isSpanish ? \'\302\241Listo para cocinar!\' : \'Done Cooking!\'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* 7. Live Interactive Chef IA Chat */}\n      <div\n        id=\"chef-live-chat\"\n        className=\"p-6 rounded-3xl bg-white dark:bg-[#1f2227] border border-[#e1e2e8] dark:border-[#2e3135] shadow-sm space-y-4\"\n      >\n        <div className=\"flex items-center justify-between border-b border-[#e1e2e8] dark:border-[#2e3135] pb-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"p-2 rounded-2xl bg-[#096430]/10 text-[#096430] dark:bg-[#8dde9d]/10 dark:text-[#8dde9d]\">\n              <span className=\"material-symbols-outlined text-2xl\">chef_hat</span>\n            </span>\n            <div>\n              <h3 className=\"font-bold text-base text-[#191c20] dark:text-white\">\n                {t.aiInsights.askAdvisorTitle}\n              </h3>\n              <p className=\"text-xs text-[#707970] dark:text-[#8a938a]\">\n                {t.aiInsights.askAdvisorSub}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              id=\"btn-reset-chef-chat\"\n              onClick={handleResetChat}\n              title={isSpanish ? \'Reiniciar conversaci\303\263n\' : \'Reset conversation\'}\n              className=\"flex items-center gap-1 text-xs px-2.5 py-1.5 rounded-xl border border-[#e1e2e8] dark:border-[#2e3135] bg-[#f8f9ff] dark:bg-[#14171a] hover:bg-[#e8ebf0] dark:hover:bg-[#282b30] text-[#707970] dark:text-[#a0aaa0] transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-sm\">restart_alt</span>\n              <span className=\"hidden sm:inline\">{isSpanish ? \'Reiniciar\' : \'Clear\'}</span>\n            </button>\n            <span className=\"hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-[#a2f5b2]/20 text-[#004a21] dark:text-[#a2f5b2]\">\n              <span className=\"w-2 h-2 rounded-full bg-[#096430] dark:bg-[#8dde9d] animate-ping\" />\n              {isSpanish ? \'En l\303\255nea\' : \'Online\'}\n            </span>\n          </div>\n        </div>\n\n        {/* Chat History Container */}\n        <div className=\"space-y-3 max-h-72 overflow-y-auto p-3 rounded-2xl bg-[#f8f9ff] dark:bg-[#14171a] border border-[#e1e2e8] dark:border-[#282b30]\">\n          {chatMessages.map((msg) => (\n            <div\n              key={msg.id}\n              className={`flex items-start gap-2.5 ${\n                msg.sender === \'user\' ? \'justify-end\' : \'justify-start\'\n              }`}\n            >\n              {msg.sender === \'assistant\' && (\n                <div className=\"w-8 h-8 rounded-full bg-[#096430] text-white flex items-center justify-center shrink-0 text-sm font-bold shadow-sm\">\n                  \360\237\221\250\342\200\215\360\237\215\263\n                </div>\n              )}\n              <div\n                className={`max-w-[85%] p-3.5 rounded-2xl text-xs sm:text-sm leading-relaxed shadow-sm ${\n                  msg.sender === \'user\'\n                    ? \'bg-[#096430] text-white rounded-tr-none\'\n                    : \'bg-white dark:bg-[#1f2227] text-[#191c20] dark:text-[#e1e2e8] border border-[#e1e2e8] dark:border-[#2e3135] rounded-tl-none\'\n                }`}\n              >\n                {msg.sender === \'user\' ? (\n                  <div className=\"whitespace-pre-line\">{msg.text}</div>\n                ) : (\n                  <div className=\"prose prose-sm dark:prose-invert max-w-none text-xs sm:text-sm space-y-2 [&_h3]:text-sm [&_h3]:font-bold [&_h3]:mt-2 [&_h3]:mb-1 [&_h3]:text-[#096430] dark:[&_h3]:text-[#8dde9d] [&_ul]:list-disc [&_ul]:pl-4 [&_ol]:list-decimal [&_ol]:pl-4 [&_li]:my-0.5 [&_p]:my-1.5 [&_strong]:font-semibold [&_hr]:my-2.5 [&_hr]:border-[#e1e2e8] dark:[&_hr]:border-[#2e3135]\">\n                    <ReactMarkdown>{msg.text}</ReactMarkdown>\n                  </div>\n                )}\n                <span className=\"block text-[10px] opacity-60 text-right mt-1.5\">{msg.timestamp}</span>\n              </div>\n            </div>\n          ))}\n\n          {isChefAsking && (\n            <div className=\"flex items-center gap-2 text-xs text-[#096430] dark:text-[#8dde9d] p-2 animate-pulse\">\n              <span className=\"material-symbols-outlined text-base animate-spin\">skillet</span>\n              <span>{isSpanish ? \'El Chef IA est\303\241 preparando tu respuesta...\' : \'AI Chef is writing...\'}</span>\n            </div>\n          )}\n        </div>\n\n        {/* Preset Suggested Questions */}\n        <div className=\"flex flex-wrap gap-1.5\">\n          {t.aiInsights.suggestedQuestions.map((q, idx) => (\n            <button\n              key={idx}\n              onClick={() => handleSendChefQuery(q)}\n              className=\"text-xs px-3 py-1.5 rounded-xl bg-[#f0f4ef] dark:bg-[#282b30] hover:bg-[#d4eed8] dark:hover:bg-[#004a21] text-[#004a21] dark:text-[#a2f5b2] transition-colors font-medium text-left\"\n            >\n              \360\237\222\254 {q}\n            </button>\n          ))}\n        </div>\n\n        {/* Input Form */}\n        <div className=\"flex gap-2\">\n          <input\n            id=\"input-chef-chat\"\n            type=\"text\"\n            value={chefQuery}\n            onChange={(e) => setChefQuery(e.target.value)}\n            onKeyDown={(e) => e.key === \'Enter\' && handleSendChefQuery()}\n            placeholder={t.aiInsights.askPlaceholder}\n            className=\"flex-1 px-4 py-2.5 text-xs sm:text-sm rounded-xl bg-[#f8f9ff] dark:bg-[#14171a] border border-[#e1e2e8] dark:border-[#2e3135] focus:outline-none focus:ring-2 focus:ring-[#096430] text-[#191c20] dark:text-[#e1e2e8]\"\n          />\n          <button\n            id=\"btn-send-chef-chat\"\n            onClick={() => handleSendChefQuery()}\n            disabled={isChefAsking || !chefQuery.trim()}\n            className=\"flex items-center gap-1.5 px-5 py-2.5 bg-[#096430] hover:bg-[#075026] text-white text-xs sm:text-sm font-semibold rounded-xl transition-all active:scale-95 disabled:opacity-40 cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-base\">send</span>\n            <span>{t.aiInsights.sendQuestion}</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "              <button\n                onClick={() => setActiveRecipeDetails(null)}\n                className=\"px-6 py-2.5 rounded-xl bg-[#096430] hover:bg-[#075026] text-white text-xs sm:text-sm font-bold shadow transition-all active:scale-95 cursor-pointer\"\n              >\n                {isSpanish ? \'\302\241Listo para cocinar!\' : \'Done Cooking!\'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
      }
      num_matches: 1
