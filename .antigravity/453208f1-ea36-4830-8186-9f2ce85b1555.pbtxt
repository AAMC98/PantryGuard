    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { HouseholdMember, UserPreferences, UserProfile } from \'../types\';\nimport { translations } from \'../utils/i18n\';\n\ninterface SharedHouseholdViewProps {\n  user: UserProfile;\n  members: HouseholdMember[];\n  preferences: UserPreferences;\n  onInviteMember: (name: string, email: string, role: \'admin\' | \'member\') => void;\n  onRemoveMember: (id: string) => void;\n  onChangeRole: (id: string, newRole: \'admin\' | \'member\') => void;\n  onResendInvite: (id: string) => void;\n  onBack: () => void;\n  onShowToast: (message: string) => void;\n}\n\nexport const SharedHouseholdView: React.FC<SharedHouseholdViewProps> = ({\n  user,\n  members,\n  preferences,\n  onInviteMember,\n  onRemoveMember,\n  onChangeRole,\n  onResendInvite,\n  onBack,\n  onShowToast,\n}) => {\n  const t = translations[preferences.language];\n  const [activeMenuId, setActiveMenuId] = useState<string | null>(null);\n  const [isInviteModalOpen, setIsInviteModalOpen] = useState(false);\n  const [inviteName, setInviteName] = useState(\'\');\n  const [inviteEmail, setInviteEmail] = useState(\'\');\n  const [inviteRole, setInviteRole] = useState<\'admin\' | \'member\'>(\'member\');\n\n  const handleInviteSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!inviteEmail.trim()) return;\n\n    onInviteMember(\n      inviteName.trim() || inviteEmail.split(\'@\')[0],\n      inviteEmail.trim(),\n      inviteRole\n    );\n    setIsInviteModalOpen(false);\n    setInviteName(\'\');\n    setInviteEmail(\'\');\n    onShowToast(t.household.inviteSuccess);\n  };\n\n  return (\n    <div className=\"flex-1 w-full max-w-4xl mx-auto px-4 py-4 md:py-6 flex flex-col gap-5\">\n      {/* Title & Back */}\n      <div className=\"flex items-center gap-3\">\n        <button\n          onClick={onBack}\n          aria-label=\"Volver\"\n          className=\"w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">arrow_back</span>\n        </button>\n        <div>\n          <h2 className=\"text-2xl font-bold text-[#191c20] dark:text-[#f8f9ff]\">\n            {t.household.title}\n          </h2>\n          <p className=\"text-xs text-[#707a6f] dark:text-[#8a9389]\">\n            {user.householdName}\n          </p>\n        </div>\n      </div>\n\n      <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd] max-w-2xl\">\n        {t.household.desc}\n      </p>\n\n      {/* Invite Button */}\n      <div>\n        <button\n          onClick={() => setIsInviteModalOpen(true)}\n          className=\"w-full md:w-auto flex items-center justify-center gap-2 bg-[#004a21] hover:bg-[#096430] text-white py-3 px-6 rounded-xl shadow-[0_4px_16px_rgba(0,74,33,0.15)] active:scale-95 transition-all text-sm font-semibold\"\n        >\n          <span className=\"material-symbols-outlined text-[20px] fill-icon\">\n            person_add\n          </span>\n          <span>{t.household.inviteMember}</span>\n        </button>\n      </div>\n\n      {/* Members Section */}\n      <section className=\"flex flex-col gap-3\">\n        <h3 className=\"font-semibold text-sm text-[#191c20] dark:text-[#f8f9ff]\">\n          {t.household.currentMembers(members.length)}\n        </h3>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5\">\n          {members.map((member) => {\n            const isSelf = member.email === user.email || member.id === \'mem-1\';\n            const isMenuOpen = activeMenuId === member.id;\n\n            return (\n              <div\n                key={member.id}\n                className={`bg-white dark:bg-[#1e2124] rounded-xl p-4 flex items-center justify-between shadow-[0_2px_8px_rgba(0,0,0,0.04)] border-l-4 ${\n                  member.role === \'admin\'\n                    ? \'border-[#004a21]\'\n                    : \'border-[#bfc9bd]\'\n                } relative`}\n              >\n                <div className=\"flex items-center gap-3.5 min-w-0 pr-2\">\n                  <div className=\"relative shrink-0\">\n                    <div className=\"w-12 h-12 rounded-full overflow-hidden bg-[#e1e2e8] dark:bg-[#2e3135] flex items-center justify-center text-[#003d87] dark:text-[#aec6ff] font-bold text-sm\">\n                      {member.avatarUrl ? (\n                        <img\n                          src={member.avatarUrl}\n                          alt={member.name}\n                          className=\"w-full h-full object-cover\"\n                        />\n                      ) : (\n                        <span>\n                          {member.initials || member.name.substring(0, 2).toUpperCase()}\n                        </span>\n                      )}\n                    </div>\n                    {member.role === \'admin\' && (\n                      <div className=\"absolute -bottom-1 -right-1 bg-[#004a21] text-white w-5 h-5 rounded-full flex items-center justify-center border-2 border-white dark:border-[#1e2124]\">\n                        <span className=\"material-symbols-outlined text-[12px] fill-icon\">\n                          shield\n                        </span>\n                      </div>\n                    )}\n                  </div>\n\n                  <div className=\"min-w-0 flex flex-col\">\n                    <p className=\"font-semibold text-sm text-[#191c20] dark:text-[#f8f9ff] truncate\">\n                      {member.name}\n                    </p>\n                    <p className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd] truncate\">\n                      {isSelf\n                        ? t.household.youAdmin\n                        : member.status === \'pending\'\n                        ? t.household.pendingInvitation\n                        : t.household.member}\n                    </p>\n                  </div>\n                </div>\n\n                {/* Right Action Menu for non-self */}\n                {!isSelf && (\n                  <div className=\"relative\">\n                    <button\n                      onClick={() =>\n                        setActiveMenuId(isMenuOpen ? null : member.id)\n                      }\n                      className=\"w-9 h-9 flex items-center justify-center rounded-full text-[#707a6f] hover:bg-[#f2f3f9] dark:hover:bg-[#2e3135] transition-colors\"\n                    >\n                      <span className=\"material-symbols-outlined text-[20px]\">\n                        {member.status === \'pending\' ? \'more_vert\' : \'edit\'}\n                      </span>\n                    </button>\n\n                    {/* Dropdown Menu */}\n                    {isMenuOpen && (\n                      <>\n                        <div\n                          className=\"fixed inset-0 z-20\"\n                          onClick={() => setActiveMenuId(null)}\n                        ></div>\n                        <div className=\"absolute right-0 top-full mt-1 bg-white dark:bg-[#2e3135] rounded-xl shadow-xl z-30 py-1.5 w-44 border border-[#bfc9bd] dark:border-[#404940] overflow-hidden text-xs\">\n                          {member.status === \'pending\' ? (\n                            <>\n                              <button\n                                onClick={() => {\n                                  onResendInvite(member.id);\n                                  setActiveMenuId(null);\n                                  onShowToast(\'Invitaci\303\263n reenviada\');\n                                }}\n                                className=\"w-full text-left px-3.5 py-2 hover:bg-[#f2f3f9] dark:hover:bg-[#404940] flex items-center gap-2 text-[#191c20] dark:text-white\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">\n                                  send\n                                </span>\n                                <span>{t.household.resendInvite}</span>\n                              </button>\n                              <button\n                                onClick={() => {\n                                  onRemoveMember(member.id);\n                                  setActiveMenuId(null);\n                                  onShowToast(\'Invitaci\303\263n cancelada\');\n                                }}\n                                className=\"w-full text-left px-3.5 py-2 hover:bg-[#ffdad6]/40 flex items-center gap-2 text-[#ba1a1a]\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">\n                                  cancel\n                                </span>\n                                <span>{t.household.cancelInvite}</span>\n                              </button>\n                            </>\n                          ) : (\n                            <>\n                              <button\n                                onClick={() => {\n                                  const nextRole =\n                                    member.role === \'admin\' ? \'member\' : \'admin\';\n                                  onChangeRole(member.id, nextRole);\n                                  setActiveMenuId(null);\n                                  onShowToast(`Rol cambiado a ${nextRole}`);\n                                }}\n                                className=\"w-full text-left px-3.5 py-2 hover:bg-[#f2f3f9] dark:hover:bg-[#404940] flex items-center gap-2 text-[#191c20] dark:text-white\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">\n                                  manage_accounts\n                                </span>\n                                <span>\n                                  {member.role === \'admin\'\n                                    ? \'Hacer Miembro\'\n                                    : \'Hacer Administrador\'}\n                                </span>\n                              </button>\n                              <button\n                                onClick={() => {\n                                  if (confirm(`\302\277Eliminar a ${member.name}?`)) {\n                                    onRemoveMember(member.id);\n                                    setActiveMenuId(null);\n                                    onShowToast(\'Miembro eliminado\');\n                                  }\n                                }}\n                                className=\"w-full text-left px-3.5 py-2 hover:bg-[#ffdad6]/40 flex items-center gap-2 text-[#ba1a1a]\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">\n                                  delete\n                                </span>\n                                <span>{t.household.removeMember}</span>\n                              </button>\n                            </>\n                          )}\n                        </div>\n                      </>\n                    )}\n                  </div>\n                )}\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* Invite Member Modal */}\n      {isInviteModalOpen && (\n        <div className=\"fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4\">\n          <div className=\"bg-white dark:bg-[#1e2124] rounded-2xl p-6 w-full max-w-sm shadow-2xl border border-[#e1e2e8] dark:border-[#404940]\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h4 className=\"font-bold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n                {t.household.inviteMember}\n              </h4>\n              <button\n                onClick={() => setIsInviteModalOpen(false)}\n                className=\"text-[#707a6f] hover:text-[#191c20] dark:hover:text-white\"\n              >\n                <span className=\"material-symbols-outlined\">close</span>\n              </button>\n            </div>\n\n            <form onSubmit={handleInviteSubmit} className=\"flex flex-col gap-3.5\">\n              <div>\n                <label className=\"text-xs font-semibold text-[#404940] dark:text-[#bfc9bd] block mb-1\">\n                  Nombre (opcional)\n                </label>\n                <input\n                  type=\"text\"\n                  value={inviteName}\n                  onChange={(e) => setInviteName(e.target.value)}\n                  placeholder=\"Ej. Laura M\303\251ndez\"\n                  className=\"w-full px-3.5 py-2 rounded-lg border border-[#bfc9bd] dark:border-[#404940] bg-white dark:bg-[#2e3135] text-xs text-[#191c20] dark:text-white focus:outline-none focus:border-[#003d87]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-semibold text-[#404940] dark:text-[#bfc9bd] block mb-1\">\n                  Correo Electr\303\263nico <span className=\"text-[#ba1a1a]\">*</span>\n                </label>\n                <input\n                  type=\"email\"\n                  value={inviteEmail}\n                  onChange={(e) => setInviteEmail(e.target.value)}\n                  placeholder=\"familiar@ejemplo.com\"\n                  className=\"w-full px-3.5 py-2 rounded-lg border border-[#bfc9bd] dark:border-[#404940] bg-white dark:bg-[#2e3135] text-xs text-[#191c20] dark:text-white focus:outline-none focus:border-[#003d87]\"\n                  required\n                />\n              </div>\n\n              <div>\n                <label className=\"text-xs font-semibold text-[#404940] dark:text-[#bfc9bd] block mb-1\">\n                  Rol en el hogar\n                </label>\n                <select\n                  value={inviteRole}\n                  onChange={(e) => setInviteRole(e.target.value as \'admin\' | \'member\')}\n                  className=\"w-full px-3.5 py-2 rounded-lg border border-[#bfc9bd] dark:border-[#404940] bg-white dark:bg-[#2e3135] text-xs text-[#191c20] dark:text-white focus:outline-none focus:border-[#003d87]\"\n                >\n                  <option value=\"member\">Miembro (Lectura y edici\303\263n)</option>\n                  <option value=\"admin\">Administrador (Control total)</option>\n                </select>\n              </div>\n\n              <div className=\"flex gap-2 justify-end mt-3\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsInviteModalOpen(false)}\n                  className=\"px-4 py-2 text-xs font-medium text-[#404940] dark:text-[#bfc9bd] hover:bg-[#f2f3f9] dark:hover:bg-[#2e3135] rounded-lg\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 text-xs font-semibold bg-[#004a21] hover:bg-[#096430] text-white rounded-lg transition-colors shadow-sm\"\n                >\n                  Enviar Invitaci\303\263n\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
