    replacement_chunks {
      target_content: "  const html5QrCodeRef = useRef<Html5Qrcode | null>(null);\n  const scannerContainerId = \'pantry-guard-barcode-reader\';\n\n  // Sample quick barcodes for simulation\n  const sampleBarcodes = [\n    { code: \'7501000654321\', name: \'Yogurt Griego Natural (7501000654321)\' },\n    { code: \'7501000123456\', name: \'Leche Entera Pasteurizada (7501000123456)\' },\n    { code: \'7501055300075\', name: \'Cereal Corn Flakes (7501055300075)\' },\n    { code: \'7501000789123\', name: \'Huevos de Granja (7501000789123)\' },\n    { code: \'7501000456789\', name: \'Arroz Grano Largo (7501000456789)\' },\n    { code: \'7501000987654\', name: \'Avena en Hojuelas (7501000987654)\' },\n    { code: \'7501011122334\', name: \'At\303\272n en Agua (7501011122334)\' },\n  ];\n\n  const handleScanDone = async (code: string) => {\n    // Play sound feedback\n    try {\n      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = \'sine\';\n      osc.frequency.setValueAtTime(880, ctx.currentTime);\n      gain.gain.setValueAtTime(0.2, ctx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start();\n      osc.stop(ctx.currentTime + 0.15);\n    } catch {\n      // Audio context might be restricted\n    }\n\n    // Stop camera\n    if (html5QrCodeRef.current && html5QrCodeRef.current.isScanning) {\n      try {\n        await html5QrCodeRef.current.stop();\n      } catch (e) {\n        console.warn(\'Error stopping scanner:\', e);\n      }\n    }\n\n    const data = await lookupBarcode(code);\n    onScanSuccess(code, data);\n  };\n\n  useEffect(() => {\n    if (!isOpen) return;\n\n    let isMounted = true;\n    setCameraError(null);\n\n    const startScanner = async () => {\n      try {\n        const scanner = new Html5Qrcode(scannerContainerId);\n        html5QrCodeRef.current = scanner;\n\n        const config = {\n          fps: 15,\n          qrbox: { width: 280, height: 200 },\n          aspectRatio: 1.3333,\n        };\n\n        await scanner.start(\n          { facingMode: \'environment\' },\n          config,\n          (decodedText) => {\n            if (isMounted) {\n              handleScanDone(decodedText);\n            }\n          },\n          () => {\n            // Ignore scan errors (frame not recognized)\n          }\n        );\n\n        if (isMounted) {\n          setIsScanning(true);\n        }\n      } catch (err: any) {\n        console.warn(\'Camera scan initialization notice:\', err);\n        if (isMounted) {\n          setCameraError(t.scanner.cameraError);\n          setIsScanning(false);\n        }\n      }\n    };\n\n    // Small delay to ensure DOM element is rendered\n    const timer = setTimeout(() => {\n      startScanner();\n    }, 200);\n\n    return () => {\n      isMounted = false;\n      clearTimeout(timer);\n      if (html5QrCodeRef.current) {\n        if (html5QrCodeRef.current.isScanning) {\n          html5QrCodeRef.current.stop().catch(() => {});\n        }\n        html5QrCodeRef.current.clear();\n        html5QrCodeRef.current = null;\n      }\n    };\n  }, [isOpen]);"
      replacement_content: "  const html5QrCodeRef = useRef<Html5Qrcode | null>(null);\n  const isStartingRef = useRef(false);\n  const scannerContainerId = \'pantry-guard-barcode-reader\';\n\n  // Sample quick barcodes for simulation\n  const sampleBarcodes = [\n    { code: \'7501000654321\', name: \'Yogurt Griego Natural (7501000654321)\' },\n    { code: \'7501000123456\', name: \'Leche Entera Pasteurizada (7501000123456)\' },\n    { code: \'7501055300075\', name: \'Cereal Corn Flakes (7501055300075)\' },\n    { code: \'7501000789123\', name: \'Huevos de Granja (7501000789123)\' },\n    { code: \'7501000456789\', name: \'Arroz Grano Largo (7501000456789)\' },\n    { code: \'7501000987654\', name: \'Avena en Hojuelas (7501000987654)\' },\n    { code: \'7501011122334\', name: \'At\303\272n en Agua (7501011122334)\' },\n  ];\n\n  // Helper to safely stop & clean up scanner\n  const safelyStopScanner = async (scanner: Html5Qrcode | null) => {\n    if (!scanner) return;\n    try {\n      if (scanner.isScanning) {\n        await scanner.stop();\n      }\n    } catch {\n      // Ignore already stopped or abort error\n    }\n    try {\n      scanner.clear();\n    } catch {\n      // Ignore clear error if DOM node was already removed\n    }\n  };\n\n  const handleScanDone = async (code: string) => {\n    // Play sound feedback\n    try {\n      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = \'sine\';\n      osc.frequency.setValueAtTime(880, ctx.currentTime);\n      gain.gain.setValueAtTime(0.2, ctx.currentTime);\n      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start();\n      osc.stop(ctx.currentTime + 0.15);\n    } catch {\n      // Audio context might be restricted\n    }\n\n    // Stop camera before notifying\n    const scanner = html5QrCodeRef.current;\n    html5QrCodeRef.current = null;\n    await safelyStopScanner(scanner);\n\n    const data = await lookupBarcode(code);\n    onScanSuccess(code, data);\n  };\n\n  const handleClose = async () => {\n    const scanner = html5QrCodeRef.current;\n    html5QrCodeRef.current = null;\n    await safelyStopScanner(scanner);\n    onClose();\n  };\n\n  useEffect(() => {\n    if (!isOpen) return;\n\n    let isMounted = true;\n    setCameraError(null);\n    setIsScanning(false);\n    setTorchOn(false);\n\n    const startScanner = async () => {\n      if (!isMounted) return;\n      const el = document.getElementById(scannerContainerId);\n      if (!el) return;\n\n      try {\n        isStartingRef.current = true;\n        const scanner = new Html5Qrcode(scannerContainerId);\n        html5QrCodeRef.current = scanner;\n\n        const config = {\n          fps: 15,\n          qrbox: { width: 280, height: 200 },\n          aspectRatio: 1.3333,\n        };\n\n        await scanner.start(\n          { facingMode: \'environment\' },\n          config,\n          (decodedText) => {\n            if (isMounted) {\n              handleScanDone(decodedText);\n            }\n          },\n          () => {\n            // Ignore scan errors (frame not recognized)\n          }\n        );\n\n        isStartingRef.current = false;\n\n        if (!isMounted) {\n          await safelyStopScanner(scanner);\n          return;\n        }\n\n        setIsScanning(true);\n      } catch (err: any) {\n        isStartingRef.current = false;\n        console.warn(\'Camera scan initialization notice:\', err);\n        if (isMounted) {\n          setCameraError(t.scanner.cameraError);\n          setIsScanning(false);\n        }\n      }\n    };\n\n    // Small delay to ensure DOM element is rendered\n    const timer = setTimeout(() => {\n      startScanner();\n    }, 200);\n\n    return () => {\n      isMounted = false;\n      clearTimeout(timer);\n      const scanner = html5QrCodeRef.current;\n      html5QrCodeRef.current = null;\n      if (scanner) {\n        safelyStopScanner(scanner).catch(() => {});\n      }\n    };\n  }, [isOpen]);"
    }
