      target_content: "    } catch (err: any) {\n      console.error(\'Error in /api/ai/analyze-trends:\', err);\n      // Fallback to local heuristic engine on any error so user experience is always fluid\n      const fallback = generateLocalAnalysis(req.body.products || [], req.body.shoppingItems || [], req.body.preferences);\n      return res.json(fallback);\n    }\n  });\n\n  // POST /api/ai/ask-advisor\n  app.post(\'/api/ai/ask-advisor\', async (req, res) => {\n    try {\n      const { question, products = [], shoppingItems = [], preferences = { language: \'es\' } } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const ai = getGeminiClient();\n\n      if (!question || !question.trim()) {\n        return res.status(400).json({ error: \'Question is required\' });\n      }\n\n      if (!ai) {\n        return res.json({\n          answer: isSpanish\n            ? `Tu despensa cuenta actualmente con ${products.length} productos. Te sugiero priorizar el consumo de los l\303\241cteos y frutas m\303\241s pr\303\263ximos a caducar para evitar desperdicio.`\n            : `Your pantry currently has ${products.length} items. I recommend consuming dairy and fruits closest to expiration first to minimize waste.`,\n        });\n      }\n\n      const prompt = `\nEres el Asistente y Consultor de Despensa de Pantry Guard.\nResponde de manera c\303\241lida, concisa, pr\303\241ctica y directamente \303\272til a la siguiente pregunta del usuario:\n\"${question}\"\n\nCONTEXTO DE LA DESPENSA DEL USUARIO:\nProductos actuales (${products.length}):\n${JSON.stringify(products.map((p: any) => ({ name: p.name, category: p.category, qty: `${p.quantity} ${p.unit}`, exp: p.expiryDate, loc: p.location })))}\n\nLista de compras (${shoppingItems.length}):\n${JSON.stringify(shoppingItems.map((s: any) => ({ name: s.name, qty: `${s.quantity} ${s.unit}` })))}\n\nResponde en el idioma ${isSpanish ? \'Espa\303\261ol\' : \'English\'} con formato markdown limpio (negritas, vi\303\261etas breves si aplica) sin rodeos innecesarios.\n`;\n\n      const { response } = await generateWithModelFallback(ai, {\n        contents: prompt,\n      });\n\n      return res.json({\n        answer: response.text || (isSpanish ? \'No pude generar la respuesta en este momento.\' : \'Unable to generate response at this time.\'),\n      });\n    } catch (err: any) {\n      console.error(\'Error in /api/ai/ask-advisor:\', err);\n      const isSpanish = req.body.preferences?.language !== \'en\';\n      return res.json({\n        answer: isSpanish\n          ? \'Para optimizar tus compras, revisa primero los productos marcados en rojo en tu inventario y a\303\261ade solo aquellos con alta rotaci\303\263n a tu lista de compras.\'\n          : \'To optimize your grocery shopping, check the expiring items in your inventory first and add only high-velocity essentials to your list.\',\n      });\n    }"
      replacement_content: "    } catch (err: any) {\n      console.warn(\'Temporary AI model unavailability in /api/ai/analyze-trends (falling back to local engine):\', err?.message || err);\n      // Fallback to local heuristic engine on any error so user experience is always fluid\n      const fallback = generateLocalAnalysis(req.body.products || [], req.body.shoppingItems || [], req.body.preferences);\n      return res.json(fallback);\n    }\n  });\n\n  // POST /api/ai/ask-advisor\n  app.post(\'/api/ai/ask-advisor\', async (req, res) => {\n    try {\n      const { question, products = [], shoppingItems = [], preferences = { language: \'es\' } } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const ai = getGeminiClient();\n\n      if (!question || !question.trim()) {\n        return res.status(400).json({ error: \'Question is required\' });\n      }\n\n      if (!ai) {\n        return res.json({\n          answer: isSpanish\n            ? `Tu despensa cuenta actualmente con ${products.length} productos. Te sugiero priorizar el consumo de los l\303\241cteos y frutas m\303\241s pr\303\263ximos a caducar para evitar desperdicio.`\n            : `Your pantry currently has ${products.length} items. I recommend consuming dairy and fruits closest to expiration first to minimize waste.`,\n        });\n      }\n\n      const prompt = `\nEres el Asistente y Consultor de Despensa de Pantry Guard.\nResponde de manera c\303\241lida, concisa, pr\303\241ctica y directamente \303\272til a la siguiente pregunta del usuario:\n\"${question}\"\n\nCONTEXTO DE LA DESPENSA DEL USUARIO:\nProductos actuales (${products.length}):\n${JSON.stringify(products.map((p: any) => ({ name: p.name, category: p.category, qty: `${p.quantity} ${p.unit}`, exp: p.expiryDate, loc: p.location })))}\n\nLista de compras (${shoppingItems.length}):\n${JSON.stringify(shoppingItems.map((s: any) => ({ name: s.name, qty: `${s.quantity} ${s.unit}` })))}\n\nResponde en el idioma ${isSpanish ? \'Espa\303\261ol\' : \'English\'} con formato markdown limpio (negritas, vi\303\261etas breves si aplica) sin rodeos innecesarios.\n`;\n\n      const { response } = await generateWithModelFallback(ai, {\n        contents: prompt,\n      });\n\n      return res.json({\n        answer: response.text || (isSpanish ? \'No pude generar la respuesta en este momento.\' : \'Unable to generate response at this time.\'),\n      });\n    } catch (err: any) {\n      console.warn(\'Temporary AI model unavailability in /api/ai/ask-advisor (falling back):\', err?.message || err);\n      const isSpanish = req.body.preferences?.language !== \'en\';\n      return res.json({\n        answer: isSpanish\n          ? \'Para optimizar tus compras, revisa primero los productos marcados en rojo en tu inventario y a\303\261ade solo aquellos con alta rotaci\303\263n a tu lista de compras.\'\n          : \'To optimize your grocery shopping, check the expiring items in your inventory first and add only high-velocity essentials to your list.\',\n      });\n    }"
