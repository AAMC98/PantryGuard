  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // POST /api/ai/analyze-trends\n  app.post(\'/api/ai/analyze-trends\', async (req, res) => {\n    try {\n      const { products = [], shoppingItems = [], preferences = { language: \'es\', unitSystem: \'metric\' } } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const ai = getGeminiClient();\n\n      // If no Gemini client is available, compute high-quality deterministic smart analysis\n      if (!ai) {\n        return res.json(generateLocalAnalysis(products, shoppingItems, preferences));\n      }\n\n      const promptContext = `\nEres el motor de Inteligencia Artificial experto en despensa, h\303\241bitos de compra y prevenci\303\263n de desperdicio de alimentos de la aplicaci\303\263n \"Pantry Guard\".\n\nAnaliza minuciosamente el siguiente inventario de la despensa y la lista de compras del usuario:\n\nINVENTARIO ACTUAL (${products.length} productos):\n${JSON.stringify(\n  products.map((p: any) => ({\n    name: p.name,\n    category: p.category,\n    quantity: p.quantity,\n    unit: p.unit,\n    expiryDate: p.expiryDate,\n    location: p.location,\n    notes: p.notes,\n  })),\n  null,\n  2\n)}\n\nLISTA DE COMPRAS ACTUAL (${shoppingItems.length} art\303\255culos):\n${JSON.stringify(\n  shoppingItems.map((s: any) => ({\n    name: s.name,\n    category: s.category,\n    quantity: s.quantity,\n    unit: s.unit,\n    reason: s.reason,\n  })),\n  null,\n  2\n)}\n\nPREFERENCIAS DEL USUARIO:\n- Idioma: ${preferences.language}\n- Sistema de unidades: ${preferences.unitSystem}\n- Fecha actual: ${new Date().toISOString().split(\'T\')[0]}\n\nTU OBJETIVO:\n1. **Analizar la tendencia de compras y rotaci\303\263n**: Identifica qu\303\251 productos se consumen m\303\241s r\303\241pido, cu\303\241les se agotan frecuentemente y requieren comprarse m\303\241s o reponerse proactivamente.\n2. **Identificar qu\303\251 NO deber\303\255a comprar el usuario ya**: Identifica productos en alto riesgo de desperdicio porque ya est\303\241n caducados, pr\303\263ximos a caducar en abundancia, o comprados en exceso que no se consumen a tiempo.\n3. **Pron\303\263stico semanal inteligente**: Qu\303\251 comprar exactamente y qu\303\251 evitar comprar.\n4. **Calcular un Puntaje de Eficiencia y Cero Desperdicio (0 a 100)** basado en la proporci\303\263n de productos frescos vs caducados/en riesgo.\n5. **Recomendaciones y Recetas de Rescate R\303\241pido**: Preparaciones culinarias pr\303\241cticas con los ingredientes que est\303\241n por vencer.\n\nGenera la respuesta estrictamente en formato JSON con la siguiente estructura y en el idioma ${isSpanish ? \'Espa\303\261ol\' : \'English\'}.\n`;\n\n      const { response, modelUsed } = await generateWithModelFallback(ai, {\n        contents: promptContext,\n        config: {\n          systemInstruction: `You are an expert AI food sustainability and grocery optimization analyst. Always return structured, actionable, and friendly recommendations strictly in JSON matching the specified schema. Language must be ${preferences.language === \'en\' ? \'English\' : \'Spanish\'}.`,\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              efficiencyScore: {\n                type: Type.INTEGER,\n                description: \'Pantry efficiency and waste prevention score from 0 to 100\',\n              },\n              efficiencyRating: {\n                type: Type.STRING,\n                description: \'Brief score badge like \"Excelente\", \"Bueno\" or \"Atenci\303\263n requerida\"\',\n              },\n              summary: {\n                type: Type.STRING,\n                description: \'2-3 sentence overview of user shopping patterns and waste risk\',\n              },\n              topBoughtVelocity: {\n                type: Type.ARRAY,\n                description: \'Products with high turnover that run out quickly or need repurchase\',\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    name: { type: Type.STRING },\n                    category: { type: Type.STRING },\n                    velocity: { type: Type.STRING, enum: [\'alta\', \'media\', \'baja\'] },\n                    velocityText: { type: Type.STRING, description: \'e.g. \"Se agota cada 3-4 d\303\255as\"\' },\n                    daysLeftEstimate: { type: Type.INTEGER },\n                    recommendedQuantity: { type: Type.NUMBER },\n                    unit: { type: Type.STRING },\n                    reason: { type: Type.STRING },\n                    isLow: { type: Type.BOOLEAN },\n                  },\n                  required: [\'name\', \'category\', \'velocity\', \'velocityText\', \'daysLeftEstimate\', \'recommendedQuantity\', \'unit\', \'reason\', \'isLow\'],\n                },\n              },\n              wasteRiskItems: {\n                type: Type.ARRAY,\n                description: \'Products that should NOT be bought right now or are at risk of spoiling\',\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    name: { type: Type.STRING },\n                    category: { type: Type.STRING },\n                    riskLevel: { type: Type.STRING, enum: [\'alto\', \'medio\', \'critico\'] },\n                    riskReason: { type: Type.STRING },\n                    recommendation: { type: Type.STRING },\n                    urgency: { type: Type.STRING, enum: [\'hoy\', \'proximos_dias\', \'evitar_compra\'] },\n                    avoidBuying: { type: Type.BOOLEAN },\n                  },\n                  required: [\'name\', \'category\', \'riskLevel\', \'riskReason\', \'recommendation\', \'urgency\', \'avoidBuying\'],\n                },\n              },\n              weeklyForecast: {\n                type: Type.OBJECT,\n                properties: {\n                  recommendedToBuy: {\n                    type: Type.ARRAY,\n                    items: {\n                      type: Type.OBJECT,\n                      properties: {\n                        name: { type: Type.STRING },\n                        category: { type: Type.STRING },\n                        quantity: { type: Type.NUMBER },\n                        unit: { type: Type.STRING },\n                        reason: { type: Type.STRING },\n                      },\n                      required: [\'name\', \'category\', \'quantity\', \'unit\', \'reason\'],\n                    },\n                  },\n                  avoidBuying: {\n                    type: Type.ARRAY,\n                    items: {\n                      type: Type.OBJECT,\n                      properties: {\n                        name: { type: Type.STRING },\n                        category: { type: Type.STRING },\n                        reason: { type: Type.STRING },\n                        currentStock: { type: Type.STRING },\n                      },\n                      required: [\'name\', \'category\', \'reason\', \'currentStock\'],\n                    },\n                  },\n                  budgetSavingTip: { type: Type.STRING },\n                },\n                required: [\'recommendedToBuy\', \'avoidBuying\', \'budgetSavingTip\'],\n              },\n              actionableTips: {\n                type: Type.ARRAY,\n                items: { type: Type.STRING },\n              },\n              recipeSuggestions: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    title: { type: Type.STRING },\n                    description: { type: Type.STRING },\n                    ingredientsToRescue: {\n                      type: Type.ARRAY,\n                      items: { type: Type.STRING },\n                    },\n                    prepTime: { type: Type.STRING },\n                    difficulty: { type: Type.STRING, enum: [\'F\303\241cil\', \'Media\', \'R\303\241pida\'] },\n                  },\n                  required: [\'title\', \'description\', \'ingredientsToRescue\', \'prepTime\', \'difficulty\'],\n                },\n              },\n            },\n            required: [\n              \'efficiencyScore\',\n              \'efficiencyRating\',\n              \'summary\',\n              \'topBoughtVelocity\',\n              \'wasteRiskItems\',\n              \'weeklyForecast\',\n              \'actionableTips\',\n              \'recipeSuggestions\',\n            ],\n          },\n        },\n      });\n\n      const parsed = JSON.parse(response.text || \'{}\');\n      parsed.lastAnalyzedAt = new Date().toISOString();\n      parsed.aiModel = modelUsed;\n      return res.json(parsed);\n    } catch (err: any) {\n      console.warn(\'Temporary AI model unavailability in /api/ai/analyze-trends (falling back to local engine):\', err?.message || err);\n      // Fallback to local heuristic engine on any error so user experience is always fluid\n      const fallback = generateLocalAnalysis(req.body.products || [], req.body.shoppingItems || [], req.body.preferences);\n      return res.json(fallback);\n    }\n  });\n\n  // POST /api/ai/ask-advisor\n  app.post(\'/api/ai/ask-advisor\', async (req, res) => {\n    try {\n      const { question, products = [], shoppingItems = [], preferences = { language: \'es\' } } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const ai = getGeminiClient();\n\n      if (!question || !question.trim()) {\n        return res.status(400).json({ error: \'Question is required\' });\n      }\n\n      if (!ai) {\n        return res.json({\n          answer: isSpanish\n            ? `Tu despensa cuenta actualmente con ${products.length} productos. Te sugiero priorizar el consumo de los l\303\241cteos y frutas m\303\241s pr\303\263ximos a caducar para evitar desperdicio.`\n            : `Your pantry currently has ${products.length} items. I recommend consuming dairy and fruits closest to expiration first to minimize waste.`,\n        });\n      }\n\n      const prompt = `\nEres el Asistente y Consultor de Despensa de Pantry Guard.\nResponde de manera c\303\241lida, concisa, pr\303\241ctica y directamente \303\272til a la siguiente pregunta del usuario:\n\"${question}\"\n\nCONTEXTO DE LA DESPENSA DEL USUARIO:\nProductos actuales (${products.length}):\n${JSON.stringify(products.map((p: any) => ({ name: p.name, category: p.category, qty: `${p.quantity} ${p.unit}`, exp: p.expiryDate, loc: p.location })))}\n\nLista de compras (${shoppingItems.length}):\n${JSON.stringify(shoppingItems.map((s: any) => ({ name: s.name, qty: `${s.quantity} ${s.unit}` })))}\n\nResponde en el idioma ${isSpanish ? \'Espa\303\261ol\' : \'English\'} con formato markdown limpio (negritas, vi\303\261etas breves si aplica) sin rodeos innecesarios.\n`;\n\n      const { response } = await generateWithModelFallback(ai, {\n        contents: prompt,\n      });\n\n      return res.json({\n        answer: response.text || (isSpanish ? \'No pude generar la respuesta en este momento.\' : \'Unable to generate response at this time.\'),\n      });\n    } catch (err: any) {\n      console.warn(\'Temporary AI model unavailability in /api/ai/ask-advisor (falling back):\', err?.message || err);\n      const isSpanish = req.body.preferences?.language !== \'en\';\n      return res.json({\n        answer: isSpanish\n          ? \'Para optimizar tus compras, revisa primero los productos marcados en rojo en tu inventario y a\303\261ade solo aquellos con alta rotaci\303\263n a tu lista de compras.\'\n          : \'To optimize your grocery shopping, check the expiring items in your inventory first and add only high-velocity essentials to your list.\',\n      });\n    }\n  });"
      replacement_content: "  // POST /api/ai/recipes\n  app.post(\'/api/ai/recipes\', async (req, res) => {\n    try {\n      const {\n        products = [],\n        mealType = \'all\',\n        customPrompt = \'\',\n        preferences = { language: \'es\', unitSystem: \'metric\' },\n      } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const now = new Date();\n\n      // SAFETY FILTER: Strictly separate valid products from expired products\n      const validProducts: any[] = [];\n      const expiringSoonProducts: any[] = [];\n      const expiredProducts: any[] = [];\n\n      products.forEach((p: any) => {\n        const exp = new Date(p.expiryDate);\n        const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n        const itemInfo = {\n          name: p.name,\n          category: p.category,\n          quantity: p.quantity,\n          unit: p.unit,\n          location: p.location,\n          daysRemaining: diffDays,\n          isExpiringSoon: diffDays >= 0 && diffDays <= 5,\n        };\n\n        if (diffDays < 0) {\n          expiredProducts.push(itemInfo);\n        } else {\n          validProducts.push(itemInfo);\n          if (itemInfo.isExpiringSoon) {\n            expiringSoonProducts.push(itemInfo);\n          }\n        }\n      });\n\n      const ai = getGeminiClient();\n\n      if (!ai || validProducts.length === 0) {\n        return res.json(\n          generateLocalRecipes(validProducts, expiringSoonProducts, expiredProducts.length, mealType, preferences)\n        );\n      }\n\n      const promptContext = `\nEres un Chef Profesional experto en Cocina de Aprovechamiento (Zero-Waste Cooking).\nTu misi\303\263n es crear recetas deliciosas, creativas y pr\303\241cticas utilizando \303\232NICAMENTE los ingredientes v\303\241lidos disponibles en la despensa del usuario.\n\nREGLA CR\303\215TICA DE SALUD Y SEGURIDAD ALIMENTARIA:\n1. **NUNCA uses ni recomiendes productos caducados.** (Los ${expiredProducts.length} productos caducados han sido excluidos deliberadamente por salud).\n2. **PRIORIDAD M\303\201XIMA a los productos pr\303\263ximos a caducar (${expiringSoonProducts.length} productos con 0 a 5 d\303\255as restantes).** \303\232salos como base principal de las recetas para evitar que se echen a perder.\n3. Puedes sugerir condimentos b\303\241sicos o ingredientes adicionales muy comunes (sal, pimienta, aceite, agua, ajo, etc.) pero m\303\241rcalos claramente en la lista de ingredientes adicionales.\n\nINVENTARIO V\303\201LIDO DE LA DESPENSA (${validProducts.length} productos):\n${JSON.stringify(validProducts, null, 2)}\n\nPRODUCTOS CON PRIORIDAD DE RESCATE (Vencen en 0 a 5 d\303\255as):\n${JSON.stringify(expiringSoonProducts, null, 2)}\n\nPREFERENCIA DE FILTRO O TIPO DE COMIDA: \"${mealType}\"\nSOLICITUD ESPECIAL DEL USUARIO: \"${customPrompt || \'Ninguna, genera las mejores recetas para rescatar comida\'}\"\nIDIOMA: ${isSpanish ? \'Espa\303\261ol\' : \'English\'}\n\nGenera entre 3 y 4 recetas variadas y apetecibles en formato JSON estructurado seg\303\272n el esquema especificado.\n`;\n\n      const { response, modelUsed } = await generateWithModelFallback(ai, {\n        contents: promptContext,\n        config: {\n          systemInstruction: `You are an expert master chef dedicated to zero-waste cooking and sustainable gastronomy. Always generate appetizing, safe, realistic recipes strictly in JSON matching the schema. Language must be ${preferences.language === \'en\' ? \'English\' : \'Spanish\'}. Never use expired food.`,\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              chefGreeting: {\n                type: Type.STRING,\n                description: \'Warm encouraging chef greeting explaining how these recipes rescue near-expiry ingredients\',\n              },\n              recipes: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    id: { type: Type.STRING },\n                    title: { type: Type.STRING },\n                    description: { type: Type.STRING },\n                    category: {\n                      type: Type.STRING,\n                      enum: [\'desayuno\', \'almuerzo_cena\', \'express\', \'postre_snack\'],\n                    },\n                    categoryLabel: { type: Type.STRING, description: \'e.g. Desayuno Saludable, Cena Express\' },\n                    prepTime: { type: Type.STRING, description: \'e.g. 10 min\' },\n                    cookTime: { type: Type.STRING, description: \'e.g. 15 min\' },\n                    servings: { type: Type.INTEGER },\n                    difficulty: { type: Type.STRING, enum: [\'F\303\241cil\', \'Media\', \'R\303\241pida\'] },\n                    rescuedPantryIngredients: {\n                      type: Type.ARRAY,\n                      items: {\n                        type: Type.OBJECT,\n                        properties: {\n                          name: { type: Type.STRING },\n                          quantity: { type: Type.STRING },\n                          isFromPantry: { type: Type.BOOLEAN },\n                          isExpiringSoon: { type: Type.BOOLEAN },\n                          daysRemaining: { type: Type.INTEGER },\n                        },\n                        required: [\'name\', \'isFromPantry\', \'isExpiringSoon\'],\n                      },\n                    },\n                    extraIngredients: {\n                      type: Type.ARRAY,\n                      items: {\n                        type: Type.OBJECT,\n                        properties: {\n                          name: { type: Type.STRING },\n                          quantity: { type: Type.STRING },\n                          isOptional: { type: Type.BOOLEAN },\n                        },\n                        required: [\'name\', \'isOptional\'],\n                      },\n                    },\n                    steps: {\n                      type: Type.ARRAY,\n                      items: { type: Type.STRING },\n                    },\n                    chefTip: { type: Type.STRING },\n                    zeroWasteBenefit: { type: Type.STRING },\n                  },\n                  required: [\n                    \'id\',\n                    \'title\',\n                    \'description\',\n                    \'category\',\n                    \'categoryLabel\',\n                    \'prepTime\',\n                    \'cookTime\',\n                    \'servings\',\n                    \'difficulty\',\n                    \'rescuedPantryIngredients\',\n                    \'extraIngredients\',\n                    \'steps\',\n                    \'chefTip\',\n                    \'zeroWasteBenefit\',\n                  ],\n                },\n              },\n            },\n            required: [\'chefGreeting\', \'recipes\'],\n          },\n        },\n      });\n\n      const parsed = JSON.parse(response.text || \'{}\');\n      return res.json({\n        ...parsed,\n        expiredItemsIgnoredCount: expiredProducts.length,\n        expiringItemsCount: expiringSoonProducts.length,\n        lastGeneratedAt: new Date().toISOString(),\n        aiModel: modelUsed,\n      });\n    } catch (err: any) {\n      console.warn(\'AI recipe generation error, falling back to local generator:\', err?.message || err);\n      const now = new Date();\n      const validProducts: any[] = [];\n      const expiringSoonProducts: any[] = [];\n      let expiredCount = 0;\n\n      (req.body.products || []).forEach((p: any) => {\n        const exp = new Date(p.expiryDate);\n        const diff = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n        if (diff < 0) {\n          expiredCount++;\n        } else {\n          const item = { ...p, daysRemaining: diff, isExpiringSoon: diff <= 5 };\n          validProducts.push(item);\n          if (item.isExpiringSoon) expiringSoonProducts.push(item);\n        }\n      });\n\n      return res.json(\n        generateLocalRecipes(\n          validProducts,\n          expiringSoonProducts,\n          expiredCount,\n          req.body.mealType || \'all\',\n          req.body.preferences\n        )\n      );\n    }\n  });\n\n  // POST /api/ai/ask-advisor (Chef IA Asistente)\n  app.post(\'/api/ai/ask-advisor\', async (req, res) => {\n    try {\n      const { question, products = [], shoppingItems = [], preferences = { language: \'es\' } } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const now = new Date();\n\n      // SAFETY: Filter out expired items\n      const validProducts = (products || []).filter((p: any) => {\n        const diff = Math.ceil((new Date(p.expiryDate).getTime() - now.getTime()) / (1000 * 3600 * 24));\n        return diff >= 0;\n      });\n\n      const ai = getGeminiClient();\n\n      if (!question || !question.trim()) {\n        return res.status(400).json({ error: \'Question is required\' });\n      }\n\n      if (!ai) {\n        return res.json({\n          answer: isSpanish\n            ? `\302\241Hola! Con los ingredientes frescos y pr\303\263ximos a caducar de tu despensa, te recomiendo preparar una tortilla de verduras o salteado r\303\241pido. \302\241Recuerda desechar siempre los alimentos ya caducados por seguridad!`\n            : `Hello! With your fresh and near-expiry pantry items, I suggest making a quick veggie stir-fry or frittata. Remember to discard expired items for food safety!`,\n        });\n      }\n\n      const prompt = `\nEres el Chef y Experto Culinario IA de Pantry Guard especializado en Cocina de Aprovechamiento (Zero-Waste).\nResponde de forma entusiasta, clara, con pasos pr\303\241cticos y medidas realistas a la consulta del usuario:\n\"${question}\"\n\nREGLAS DE SEGURIDAD ALIMENTARIA:\n- NUNCA aconsejes consumir alimentos ya caducados.\n- Da prioridad a rescatar ingredientes que est\303\241n a punto de vencer en la despensa del usuario.\n\nINVENTARIO V\303\201LIDO EN DESPENSA (${validProducts.length} productos aptos):\n${JSON.stringify(validProducts.map((p: any) => ({ name: p.name, category: p.category, qty: `${p.quantity} ${p.unit}`, exp: p.expiryDate })))}\n\nResponde en ${isSpanish ? \'Espa\303\261ol\' : \'English\'} con formato Markdown limpio (vi\303\261etas, negritas) listo para cocinar.\n`;\n\n      const { response } = await generateWithModelFallback(ai, {\n        contents: prompt,\n      });\n\n      return res.json({\n        answer: response.text || (isSpanish ? \'No pude generar la respuesta en este momento.\' : \'Unable to generate response at this time.\'),\n      });\n    } catch (err: any) {\n      console.warn(\'Temporary AI model unavailability in /api/ai/ask-advisor (falling back):\', err?.message || err);\n      const isSpanish = req.body.preferences?.language !== \'en\';\n      return res.json({\n        answer: isSpanish\n          ? \'Para aprovechar tus alimentos antes de que caduquen, prueba preparar salteados, sopas cremosas o tortillas combinando los vegetales y l\303\241cteos m\303\241s frescos de tu despensa.\'\n          : \'To make the most of your near-expiry food, try making stir-fries, creamy soups, or frittatas using your freshest pantry staples.\',\n      });\n    }\n  });"
    }
