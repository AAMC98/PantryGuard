    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "// Deterministic heuristic fallback generator when API key is offline or cold\nfunction generateLocalAnalysis(products: any[], shoppingItems: any[], preferences: any) {\n  const isSpanish = preferences?.language !== \'en\';\n  const now = new Date();\n  \n  let expiredCount = 0;\n  let expiringCount = 0;\n  let freshCount = 0;\n\n  const wasteRiskItems: any[] = [];\n  const velocityItems: any[] = [];\n\n  products.forEach((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n\n    if (diffDays < 0) {\n      expiredCount++;\n      wasteRiskItems.push({\n        name: p.name,\n        category: p.category,\n        riskLevel: \'critico\',\n        riskReason: isSpanish\n          ? `Caduc\303\263 hace ${Math.abs(diffDays)} d\303\255as (${p.quantity} ${p.unit}) en ${p.location}.`\n          : `Expired ${Math.abs(diffDays)} days ago (${p.quantity} ${p.unit}) in ${p.location}.`,\n        recommendation: isSpanish\n          ? `Evita recomprar hasta reevaluar tu ritmo de consumo real.`\n          : `Avoid repurchasing until evaluating your actual consumption rate.`,\n        urgency: \'evitar_compra\',\n        avoidBuying: true,\n      });\n    } else if (diffDays <= 4) {\n      expiringCount++;\n      wasteRiskItems.push({\n        name: p.name,\n        category: p.category,\n        riskLevel: \'alto\',\n        riskReason: isSpanish\n          ? `Vence en ${diffDays} d\303\255as (${p.quantity} ${p.unit}). Riesgo inminente de desperdicio.`\n          : `Expires in ${diffDays} days (${p.quantity} ${p.unit}). Imminent food waste risk.`,\n        recommendation: isSpanish\n          ? `Consumir hoy o incorporar en preparaciones r\303\241pidas.`\n          : `Consume today or incorporate into quick recipes.`,\n        urgency: \'hoy\',\n        avoidBuying: true,\n      });\n    } else {\n      freshCount++;\n      // If low quantity or essential staples\n      if (p.quantity <= 2 || [\'huevos\', \'leche\', \'yogurt\', \'pan\', \'frutas\'].some((k) => p.name.toLowerCase().includes(k))) {\n        velocityItems.push({\n          name: p.name,\n          category: p.category,\n          velocity: \'alta\',\n          velocityText: isSpanish ? \'Consumo frecuente estimado (cada 3-5 d\303\255as)\' : \'Estimated frequent consumption (every 3-5 days)\',\n          daysLeftEstimate: Math.max(1, Math.min(diffDays, 4)),\n          recommendedQuantity: p.quantity === 1 ? 2 : p.quantity,\n          unit: p.unit,\n          reason: isSpanish\n            ? `Baja existencia actual en ${p.location}. Conviene reponer en la pr\303\263xima compra.`\n            : `Low current stock in ${p.location}. Recommended to refill on next trip.`,\n          isLow: p.quantity <= 2,\n        });\n      }\n    }\n  });\n\n  const total = Math.max(1, products.length);\n  const efficiencyScore = Math.max(20, Math.min(98, Math.round(100 - (expiredCount * 15 + expiringCount * 8))));\n  const efficiencyRating = efficiencyScore >= 80 ? (isSpanish ? \'Excelente\' : \'Excellent\') : efficiencyScore >= 60 ? (isSpanish ? \'Bueno\' : \'Good\') : (isSpanish ? \'Atenci\303\263n requerida\' : \'Needs Attention\');\n\n  return {\n    efficiencyScore,\n    efficiencyRating,\n    summary: isSpanish\n      ? `Tu despensa tiene ${products.length} art\303\255culos registrados. Tienes ${expiringCount + expiredCount} producto(s) en zona de riesgo que no deber\303\255as recomprar por ahora, mientras que los esenciales de alta rotaci\303\263n como l\303\241cteos y huevos requieren reposici\303\263n controlada.`\n      : `Your pantry has ${products.length} registered items. You have ${expiringCount + expiredCount} item(s) at risk that shouldn\'t be repurchased yet, while high-velocity staples need controlled replenishment.`,\n    topBoughtVelocity: velocityItems.slice(0, 4),\n    wasteRiskItems: wasteRiskItems.slice(0, 4),\n    weeklyForecast: {\n      recommendedToBuy: velocityItems.slice(0, 3).map((v) => ({\n        name: v.name,\n        category: v.category,\n        quantity: v.recommendedQuantity,\n        unit: v.unit,\n        reason: v.reason,\n      })),\n      avoidBuying: wasteRiskItems.slice(0, 3).map((w) => ({\n        name: w.name,\n        category: w.category,\n        reason: w.riskReason,\n        currentStock: \'En existencia pr\303\263xima a vencer\',\n      })),\n      budgetSavingTip: isSpanish\n        ? \'Revisa tus verduras y l\303\241cteos antes de ir al supermercado: comprar solo las porciones de 3 d\303\255as reduce hasta un 30% el gasto mensual.\'\n        : \'Check your produce and dairy before shopping: buying 3-day portions reduces monthly food waste by up to 30%.\',\n    },\n    actionableTips: isSpanish\n      ? [\n          \'Agrupa los productos que vencen en menos de 4 d\303\255as en la bandeja frontal del refrigerador.\',\n          \'Si tienes fruta madura pr\303\263xima a caducar, c\303\263rtala y cong\303\251lala en porciones para licuados.\',\n          \'No compres paquetes familiares de productos perecederos si vives en un hogar de 1 o 2 personas.\',\n        ]\n      : [\n          \'Group items expiring in under 4 days on the front shelf of your fridge.\',\n          \'Freeze overripe fruits in portion bags for quick smoothies.\',\n          \'Avoid bulk buying perishable items unless you have an immediate meal plan.\',\n        ],\n    recipeSuggestions: [\n      {\n        title: isSpanish ? \'Bowl de Rescate con Fruta y Yogurt\' : \'Rescue Yogurt & Fruit Bowl\',\n        description: isSpanish\n          ? \'Combina los yogurts y frutas maduras con avena o semillas para un desayuno nutritivo sin desperdicio.\'\n          : \'Mix ripe fruits and yogurts with oats or seeds for a zero-waste nutritious breakfast.\',\n        ingredientsToRescue: [\'Yogurt\', \'Manzanas\', \'Avena\'],\n        prepTime: \'5 min\',\n        difficulty: \'R\303\241pida\',\n      },\n      {\n        title: isSpanish ? \'Tortilla R\303\241pida de Huevo y Verduras\' : \'Quick Egg & Veggie Frittata\',\n        description: isSpanish\n          ? \'Saltea las verduras pr\303\263ximas a vencer y a\303\261ade huevos batidos para una cena rica y r\303\241pida.\'\n          : \'Saut\303\251 near-expiry vegetables and fold with eggs for a fast, delicious dinner.\',\n        ingredientsToRescue: [\'Huevos\'],\n        prepTime: \'10 min\',\n        difficulty: \'F\303\241cil\',\n      },\n    ],\n    lastAnalyzedAt: new Date().toISOString(),\n  };\n}\n\nstartServer();"
      replacement_content: "// Deterministic heuristic fallback recipe generator when API key is offline or cold\nfunction generateLocalRecipes(\n  validProducts: any[],\n  expiringSoonProducts: any[],\n  expiredCount: number,\n  mealType: string,\n  preferences: any\n) {\n  const isSpanish = preferences?.language !== \'en\';\n  const recipes: any[] = [];\n\n  // Group pantry names for pattern matching\n  const hasItem = (query: string) =>\n    validProducts.find((p) => p.name.toLowerCase().includes(query.toLowerCase()));\n\n  const eggs = hasItem(\'huevo\');\n  const milk = hasItem(\'leche\');\n  const bread = hasItem(\'pan\');\n  const yogurt = hasItem(\'yogurt\') || hasItem(\'yogur\');\n  const fruits = validProducts.filter((p) => p.category === \'frutas\' || [\'manzana\', \'platano\', \'banana\', \'fresa\', \'naranja\'].some((f) => p.name.toLowerCase().includes(f)));\n  const veggies = validProducts.filter((p) => p.category === \'verduras\' || [\'tomate\', \'cebolla\', \'zanahoria\', \'espinaca\', \'lechuga\', \'pimiento\'].some((v) => p.name.toLowerCase().includes(v)));\n  const meats = validProducts.filter((p) => p.category === \'carnes\' || [\'pollo\', \'carne\', \'atun\', \'jamon\', \'pavo\'].some((m) => p.name.toLowerCase().includes(m)));\n  const grains = validProducts.filter((p) => p.category === \'granos\' || [\'arroz\', \'pasta\', \'avena\', \'fideos\'].some((g) => p.name.toLowerCase().includes(g)));\n  const dairy = validProducts.filter((p) => p.category === \'lacteos\' || [\'queso\', \'crema\', \'mantequilla\'].some((d) => p.name.toLowerCase().includes(d)));\n\n  // 1. Desayuno / Bowl de Fruta o Tostadas\n  if (fruits.length > 0 || yogurt || eggs || bread) {\n    const rescueList = [...fruits, yogurt, eggs, bread].filter(Boolean).slice(0, 3);\n    recipes.push({\n      id: \'local-rec-1\',\n      title: isSpanish ? \'Tostadas & Bowl Energ\303\251tico de Aprovechamiento\' : \'Zero-Waste Energy Bowl & Toast\',\n      description: isSpanish\n        ? \'Una combinaci\303\263n deliciosa para iniciar el d\303\255a utilizando frutas y l\303\241cteos frescos en su punto \303\263ptimo de madurez.\'\n        : \'A delicious morning combination making the most of ripe fruits and fresh dairy at their flavor peak.\',\n      category: \'desayuno\',\n      categoryLabel: isSpanish ? \'Desayuno Saludable\' : \'Healthy Breakfast\',\n      prepTime: \'5 min\',\n      cookTime: \'5 min\',\n      servings: 2,\n      difficulty: \'R\303\241pida\',\n      rescuedPantryIngredients: rescueList.map((p) => ({\n        name: p.name,\n        quantity: `${p.quantity} ${p.unit}`,\n        isFromPantry: true,\n        isExpiringSoon: p.isExpiringSoon || false,\n        daysRemaining: p.daysRemaining,\n      })),\n      extraIngredients: [\n        { name: isSpanish ? \'Miel o canela al gusto\' : \'Honey or cinnamon\', isOptional: true },\n        { name: isSpanish ? \'Aceite de oliva\' : \'Olive oil\', isOptional: false },\n      ],\n      steps: isSpanish\n        ? [\n            \'Lava y corta las frutas disponibles en rebanadas finas.\',\n            \'Tuesta el pan hasta que quede dorado y crujiente.\',\n            \'Si tienes huevos, prep\303\241ralos revueltos a fuego medio con una pizca de sal.\',\n            \'Sirve en un taz\303\263n combinando las frutas con el yogurt o acomp\303\241\303\261alas con las tostadas calientes.\',\n          ]\n        : [\n            \'Wash and slice all available ripe fruits into thin pieces.\',\n            \'Toast the bread until golden and crisp.\',\n            \'If you have eggs, scramble them gently over medium heat with a pinch of salt.\',\n            \'Assemble your fruit bowl with yogurt or serve over warm crispy toast.\',\n          ],\n      chefTip: isSpanish\n        ? \'Si la fruta est\303\241 muy madura, tambi\303\251n puedes triturarla directamente como mermelada r\303\241pida sin az\303\272car a\303\261adido.\'\n        : \'If fruit is very ripe, mash it into an instant quick spread with no added sugar.\',\n      zeroWasteBenefit: isSpanish\n        ? \'Evita que las frutas y l\303\241cteos maduros se deterioren al consumirlos a tiempo.\'\n        : \'Prevents ripe fruits and opened dairy from spoiling by using them immediately.\',\n    });\n  }\n\n  // 2. Almuerzo / Cena: Salteado o Frittata con Vegetales y Prote\303\255na\n  if (veggies.length > 0 || eggs || meats.length > 0 || grains.length > 0) {\n    const rescueList = [...veggies, ...meats, eggs, ...dairy].filter(Boolean).slice(0, 4);\n    recipes.push({\n      id: \'local-rec-2\',\n      title: isSpanish ? \'Salteado Campestre Rescate de Verduras & Prote\303\255na\' : \'Garden Saut\303\251 & Protein Rescue Skillet\',\n      description: isSpanish\n        ? \'Un plato reconfortante donde todas tus verduras y prote\303\255nas se integran con hierbas y un toque crujiente.\'\n        : \'A comforting one-pan dish blending all your fresh vegetables and protein with a delicious savory sear.\',\n      category: \'almuerzo_cena\',\n      categoryLabel: isSpanish ? \'Almuerzo / Cena Nutritiva\' : \'Nutritious Lunch / Dinner\',\n      prepTime: \'10 min\',\n      cookTime: \'15 min\',\n      servings: 2,\n      difficulty: \'F\303\241cil\',\n      rescuedPantryIngredients: rescueList.map((p) => ({\n        name: p.name,\n        quantity: `${p.quantity} ${p.unit}`,\n        isFromPantry: true,\n        isExpiringSoon: p.isExpiringSoon || false,\n        daysRemaining: p.daysRemaining,\n      })),\n      extraIngredients: [\n        { name: isSpanish ? \'1 diente de ajo o cebolla\' : \'1 garlic clove or onion\', isOptional: true },\n        { name: isSpanish ? \'Sal, pimienta y aceite de cocina\' : \'Salt, pepper & cooking oil\', isOptional: false },\n      ],\n      steps: isSpanish\n        ? [\n            \'Corta todas las verduras en cubos o tiras de tama\303\261o uniforme para que se cocinen al mismo tiempo.\',\n            \'Calienta 1 cucharada de aceite en una sart\303\251n grande a fuego medio-alto.\',\n            \'Saltea primero las verduras m\303\241s firmes (zanahorias, pimientos) por 4 minutos y luego a\303\261ade las m\303\241s suaves.\',\n            \'Agrega las prote\303\255nas (pollo, at\303\272n o huevos batidos) y cocina hasta que est\303\251n en su punto exacto.\',\n            \'Condimenta con sal y pimienta al gusto antes de servir caliente.\',\n          ]\n        : [\n            \'Dice all vegetables evenly so they cook at the same pace.\',\n            \'Heat 1 tbsp of cooking oil in a large skillet over medium-high heat.\',\n            \'Saut\303\251 firmer vegetables first for 4 minutes, then add softer greens and herbs.\',\n            \'Fold in your protein or beaten eggs, cooking until golden and tender.\',\n            \'Season with salt, pepper, and serve steaming hot.\',\n          ],\n      chefTip: isSpanish\n        ? \'Guarda los tallos de las verduras en una bolsa en el congelador para hacer caldos caseros sabrosos.\'\n        : \'Save clean veggie stems in a freezer bag to brew delicious homemade vegetable broth.\',\n      zeroWasteBenefit: isSpanish\n        ? \'Aprovecha hasta el \303\272ltimo vegetal de tu despensa antes de que pierda su frescura y turgencia.\'\n        : \'Uses up every fresh vegetable in your crisper drawer before it loses crunch.\',\n    });\n  }\n\n  // 3. Express (<15 min): Pasta o Arroz Salteado Cero Desperdicio\n  recipes.push({\n    id: \'local-rec-3\',\n    title: isSpanish ? \'Cazuela Express Cero Desperdicio\' : \'Quick Zero-Waste Pantry Skillet\',\n    description: isSpanish\n      ? \'Preparaci\303\263n s\303\272per r\303\241pida lista en 12 minutos con lo que tengas a mano en la despensa.\'\n      : \'Super speedy 12-minute meal built around your available staples and seasonings.\',\n    category: \'express\',\n    categoryLabel: isSpanish ? \'Comida R\303\241pida (<15 min)\' : \'Express Meal (<15 min)\',\n    prepTime: \'5 min\',\n    cookTime: \'10 min\',\n    servings: 2,\n    difficulty: \'R\303\241pida\',\n    rescuedPantryIngredients: (expiringSoonProducts.length > 0 ? expiringSoonProducts : validProducts).slice(0, 3).map((p) => ({\n      name: p.name,\n      quantity: `${p.quantity} ${p.unit}`,\n      isFromPantry: true,\n      isExpiringSoon: p.isExpiringSoon || false,\n      daysRemaining: p.daysRemaining,\n    })),\n    extraIngredients: [\n      { name: isSpanish ? \'Aceite de oliva o mantequilla\' : \'Olive oil or butter\', isOptional: false },\n      { name: isSpanish ? \'Hierbas secas (or\303\251gano, albahaca)\' : \'Dried herbs (oregano, basil)\', isOptional: true },\n    ],\n    steps: isSpanish\n      ? [\n          \'Re\303\272ne y pica finamente los ingredientes seleccionados.\',\n          \'D\303\263ralos en una sart\303\251n con un chorrito de aceite a fuego vivo durante 6-8 minutos.\',\n          \'Ajusta la saz\303\263n con tus especias favoritas y sirve de inmediato.\',\n        ]\n      : [\n          \'Chop all selected pantry items into small bite-sized pieces.\',\n          \'Sear in a hot pan with olive oil or butter for 6-8 minutes until fragrant.\',\n          \'Season with favorite spices and serve warm right away.\',\n        ],\n    chefTip: isSpanish\n      ? \'Unas gotas de lim\303\263n o vinagre al final realzan los sabores y reviven cualquier vegetal salteado.\'\n      : \'A squeeze of fresh lemon or vinegar at the end brightens up any quick saut\303\251.\',\n    zeroWasteBenefit: isSpanish\n      ? \'Rescata ingredientes solitarios de la nevera convirti\303\251ndolos en un plato sabroso.\'\n      : \'Turns single leftover ingredients into a complete, delicious meal.\',\n  });\n\n  return {\n    chefGreeting: isSpanish\n      ? `\302\241Hola! He dise\303\261ado estas recetas utilizando \303\272nicamente tus ${validProducts.length} productos aptos en despensa, d\303\241ndole m\303\241xima prioridad a los ${expiringSoonProducts.length} que vencen pronto. ${expiredCount > 0 ? `(Nota de seguridad: Se han excluido ${expiredCount} productos ya caducados).` : \'\'}`\n      : `Hello! I crafted these recipes using your ${validProducts.length} valid pantry items, prioritizing the ${expiringSoonProducts.length} near expiry. ${expiredCount > 0 ? `(Safety note: Excluded ${expiredCount} expired items).` : \'\'}`,\n    recipes,\n    expiredItemsIgnoredCount: expiredCount,\n    expiringItemsCount: expiringSoonProducts.length,\n    lastGeneratedAt: new Date().toISOString(),\n    aiModel: \'pantry-guard-local-chef\',\n  };\n}\n\nstartServer();\n"
    }
