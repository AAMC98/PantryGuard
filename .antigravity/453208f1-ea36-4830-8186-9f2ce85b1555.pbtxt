        }
        lines {
          text: "    switch (u) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \'kg\':"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return `\342\211\210 ${(qty * 2.20462).toFixed(2)} lb`;"
