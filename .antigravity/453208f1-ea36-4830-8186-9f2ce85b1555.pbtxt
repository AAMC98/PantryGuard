      replacement_content: "import { BARCODE_CATALOG } from \'../data/initialData\';\nimport { Product, ProductStatus } from \'../types\';\n\nexport interface BarcodeLookupResult {\n  found: boolean;\n  name?: string;\n  category?: Product[\'category\'];\n  quantity?: number;\n  unit?: Product[\'unit\'];\n  location?: Product[\'location\'];\n  brand?: string;\n  barcode: string;\n  source: \'catalog\' | \'openfoodfacts\' | \'generated\';\n}\n\nexport async function lookupBarcode(barcode: string): Promise<BarcodeLookupResult> {\n  const cleanCode = barcode.trim();\n  if (!cleanCode) {\n    return { found: false, barcode: cleanCode, source: \'generated\' };\n  }\n\n  // 1. Check local catalog\n  if (BARCODE_CATALOG[cleanCode]) {\n    const item = BARCODE_CATALOG[cleanCode];\n    return {\n      found: true,\n      name: item.name,\n      category: item.category || \'otros\',\n      quantity: item.quantity || 1,\n      unit: item.unit || \'unidades\',\n      location: item.location || \'Alacena\',\n      barcode: cleanCode,\n      source: \'catalog\',\n    };\n  }\n\n  // 2. Query OpenFoodFacts API fallback\n  try {\n    const response = await fetch(`https://world.openfoodfacts.org/api/v2/product/${encodeURIComponent(cleanCode)}.json`);\n    if (response.ok) {\n      const data = await response.json();\n      if (data.status === 1 && data.product) {\n        const p = data.product;\n        const name = p.product_name_es || p.product_name || p.generic_name || \'Producto Escaneado\';\n        \n        // Categorize based on OpenFoodFacts categories\n        let category: Product[\'category\'] = \'otros\';\n        const tags = (p.categories_tags || []).join(\' \').toLowerCase();\n        if (tags.includes(\'dairy\') || tags.includes(\'milk\') || tags.includes(\'leche\') || tags.includes(\'yogurt\') || tags.includes(\'queso\')) {\n          category = \'lacteos\';\n        } else if (tags.includes(\'fruit\') || tags.includes(\'fruta\') || tags.includes(\'apple\') || tags.includes(\'banana\')) {\n          category = \'frutas\';\n        } else if (tags.includes(\'meat\') || tags.includes(\'egg\') || tags.includes(\'huevo\') || tags.includes(\'carne\') || tags.includes(\'pescado\') || tags.includes(\'tuna\')) {\n          category = \'proteinas\';\n        } else if (tags.includes(\'cereal\') || tags.includes(\'grain\') || tags.includes(\'rice\') || tags.includes(\'arroz\') || tags.includes(\'pasta\') || tags.includes(\'bread\') || tags.includes(\'pan\')) {\n          category = \'granos\';\n        } else if (tags.includes(\'vegetable\') || tags.includes(\'verdura\') || tags.includes(\'legume\')) {\n          category = \'verduras\';\n        } else if (tags.includes(\'beverage\') || tags.includes(\'drink\') || tags.includes(\'bebida\') || tags.includes(\'juice\') || tags.includes(\'jugo\')) {\n          category = \'bebidas\';\n        }\n\n        let location: Product[\'location\'] = \'Alacena\';\n        if (category === \'lacteos\' || category === \'bebidas\' || category === \'proteinas\') {\n          location = \'Refrigerador\';\n        } else if (category === \'frutas\') {\n          location = \'Frutero\';\n        }\n\n        return {\n          found: true,\n          name,\n          category,\n          quantity: 1,\n          unit: \'unidades\',\n          location,\n          brand: p.brands,\n          barcode: cleanCode,\n          source: \'openfoodfacts\',\n        };\n      }\n    }\n  } catch {\n    // Network or fetch failed, fallback gracefully\n  }\n\n  // 3. Fallback heuristic\n  return {\n    found: false,\n    name: \'\',\n    category: \'otros\',\n    quantity: 1,\n    unit: \'unidades\',\n    location: \'Alacena\',\n    barcode: cleanCode,\n    source: \'generated\',\n  };\n}\n\nexport function calculateProductStatus(expiryDate: string, alertDays: number = 3): {\n  status: ProductStatus;\n  diffDays: number;\n  displayText: { es: string; en: string };\n  borderColor: string;\n  dotColor: string;\n  badgeBg: string;\n  badgeText: string;\n} {\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n  \n  const [year, month, day] = expiryDate.split(\'-\').map(Number);\n  const targetDate = new Date(year, month - 1, day);\n  targetDate.setHours(0, 0, 0, 0);\n\n  const diffTime = targetDate.getTime() - today.getTime();\n  const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));\n\n  if (diffDays < 0) {\n    const absDays = Math.abs(diffDays);\n    return {\n      status: \'expired\',\n      diffDays,\n      displayText: {\n        es: absDays === 1 ? \'Caduc\303\263 ayer\' : `Caduc\303\263 hace ${absDays} d\303\255as`,\n        en: absDays === 1 ? \'Expired yesterday\' : `Expired ${absDays} days ago`,\n      },\n      borderColor: \'border-[#ba1a1a]\',\n      dotColor: \'bg-[#ba1a1a]\',\n      badgeBg: \'bg-[#ffdad6]\',\n      badgeText: \'text-[#ba1a1a]\',\n    };\n  } else if (diffDays <= alertDays) {\n    return {\n      status: \'expiring\',\n      diffDays,\n      displayText: {\n        es: diffDays === 0 ? \'Vence hoy\' : diffDays === 1 ? \'Vence ma\303\261ana\' : `Pr\303\263ximo (${diffDays} d\303\255as)`,\n        en: diffDays === 0 ? \'Expires today\' : diffDays === 1 ? \'Expires tomorrow\' : `Expiring (${diffDays} days)`,\n      },\n      borderColor: \'border-[#ff7a2b]\',\n      dotColor: \'bg-[#ff7a2b]\',\n      badgeBg: \'bg-[#ffdbcb]\',\n      badgeText: \'text-[#9f4200]\',\n    };\n  } else {\n    return {\n      status: \'fresh\',\n      diffDays,\n      displayText: {\n        es: \'Vigente\',\n        en: \'Fresh\',\n      },\n      borderColor: \'border-[#004a21]\',\n      dotColor: \'bg-[#004a21]\',\n      badgeBg: \'bg-[#a2f5b2]/40\',\n      badgeText: \'text-[#004a21]\',\n    };\n  }\n}\n"
    }
