          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Helper to parse quantity and units from text like \"1 L\", \"500g\", \"250 ml\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "function parseQuantityAndUnit(quantityStr?: string): { quantity: number; unit: UnitType } {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (!quantityStr) return { quantity: 1, unit: \'unidades\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const text = quantityStr.trim().toLowerCase();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const match = text.match(/^([\\d.,]+)\\s*([a-zA-Z]+)?$/);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (match) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const val = parseFloat(match[1].replace(\',\', \'.\'));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const rawUnit = (match[2] || \'\').toLowerCase();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!isNaN(val) && val > 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (rawUnit === \'g\' || rawUnit === \'gr\' || rawUnit === \'gramos\') return { quantity: val, unit: \'g\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (rawUnit === \'kg\' || rawUnit === \'kilos\') return { quantity: val, unit: \'kg\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (rawUnit === \'ml\' || rawUnit === \'cl\') return { quantity: rawUnit === \'cl\' ? val * 10 : val, unit: \'ml\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (rawUnit === \'l\' || rawUnit === \'lt\' || rawUnit === \'litro\' || rawUnit === \'litros\') return { quantity: val, unit: \'L\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (rawUnit === \'lb\' || rawUnit === \'lbs\') return { quantity: val, unit: \'lb\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (rawUnit === \'oz\' || rawUnit === \'onzas\') return { quantity: val, unit: \'oz\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      return { quantity: val, unit: \'unidades\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return { quantity: 1, unit: \'unidades\' };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
