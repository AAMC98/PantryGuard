    replacement_infos {
      original_chunk {
        target_content: "export const ShoppingListView: React.FC<ShoppingListViewProps> = ({\n  items,\n  onToggleItem,\n  onAddItem,\n  onClearCompleted,\n  user,\n  preferences,\n  onShowToast,\n}) => {\n  const t = translations[preferences.language];\n  const lang = preferences.language;\n\n  const [activeCategory, setActiveCategory] = useState<ProductCategory | \'all\'>(\'all\');\n  const [newCustomItemName, setNewCustomItemName] = useState(\'\');\n  const [newCustomCategory, setNewCustomCategory] = useState<ProductCategory>(\'otros\');\n  const [isSuccessModalOpen, setIsSuccessModalOpen] = useState(false);\n\n  const categories: (ProductCategory | \'all\')[] = [\n    \'all\',\n    \'lacteos\',\n    \'frutas\',\n    \'proteinas\',\n    \'granos\',\n    \'verduras\',\n    \'bebidas\',\n  ];\n\n  const filteredItems = items.filter((item) => {\n    if (activeCategory === \'all\') return true;\n    return item.category === activeCategory;\n  });"
        replacement_content: "export const ShoppingListView: React.FC<ShoppingListViewProps> = ({\n  items = [],\n  onToggleItem,\n  onAddItem,\n  onRemoveItem,\n  onClearCompleted,\n  user,\n  preferences,\n  onShowToast,\n}) => {\n  const t = translations[preferences?.language || \'es\'];\n  const lang = preferences?.language || \'es\';\n  const safeItems = Array.isArray(items) ? items : [];\n\n  const [activeCategory, setActiveCategory] = useState<ProductCategory | \'all\'>(\'all\');\n  const [newCustomItemName, setNewCustomItemName] = useState(\'\');\n  const [newCustomCategory, setNewCustomCategory] = useState<ProductCategory>(\'otros\');\n  const [isSuccessModalOpen, setIsSuccessModalOpen] = useState(false);\n\n  const categories: (ProductCategory | \'all\')[] = [\n    \'all\',\n    \'lacteos\',\n    \'frutas\',\n    \'proteinas\',\n    \'granos\',\n    \'verduras\',\n    \'bebidas\',\n  ];\n\n  const filteredItems = safeItems.filter((item) => {\n    if (activeCategory === \'all\') return true;\n    return item.category === activeCategory;\n  });"
      }
      num_matches: 1
    }
