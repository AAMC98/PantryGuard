    instruction: "Make TopAppBar resilient, supporting notifications, unreadCount, onNavigate, onShare, onOpenScanner, and safe filtering"
    replacement_infos {
      original_chunk {
        target_content: "import React from \'react\';\nimport { UserPreferences, UserProfile, PantryNotification } from \'../types\';\nimport { translations } from \'../utils/i18n\';\n\ninterface TopAppBarProps {\n  user: UserProfile;\n  preferences: UserPreferences;\n  notifications: PantryNotification[];\n  onOpenNotifications: () => void;\n  onShare: () => void;\n  onNavigateHome: () => void;\n  onBack?: () => void;\n  title?: string;\n  showBack?: boolean;\n}\n\nexport const TopAppBar: React.FC<TopAppBarProps> = ({\n  preferences,\n  notifications,\n  onOpenNotifications,\n  onShare,\n  onNavigateHome,\n  onBack,\n  title,\n  showBack = false,\n}) => {\n  const t = translations[preferences.language];\n  const unreadCount = notifications.filter((n) => !n.read).length;\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 w-full z-40 bg-[#f8f9ff] dark:bg-[#191c20] shadow-sm border-b border-[#e1e2e8]/60 dark:border-[#2e3135] transition-colors duration-200\">\n      <div className=\"max-w-4xl mx-auto flex justify-between items-center px-4 h-16\">\n        <div className=\"flex items-center gap-3\">\n          {showBack && onBack ? (\n            <button\n              onClick={onBack}\n              aria-label=\"Volver\"\n              className=\"w-10 h-10 -ml-2 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[24px]\">arrow_back</span>\n            </button>\n          ) : null}\n\n          {/* Logo Shield Brand */}\n          <button\n            onClick={onNavigateHome}\n            className=\"flex items-center gap-2.5 text-left group transition-transform active:scale-98\"\n          >\n            <div className=\"w-9 h-9 rounded-full bg-[#096430] text-[#a2f5b2] flex items-center justify-center shadow-sm overflow-hidden flex-shrink-0\">\n              <svg viewBox=\"0 0 24 24\" className=\"w-5 h-5 fill-current\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 6C13.66 6 15 7.34 15 9C15 10.66 13.66 12 12 12C10.34 12 9 10.66 9 9C9 7.34 10.34 6 12 6ZM18 16.59C18 18.5 15.34 19.5 12 19.5C8.66 19.5 6 18.5 6 16.59C6 14.7 8.66 13.7 12 13.7C15.34 13.7 18 14.7 18 16.59Z\" />\n              </svg>\n            </div>\n            <h1 className=\"font-bold text-lg text-[#004a21] dark:text-[#87d897] tracking-tight group-hover:opacity-90\">\n              {title || t.appName}\n            </h1>\n          </button>\n        </div>\n\n        {/* Right Actions: Notifications & Share */}\n        <div className=\"flex items-center gap-1\">\n          <button\n            onClick={onOpenNotifications}\n            aria-label=\"Notificaciones\"\n            className=\"relative w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n          >\n            <span className=\"material-symbols-outlined text-[22px]\">notifications</span>\n            {unreadCount > 0 && (\n              <span className=\"absolute top-2 right-2 w-4 h-4 bg-[#ba1a1a] text-white text-[10px] font-bold rounded-full flex items-center justify-center ring-2 ring-[#f8f9ff] dark:ring-[#191c20]\">\n                {unreadCount > 9 ? \'9+\' : unreadCount}\n              </span>\n            )}\n          </button>\n\n          <button\n            onClick={onShare}\n            aria-label=\"Compartir\"\n            className=\"w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n          >\n            <span className=\"material-symbols-outlined text-[22px]\" data-icon=\"share\">\n              share\n            </span>\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { UserPreferences, UserProfile, PantryNotification, NavigationTab } from \'../types\';\nimport { translations } from \'../utils/i18n\';\n\ninterface TopAppBarProps {\n  user: UserProfile;\n  preferences: UserPreferences;\n  notifications?: PantryNotification[];\n  unreadCount?: number;\n  onOpenNotifications: () => void;\n  onShare?: () => void;\n  onOpenScanner?: () => void;\n  onNavigateHome?: () => void;\n  onNavigate?: (tab: NavigationTab) => void;\n  currentTab?: NavigationTab;\n  onBack?: () => void;\n  title?: string;\n  showBack?: boolean;\n}\n\nexport const TopAppBar: React.FC<TopAppBarProps> = ({\n  user,\n  preferences,\n  notifications = [],\n  unreadCount: explicitUnreadCount,\n  onOpenNotifications,\n  onShare,\n  onOpenScanner,\n  onNavigateHome,\n  onNavigate,\n  onBack,\n  title,\n  showBack = false,\n}) => {\n  const t = translations[preferences?.language || \'es\'];\n  const safeNotifications = Array.isArray(notifications) ? notifications : [];\n  const computedUnread = safeNotifications.filter((n) => !n.read).length;\n  const count = typeof explicitUnreadCount === \'number\' ? explicitUnreadCount : computedUnread;\n\n  const handleHomeClick = () => {\n    if (onNavigateHome) {\n      onNavigateHome();\n    } else if (onNavigate) {\n      onNavigate(\'dashboard\');\n    }\n  };\n\n  const handleDefaultShare = () => {\n    if (onShare) {\n      onShare();\n      return;\n    }\n    if (navigator.share) {\n      navigator.share({\n        title: \'Pantry Guard\',\n        text: `${user.householdName} - Pantry Guard Despensa Inteligente`,\n        url: window.location.href,\n      }).catch(() => {});\n    }\n  };\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 w-full z-40 bg-[#f8f9ff] dark:bg-[#191c20] shadow-sm border-b border-[#e1e2e8]/60 dark:border-[#2e3135] transition-colors duration-200\">\n      <div className=\"max-w-4xl mx-auto flex justify-between items-center px-4 h-16\">\n        <div className=\"flex items-center gap-3\">\n          {showBack && onBack ? (\n            <button\n              onClick={onBack}\n              aria-label=\"Volver\"\n              className=\"w-10 h-10 -ml-2 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[24px]\">arrow_back</span>\n            </button>\n          ) : null}\n\n          {/* Logo Shield Brand */}\n          <button\n            onClick={handleHomeClick}\n            className=\"flex items-center gap-2.5 text-left group transition-transform active:scale-98\"\n          >\n            <div className=\"w-9 h-9 rounded-full bg-[#096430] text-[#a2f5b2] flex items-center justify-center shadow-sm overflow-hidden flex-shrink-0\">\n              <svg viewBox=\"0 0 24 24\" className=\"w-5 h-5 fill-current\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 6C13.66 6 15 7.34 15 9C15 10.66 13.66 12 12 12C10.34 12 9 10.66 9 9C9 7.34 10.34 6 12 6ZM18 16.59C18 18.5 15.34 19.5 12 19.5C8.66 19.5 6 18.5 6 16.59C6 14.7 8.66 13.7 12 13.7C15.34 13.7 18 14.7 18 16.59Z\" />\n              </svg>\n            </div>\n            <h1 className=\"font-bold text-lg text-[#004a21] dark:text-[#87d897] tracking-tight group-hover:opacity-90\">\n              {title || t.appName}\n            </h1>\n          </button>\n        </div>\n\n        {/* Right Actions: Scanner, Notifications & Share */}\n        <div className=\"flex items-center gap-1\">\n          {onOpenScanner && (\n            <button\n              onClick={onOpenScanner}\n              aria-label=\"Escanear\"\n              className=\"w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n              title=\"Escanear c\303\263digo de barras\"\n            >\n              <span className=\"material-symbols-outlined text-[22px]\">barcode_scanner</span>\n            </button>\n          )}\n\n          <button\n            onClick={onOpenNotifications}\n            aria-label=\"Notificaciones\"\n            className=\"relative w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n          >\n            <span className=\"material-symbols-outlined text-[22px]\">notifications</span>\n            {count > 0 && (\n              <span className=\"absolute top-2 right-2 w-4 h-4 bg-[#ba1a1a] text-white text-[10px] font-bold rounded-full flex items-center justify-center ring-2 ring-[#f8f9ff] dark:ring-[#191c20]\">\n                {count > 9 ? \'9+\' : count}\n              </span>\n            )}\n          </button>\n\n          <button\n            onClick={handleDefaultShare}\n            aria-label=\"Compartir\"\n            className=\"w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n          >\n            <span className=\"material-symbols-outlined text-[22px]\" data-icon=\"share\">\n              share\n            </span>\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
