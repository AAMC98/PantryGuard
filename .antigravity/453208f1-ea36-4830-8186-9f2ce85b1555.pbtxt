      original_chunk {
        target_content: "      const config = {\n        fps: 20,\n        qrbox: (viewfinderWidth: number, viewfinderHeight: number) => {\n          const edge = Math.min(viewfinderWidth, viewfinderHeight);\n          const width = Math.min(Math.floor(edge * 0.88), 340);\n          const height = Math.min(Math.floor(width * 0.62), 220);\n          return { width, height };\n        },\n      };\n\n      await scanner.start(\n        { facingMode },\n        config,\n        (decodedText) => {\n          handleProcessBarcode(decodedText);\n        },\n        () => {}\n      );\n\n      setIsScanning(true);"
        replacement_content: "      const config = {\n        fps: 24,\n        videoConstraints: {\n          facingMode: { ideal: facingMode },\n          focusMode: { ideal: \'continuous\' } as any,\n          width: { min: 640, ideal: 1280, max: 1920 },\n          height: { min: 480, ideal: 720, max: 1080 },\n        },\n        qrbox: (viewfinderWidth: number, viewfinderHeight: number) => {\n          const edge = Math.min(viewfinderWidth, viewfinderHeight);\n          const width = Math.min(Math.floor(edge * 0.88), 340);\n          const height = Math.min(Math.floor(width * 0.62), 220);\n          return { width, height };\n        },\n      };\n\n      try {\n        await scanner.start(\n          { facingMode: { ideal: facingMode } },\n          config,\n          (decodedText) => {\n            handleProcessBarcode(decodedText);\n          },\n          () => {}\n        );\n      } catch (startErr) {\n        // Fallback for older iOS versions that prefer simple string facingMode\n        await scanner.start(\n          facingMode as any,\n          config,\n          (decodedText) => {\n            handleProcessBarcode(decodedText);\n          },\n          () => {}\n        );\n      }\n\n      // Ensure playsinline and webkit attributes are present for iOS Safari\n      const videoEl = document.querySelector<HTMLVideoElement>(`#${scannerContainerId} video`);\n      if (videoEl) {\n        videoEl.setAttribute(\'playsinline\', \'true\');\n        videoEl.setAttribute(\'webkit-playsinline\', \'true\');\n        videoEl.setAttribute(\'muted\', \'true\');\n        videoEl.muted = true;\n      }\n\n      setIsScanning(true);"
      }
      num_matches: 1
    }
