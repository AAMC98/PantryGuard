  file_change {
    absolute_path_uri: "file:///src/components/AIInsightsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { AITrendAnalysis, Product, ShoppingItem, UserPreferences, UserProfile, ProductCategory, UnitType } from \'../types\';\nimport { translations } from \'../utils/i18n\';\n\ninterface AIInsightsViewProps {\n  products: Product[];\n  shoppingItems: ShoppingItem[];\n  preferences: UserPreferences;\n  user: UserProfile;\n  onAddShoppingItem: (item: Omit<ShoppingItem, \'id\'>) => void;\n  onShowToast: (message: string) => void;\n  onNavigateTab: (tab: any) => void;\n}\n\ninterface ChatMessage {\n  id: string;\n  sender: \'user\' | \'assistant\';\n  text: string;\n  timestamp: string;\n}\n\nexport const AIInsightsView: React.FC<AIInsightsViewProps> = ({\n  products,\n  shoppingItems,\n  preferences,\n  user,\n  onAddShoppingItem,\n  onShowToast,\n  onNavigateTab,\n}) => {\n  const t = translations[preferences.language || \'es\'];\n  const isSpanish = preferences.language !== \'en\';\n\n  const [analysis, setAnalysis] = useState<AITrendAnalysis | null>(null);\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [addedItems, setAddedItems] = useState<Record<string, boolean>>({});\n\n  // Interactive AI Assistant State\n  const [chatMessages, setChatMessages] = useState<ChatMessage[]>([]);\n  const [inputQuery, setInputQuery] = useState<string>(\'\');\n  const [isAsking, setIsAsking] = useState<boolean>(false);\n\n  // Fetch or trigger analysis\n  const runAnalysis = async () => {\n    setIsLoading(true);\n    try {\n      const response = await fetch(\'/api/ai/analyze-trends\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          products,\n          shoppingItems,\n          preferences,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(`HTTP error ${response.status}`);\n      }\n\n      const data = await response.json();\n      setAnalysis(data);\n      onShowToast(isSpanish ? \'\302\241An\303\241lisis de IA actualizado con \303\251xito!\' : \'AI Analysis successfully updated!\');\n    } catch (error) {\n      console.error(\'Failed to run AI analysis:\', error);\n      onShowToast(isSpanish ? \'Se gener\303\263 el an\303\241lisis local con datos de despensa.\' : \'Loaded pantry analysis.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    runAnalysis();\n    // Initialize initial chat greeting\n    setChatMessages([\n      {\n        id: \'msg-welcome\',\n        sender: \'assistant\',\n        text: isSpanish\n          ? `\302\241Hola ${user.name.split(\' \')[0]}! Soy tu Asistente de Despensa IA. He analizado tus ${products.length} productos. Preg\303\272ntame qu\303\251 cocinar hoy, c\303\263mo reducir el desperdicio o qu\303\251 comprar.`\n          : `Hello ${user.name.split(\' \')[0]}! I\'m your AI Pantry Advisor. I analyzed your ${products.length} items. Ask me recipe ideas, food preservation tips, or shopping suggestions.`,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      },\n    ]);\n  }, [preferences.language]);\n\n  const handleAddVelocityToShopping = (item: { name: string; category: string; quantity: number; unit: string; reason: string }) => {\n    onAddShoppingItem({\n      name: item.name,\n      category: (item.category as ProductCategory) || \'otros\',\n      quantity: item.quantity || 1,\n      unit: (item.unit as UnitType) || \'unidades\',\n      checked: false,\n      reason: \'low_stock\',\n      notes: `Sugerido por IA: ${item.reason}`,\n    });\n\n    setAddedItems((prev) => ({ ...prev, [item.name]: true }));\n    onShowToast(isSpanish ? `\302\241\"${item.name}\" a\303\261adido a la lista de compras!` : `\"${item.name}\" added to shopping list!`);\n  };\n\n  const handleAskAdvisor = async (questionText?: string) => {\n    const query = questionText || inputQuery;\n    if (!query.trim()) return;\n\n    const userMsg: ChatMessage = {\n      id: `msg-${Date.now()}`,\n      sender: \'user\',\n      text: query,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    };\n\n    setChatMessages((prev) => [...prev, userMsg]);\n    setInputQuery(\'\');\n    setIsAsking(true);\n\n    try {\n      const response = await fetch(\'/api/ai/ask-advisor\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          question: query,\n          products,\n          shoppingItems,\n          preferences,\n        }),\n      });\n\n      const data = await response.json();\n      const aiMsg: ChatMessage = {\n        id: `msg-ai-${Date.now()}`,\n        sender: \'assistant\',\n        text: data.answer || (isSpanish ? \'No pude procesar la consulta.\' : \'Could not process query.\'),\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setChatMessages((prev) => [...prev, aiMsg]);\n    } catch (err) {\n      console.error(\'Advisor request error:\', err);\n      const errorMsg: ChatMessage = {\n        id: `msg-err-${Date.now()}`,\n        sender: \'assistant\',\n        text: isSpanish\n          ? \'Revisa los productos pr\303\263ximos a caducar en tu dashboard para priorizar su consumo hoy.\'\n          : \'Check your dashboard for expiring items to prioritize them in your meals today.\',\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setChatMessages((prev) => [...prev, errorMsg]);\n    } finally {\n      setIsAsking(false);\n    }\n  };\n\n  const getScoreColor = (score: number) => {\n    if (score >= 80) return \'text-[#096430] dark:text-[#8dde9d] bg-[#096430]/10 border-[#096430]/20\';\n    if (score >= 60) return \'text-[#ff7a2b] dark:text-[#ffb59d] bg-[#ff7a2b]/10 border-[#ff7a2b]/20\';\n    return \'text-[#ba1a1a] dark:text-[#ffb4ab] bg-[#ba1a1a]/10 border-[#ba1a1a]/20\';\n  };\n\n  return (\n    <div className=\"flex-1 w-full max-w-5xl mx-auto px-3 sm:px-6 py-4 sm:py-6 flex flex-col gap-6 pb-24\">\n      {/* Top Banner & Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gradient-to-r from-[#004a21] to-[#096430] text-white p-5 rounded-2xl shadow-sm\">\n        <div className=\"flex items-start gap-3.5\">\n          <div className=\"w-12 h-12 rounded-xl bg-white/15 backdrop-blur-sm flex items-center justify-center text-white shrink-0 shadow-inner\">\n            <span className=\"material-symbols-outlined text-[28px]\">psychology</span>\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2 flex-wrap\">\n              <h2 className=\"text-xl font-bold tracking-tight text-white\">{t.aiInsights.title}</h2>\n              <span className=\"px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-[#a2f5b2] text-[#004a21]\">\n                Gemini 3.7 Flash\n              </span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-[#e1e2e8] mt-0.5 max-w-xl\">\n              {t.aiInsights.subtitle}\n            </p>\n          </div>\n        </div>\n\n        <button\n          onClick={runAnalysis}\n          disabled={isLoading}\n          className=\"self-start sm:self-center px-4 py-2.5 rounded-xl bg-white text-[#004a21] hover:bg-[#f8f9ff] active:scale-95 font-semibold text-xs sm:text-sm shadow-sm transition-all flex items-center gap-2 disabled:opacity-60 cursor-pointer shrink-0\"\n        >\n          <span className={`material-symbols-outlined text-[18px] ${isLoading ? \'animate-spin\' : \'\'}`}>\n            {isLoading ? \'progress_activity\' : \'refresh\'}\n          </span>\n          <span>{isLoading ? t.aiInsights.refreshing : t.aiInsights.refreshButton}</span>\n        </button>\n      </div>\n\n      {/* Sustainability & Efficiency Score Card */}\n      {analysis && (\n        <div className=\"bg-white dark:bg-[#1e2124] border border-[#e1e2e8] dark:border-[#2e3135] rounded-2xl p-5 shadow-sm flex flex-col md:flex-row gap-5 items-start md:items-center justify-between\">\n          <div className=\"flex items-center gap-4\">\n            <div className={`w-20 h-20 rounded-2xl flex flex-col items-center justify-center border ${getScoreColor(analysis.efficiencyScore)} shrink-0`}>\n              <span className=\"text-2xl sm:text-3xl font-extrabold leading-none\">{analysis.efficiencyScore}</span>\n              <span className=\"text-[10px] font-medium tracking-tight mt-0.5\">/ 100</span>\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"font-bold text-base sm:text-lg text-[#191c20] dark:text-white\">\n                  {t.aiInsights.scoreTitle}\n                </h3>\n                <span className={`px-2.5 py-0.5 rounded-full text-xs font-semibold border ${getScoreColor(analysis.efficiencyScore)}`}>\n                  {analysis.efficiencyRating}\n                </span>\n              </div>\n              <p className=\"text-xs sm:text-sm text-[#404940] dark:text-[#bfc9bd] mt-1 leading-relaxed max-w-2xl\">\n                {analysis.summary}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 w-full md:w-auto pt-2 md:pt-0 border-t md:border-t-0 border-[#e1e2e8] dark:border-[#2e3135]\">\n            <button\n              onClick={() => onNavigateTab(\'shopping\')}\n              className=\"flex-1 md:flex-none px-4 py-2 bg-[#004a21] hover:bg-[#096430] text-white text-xs font-semibold rounded-xl transition-all shadow-sm flex items-center justify-center gap-1.5\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">shopping_cart</span>\n              <span>{isSpanish ? \'Ver Lista de Compras\' : \'View Shopping List\'}</span>\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Main Grid: 1. Comprar M\303\241s (High Velocity) & 2. No Comprar Ya (Waste Risk) */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-5\">\n        {/* SECTION 1: Comprar M\303\241s / Alta Rotaci\303\263n */}\n        <div className=\"bg-white dark:bg-[#1e2124] border border-[#e1e2e8] dark:border-[#2e3135] rounded-2xl p-5 shadow-sm flex flex-col\">\n          <div className=\"flex items-center justify-between mb-3.5\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-8 h-8 rounded-lg bg-[#004a21]/10 text-[#004a21] dark:bg-[#004a21]/30 dark:text-[#8dde9d] flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-[20px]\">trending_up</span>\n              </div>\n              <div>\n                <h3 className=\"font-bold text-sm sm:text-base text-[#191c20] dark:text-white\">\n                  {t.aiInsights.highVelocityTitle}\n                </h3>\n                <p className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd]\">\n                  {t.aiInsights.highVelocitySub}\n                </p>\n              </div>\n            </div>\n            <span className=\"px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#096430]/10 text-[#096430] dark:text-[#8dde9d]\">\n              {analysis?.topBoughtVelocity?.length || 0} {isSpanish ? \'art\303\255culos\' : \'items\'}\n            </span>\n          </div>\n\n          {analysis?.topBoughtVelocity && analysis.topBoughtVelocity.length > 0 ? (\n            <div className=\"flex flex-col gap-2.5 flex-1\">\n              {analysis.topBoughtVelocity.map((item, idx) => {\n                const isAdded = !!addedItems[item.name];\n                return (\n                  <div\n                    key={`vel-${idx}`}\n                    className=\"p-3 rounded-xl border border-[#e1e2e8] dark:border-[#2e3135] bg-[#f8f9ff] dark:bg-[#25282c] hover:border-[#096430]/40 transition-colors flex items-center justify-between gap-3\"\n                  >\n                    <div className=\"min-w-0 flex-1\">\n                      <div className=\"flex items-center gap-2 flex-wrap\">\n                        <span className=\"font-semibold text-sm text-[#191c20] dark:text-white truncate\">\n                          {item.name}\n                        </span>\n                        <span className=\"px-2 py-0.5 rounded-md text-[10px] font-medium bg-[#096430]/15 text-[#096430] dark:text-[#a2f5b2]\">\n                          {item.velocityText || (isSpanish ? \'Alta velocidad\' : \'High velocity\')}\n                        </span>\n                        {item.daysLeftEstimate > 0 && (\n                          <span className=\"text-[11px] text-[#ff7a2b] font-medium\">\n                            {t.aiInsights.daysRemaining(item.daysLeftEstimate)}\n                          </span>\n                        )}\n                      </div>\n                      <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd] mt-1 leading-snug\">\n                        {item.reason}\n                      </p>\n                      <div className=\"mt-1 text-[11px] font-medium text-[#004a21] dark:text-[#8dde9d]\">\n                        {isSpanish ? \'Sugerencia de reposici\303\263n:\' : \'Suggested restock:\'} +{item.recommendedQuantity} {item.unit}\n                      </div>\n                    </div>\n\n                    <button\n                      onClick={() => handleAddVelocityToShopping(item)}\n                      disabled={isAdded}\n                      className={`px-3 py-2 rounded-xl text-xs font-semibold shrink-0 transition-all flex items-center gap-1.5 active:scale-95 ${\n                        isAdded\n                          ? \'bg-[#096430] text-white cursor-default\'\n                          : \'bg-white dark:bg-[#1e2124] border border-[#004a21] text-[#004a21] dark:text-[#8dde9d] hover:bg-[#004a21] hover:text-white\'\n                      }`}\n                    >\n                      <span className=\"material-symbols-outlined text-[16px]\">\n                        {isAdded ? \'check\' : \'add_shopping_cart\'}\n                      </span>\n                      <span>{isAdded ? t.aiInsights.addedToList : t.aiInsights.addToList}</span>\n                    </button>\n                  </div>\n                );\n              })}\n            </div>\n          ) : (\n            <div className=\"p-6 text-center text-xs text-[#707a6f] dark:text-[#bfc9bd] flex flex-col items-center justify-center gap-2\">\n              <span className=\"material-symbols-outlined text-[32px] text-[#707a6f]/50\">done_all</span>\n              <span>{isSpanish ? \'Tus niveles de inventario est\303\241n equilibrados por ahora.\' : \'Pantry inventory is well balanced.\'}</span>\n            </div>\n          )}\n        </div>\n\n        {/* SECTION 2: No Comprar Ya / Riesgo de Caducidad */}\n        <div className=\"bg-white dark:bg-[#1e2124] border border-[#e1e2e8] dark:border-[#2e3135] rounded-2xl p-5 shadow-sm flex flex-col\">\n          <div className=\"flex items-center justify-between mb-3.5\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-8 h-8 rounded-lg bg-[#ba1a1a]/10 text-[#ba1a1a] dark:bg-[#ba1a1a]/30 dark:text-[#ffb4ab] flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-[20px]\">block</span>\n              </div>\n              <div>\n                <h3 className=\"font-bold text-sm sm:text-base text-[#191c20] dark:text-white\">\n                  {t.aiInsights.wasteRiskTitle}\n                </h3>\n                <p className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd]\">\n                  {t.aiInsights.wasteRiskSub}\n                </p>\n              </div>\n            </div>\n            <span className=\"px-2 py-0.5 rounded-full text-[11px] font-semibold bg-[#ba1a1a]/10 text-[#ba1a1a] dark:text-[#ffb4ab]\">\n              {analysis?.wasteRiskItems?.length || 0} {isSpanish ? \'en alerta\' : \'alerts\'}\n            </span>\n          </div>\n\n          {analysis?.wasteRiskItems && analysis.wasteRiskItems.length > 0 ? (\n            <div className=\"flex flex-col gap-2.5 flex-1\">\n              {analysis.wasteRiskItems.map((item, idx) => (\n                <div\n                  key={`risk-${idx}`}\n                  className=\"p-3 rounded-xl border border-[#ba1a1a]/20 bg-[#fff8f7] dark:bg-[#2c2020] flex flex-col gap-1.5\"\n                >\n                  <div className=\"flex items-center justify-between gap-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-semibold text-sm text-[#191c20] dark:text-white\">\n                        {item.name}\n                      </span>\n                      <span className=\"px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-[#ba1a1a] text-white\">\n                        {t.aiInsights.avoidBuyingBadge}\n                      </span>\n                    </div>\n                    <span className=\"text-[10px] font-semibold text-[#ba1a1a] dark:text-[#ffb4ab]\">\n                      {item.riskLevel === \'critico\' ? \'\342\232\240\357\270\217 Cr\303\255tico\' : \'\342\217\263 Por Vencer\'}\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd] leading-relaxed\">\n                    <strong>{isSpanish ? \'Causa:\' : \'Reason:\'}</strong> {item.riskReason}\n                  </p>\n                  <div className=\"text-xs text-[#004a21] dark:text-[#8dde9d] font-medium bg-white/60 dark:bg-black/20 p-2 rounded-lg border border-[#e1e2e8]/60 dark:border-white/5\">\n                    \360\237\222\241 <strong>{isSpanish ? \'Acci\303\263n recomendada:\' : \'Recommendation:\'}</strong> {item.recommendation}\n                  </div>\n                </div>\n              ))}\n            </div>\n          ) : (\n            <div className=\"p-6 text-center text-xs text-[#707a6f] dark:text-[#bfc9bd] flex flex-col items-center justify-center gap-2\">\n              <span className=\"material-symbols-outlined text-[32px] text-[#096430]\">check_circle</span>\n              <span>{isSpanish ? \'\302\241Excelente! No tienes productos en riesgo de desperdicio inminente.\' : \'Great! No immediate waste risks detected.\'}</span>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* SECTION 3: Pron\303\263stico Semanal Inteligente (Weekly Forecast) & Budget Tip */}\n      {analysis?.weeklyForecast && (\n        <div className=\"bg-white dark:bg-[#1e2124] border border-[#e1e2e8] dark:border-[#2e3135] rounded-2xl p-5 shadow-sm flex flex-col gap-4\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-8 h-8 rounded-lg bg-[#003d87]/10 text-[#003d87] dark:bg-[#003d87]/30 dark:text-[#a8c7fa] flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-[20px]\">calendar_view_week</span>\n              </div>\n              <div>\n                <h3 className=\"font-bold text-sm sm:text-base text-[#191c20] dark:text-white\">\n                  {t.aiInsights.forecastTitle}\n                </h3>\n                <p className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd]\">\n                  {t.aiInsights.forecastSub}\n                </p>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {/* Qu\303\251 S\303\215 comprar */}\n            <div className=\"bg-[#f2fdf4] dark:bg-[#162719] border border-[#096430]/20 rounded-xl p-4 flex flex-col gap-2\">\n              <div className=\"flex items-center gap-2 text-[#004a21] dark:text-[#8dde9d] font-bold text-xs sm:text-sm\">\n                <span className=\"material-symbols-outlined text-[18px]\">check_circle</span>\n                <span>{t.aiInsights.whatToBuy}</span>\n              </div>\n              <ul className=\"flex flex-col gap-2 mt-1\">\n                {analysis.weeklyForecast.recommendedToBuy.map((item, idx) => (\n                  <li key={`wtb-${idx}`} className=\"text-xs text-[#191c20] dark:text-[#e1e2e8] flex items-start gap-2\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-[#096430] mt-1.5 shrink-0\" />\n                    <div>\n                      <strong className=\"font-semibold\">{item.name}</strong> ({item.quantity} {item.unit}):{\' \'}\n                      <span className=\"text-[#404940] dark:text-[#bfc9bd]\">{item.reason}</span>\n                    </div>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Qu\303\251 NO comprar */}\n            <div className=\"bg-[#fff8f7] dark:bg-[#2c1d1d] border border-[#ba1a1a]/20 rounded-xl p-4 flex flex-col gap-2\">\n              <div className=\"flex items-center gap-2 text-[#ba1a1a] dark:text-[#ffb4ab] font-bold text-xs sm:text-sm\">\n                <span className=\"material-symbols-outlined text-[18px]\">cancel</span>\n                <span>{t.aiInsights.whatNotToBuy}</span>\n              </div>\n              <ul className=\"flex flex-col gap-2 mt-1\">\n                {analysis.weeklyForecast.avoidBuying.map((item, idx) => (\n                  <li key={`wnb-${idx}`} className=\"text-xs text-[#191c20] dark:text-[#e1e2e8] flex items-start gap-2\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-[#ba1a1a] mt-1.5 shrink-0\" />\n                    <div>\n                      <strong className=\"font-semibold\">{item.name}</strong>:{\' \'}\n                      <span className=\"text-[#404940] dark:text-[#bfc9bd]\">{item.reason}</span>\n                    </div>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n\n          {/* Budget Saving Tip Banner */}\n          {analysis.weeklyForecast.budgetSavingTip && (\n            <div className=\"p-3.5 rounded-xl bg-[#003d87]/10 dark:bg-[#003d87]/20 border border-[#003d87]/20 flex items-start gap-3 text-xs text-[#003d87] dark:text-[#a8c7fa]\">\n              <span className=\"material-symbols-outlined text-[20px] shrink-0 mt-0.5\">savings</span>\n              <div>\n                <strong className=\"font-bold\">{t.aiInsights.budgetTipTitle}: </strong>\n                <span>{analysis.weeklyForecast.budgetSavingTip}</span>\n              </div>\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* SECTION 4: Recetas de Rescate Cero Desperdicio */}\n      {analysis?.recipeSuggestions && analysis.recipeSuggestions.length > 0 && (\n        <div className=\"bg-white dark:bg-[#1e2124] border border-[#e1e2e8] dark:border-[#2e3135] rounded-2xl p-5 shadow-sm flex flex-col gap-3.5\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-lg bg-[#ff7a2b]/10 text-[#ff7a2b] dark:bg-[#ff7a2b]/30 dark:text-[#ffb59d] flex items-center justify-center\">\n              <span className=\"material-symbols-outlined text-[20px]\">restaurant</span>\n            </div>\n            <div>\n              <h3 className=\"font-bold text-sm sm:text-base text-[#191c20] dark:text-white\">\n                {t.aiInsights.recipesTitle}\n              </h3>\n              <p className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd]\">\n                {t.aiInsights.recipesSub}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n            {analysis.recipeSuggestions.map((rec, idx) => (\n              <div\n                key={`rec-${idx}`}\n                className=\"p-4 rounded-xl border border-[#e1e2e8] dark:border-[#2e3135] bg-[#f8f9ff] dark:bg-[#25282c] flex flex-col justify-between gap-3\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between gap-2 mb-1.5\">\n                    <h4 className=\"font-bold text-sm text-[#191c20] dark:text-white\">{rec.title}</h4>\n                    <span className=\"px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#ff7a2b]/15 text-[#ff7a2b]\">\n                      \342\217\261\357\270\217 {rec.prepTime} \342\200\242 {rec.difficulty}\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd] leading-relaxed\">\n                    {rec.description}\n                  </p>\n                </div>\n\n                <div className=\"flex items-center gap-1.5 flex-wrap pt-2 border-t border-[#e1e2e8] dark:border-[#2e3135]\">\n                  <span className=\"text-[10px] font-semibold text-[#004a21] dark:text-[#8dde9d]\">\n                    {isSpanish ? \'Ingredientes a rescatar:\' : \'Rescue ingredients:\'}\n                  </span>\n                  {rec.ingredientsToRescue.map((ing, ingIdx) => (\n                    <span\n                      key={`ing-${ingIdx}`}\n                      className=\"px-2 py-0.5 rounded-md text-[10px] font-medium bg-[#004a21]/10 text-[#004a21] dark:text-[#a2f5b2]\"\n                    >\n                      {ing}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* SECTION 5: Consultor de Despensa IA Interactivo (Interactive AI Chat/Advisor) */}\n      <div className=\"bg-white dark:bg-[#1e2124] border border-[#e1e2e8] dark:border-[#2e3135] rounded-2xl p-5 shadow-sm flex flex-col gap-4\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded-lg bg-[#004a21] text-white flex items-center justify-center\">\n            <span className=\"material-symbols-outlined text-[20px]\">smart_toy</span>\n          </div>\n          <div>\n            <h3 className=\"font-bold text-sm sm:text-base text-[#191c20] dark:text-white\">\n              {t.aiInsights.askAdvisorTitle}\n            </h3>\n            <p className=\"text-[11px] text-[#707a6f] dark:text-[#bfc9bd]\">\n              {t.aiInsights.askAdvisorSub}\n            </p>\n          </div>\n        </div>\n\n        {/* Suggested question chips */}\n        <div className=\"flex gap-2 overflow-x-auto pb-1 no-scrollbar\">\n          {t.aiInsights.suggestedQuestions.map((q, idx) => (\n            <button\n              key={`sq-${idx}`}\n              onClick={() => handleAskAdvisor(q)}\n              disabled={isAsking}\n              className=\"px-3 py-1.5 rounded-full text-xs font-medium bg-[#f8f9ff] dark:bg-[#25282c] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] border border-[#e1e2e8] dark:border-[#2e3135] text-[#191c20] dark:text-[#e1e2e8] shrink-0 transition-colors cursor-pointer text-left\"\n            >\n              \360\237\222\254 {q}\n            </button>\n          ))}\n        </div>\n\n        {/* Chat History Box */}\n        <div className=\"max-h-72 overflow-y-auto flex flex-col gap-2.5 p-3 rounded-xl bg-[#f8f9ff] dark:bg-[#191c20] border border-[#e1e2e8] dark:border-[#2e3135]\">\n          {chatMessages.map((msg) => (\n            <div\n              key={msg.id}\n              className={`flex flex-col max-w-[85%] rounded-2xl px-4 py-2.5 text-xs sm:text-sm leading-relaxed ${\n                msg.sender === \'user\'\n                  ? \'self-end bg-[#004a21] text-white rounded-br-none\'\n                  : \'self-start bg-white dark:bg-[#25282c] text-[#191c20] dark:text-white border border-[#e1e2e8] dark:border-[#2e3135] rounded-bl-none shadow-xs\'\n              }`}\n            >\n              <div className=\"whitespace-pre-wrap\">{msg.text}</div>\n              <span\n                className={`text-[9px] mt-1 self-end ${\n                  msg.sender === \'user\' ? \'text-white/70\' : \'text-[#707a6f] dark:text-[#bfc9bd]\'\n                }`}\n              >\n                {msg.timestamp}\n              </span>\n            </div>\n          ))}\n\n          {isAsking && (\n            <div className=\"self-start flex items-center gap-2 p-3 rounded-2xl bg-white dark:bg-[#25282c] border border-[#e1e2e8] dark:border-[#2e3135] text-xs text-[#707a6f] dark:text-[#bfc9bd]\">\n              <span className=\"material-symbols-outlined animate-spin text-[16px]\">progress_activity</span>\n              <span>{isSpanish ? \'Consultando con Gemini...\' : \'Thinking with Gemini...\'}</span>\n            </div>\n          )}\n        </div>\n\n        {/* Input Bar */}\n        <form\n          onSubmit={(e) => {\n            e.preventDefault();\n            handleAskAdvisor();\n          }}\n          className=\"flex items-center gap-2\"\n        >\n          <input\n            type=\"text\"\n            value={inputQuery}\n            onChange={(e) => setInputQuery(e.target.value)}\n            placeholder={t.aiInsights.askPlaceholder}\n            disabled={isAsking}\n            className=\"flex-1 bg-white dark:bg-[#25282c] border border-[#707a6f]/60 dark:border-[#404940] rounded-xl px-4 py-2.5 text-xs sm:text-sm text-[#191c20] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#004a21] transition-all\"\n          />\n          <button\n            type=\"submit\"\n            disabled={isAsking || !inputQuery.trim()}\n            className=\"px-4 py-2.5 rounded-xl bg-[#004a21] hover:bg-[#096430] active:scale-95 text-white text-xs sm:text-sm font-semibold transition-all shadow-sm flex items-center gap-1.5 disabled:opacity-50 cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">send</span>\n            <span className=\"hidden sm:inline\">{t.aiInsights.sendQuestion}</span>\n          </button>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
