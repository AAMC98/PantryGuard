tion: \'Preguntar\',\n      suggestedQuestions: [\n        \'\302\277Qu\303\251 deber\303\255a cocinar hoy con lo que est\303\241 por vencer?\',\n        \'\302\277Qu\303\251 productos debo reponer con prioridad?\',\n        \'\302\277C\303\263mo puedo alargar la vida \303\272til de mis verduras y l\303\241cteos?\',\n      ],\n      noDataYet: \'No hay suficientes productos registrados para un diagn\303\263stico completo.\',\n    },"
      replacement_content: "    nav: {\n      dashboard: \'Dashboard\',\n      shopping: \'Compras\',\n      aiInsights: \'Chef & Recetas IA\',\n      profile: \'Perfil\',\n    },\n    aiInsights: {\n      title: \'Chef IA & Recetas de Aprovechamiento\',\n      subtitle: \'Recetas inteligentes basadas 100% en tu despensa actual para evitar el desperdicio, priorizando lo pr\303\263ximo a caducar.\',\n      refreshButton: \'Nuevas Recetas IA\',\n      refreshing: \'El Chef IA est\303\241 creando tus recetas...\',\n      mealTabs: {\n        all: \'Todas\',\n        breakfast: \'Desayunos\',\n        lunchDinner: \'Almuerzos y Cenas\',\n        express: \'R\303\241pidas (<15 min)\',\n        dessertSnack: \'Snacks y Postres\',\n      },\n      rescuePriorityBadge: \'Prioridad de Rescate\',\n      expiringSoonBadge: (days: number) => `Vence en ${days} d\303\255a${days !== 1 ? \'s\' : \'\'}`,\n      fromPantryBadge: \'En tu despensa\',\n      extraIngredientsTitle: \'Ingredientes extra / Condimentos b\303\241sicos:\',\n      pantryIngredientsTitle: \'Ingredientes rescatados de tu despensa:\',\n      stepsTitle: \'Paso a paso:\',\n      chefTipTitle: \'Consejo del Chef Zero-Waste:\',\n      zeroWasteTitle: \'Impacto contra el desperdicio:\',\n      addMissingToShopping: \'A\303\261adir faltantes a lista de compras\',\n      addedToShopping: \'\302\241A\303\261adido a compras!\',\n      saveRecipe: \'Guardar receta\',\n      savedRecipe: \'Guardada en favoritos\',\n      savedRecipesTab: \'Mis Recetas Guardadas\',\n      customPromptPlaceholder: \'Ej: Quiero algo vegetariano, una cena ligera o usar mis pl\303\241tanos maduros...\',\n      generateCustom: \'Crear receta personalizada\',\n      expiredWarningTitle: \'Seguridad Alimentaria: Alimentos caducados excluidos\',\n      expiredWarningDesc: (count: number) => `Tienes ${count} producto(s) caducado(s) en tu despensa. Por salud y seguridad alimentaria, nunca se incluyen en las recetas. Te sugerimos desecharlos o compostarlos.`,\n      askAdvisorTitle: \'Preg\303\272ntale al Chef IA en Vivo\',\n      askAdvisorSub: \'Consulta c\303\263mo sustituir ingredientes, t\303\251cnicas de cocci\303\263n o c\303\263mo conservar mejor tus alimentos.\',\n      askPlaceholder: \'Ej. \302\277Con qu\303\251 puedo sustituir el queso o c\303\263mo congelo mis verduras?\',\n      sendQuestion: \'Consultar al Chef\',\n      suggestedQuestions: [\n        \'\302\277Qu\303\251 puedo cocinar en menos de 15 minutos con mis verduras?\',\n        \'\302\277C\303\263mo puedo aprovechar mis frutas maduras antes de que se da\303\261en?\',\n        \'\302\277Qu\303\251 t\303\251cnicas de conservaci\303\263n alargan la vida de mis l\303\241cteos?\',\n      ],\n      noDataYet: \'Registra productos en tu despensa para que el Chef IA pueda recomendarte recetas a medida.\',\n      servings: \'porciones\',\n      prep: \'Prep\',\n      cook: \'Cocci\303\263n\',\n    },"
