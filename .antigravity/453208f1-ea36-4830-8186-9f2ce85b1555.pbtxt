  file_change {
    absolute_path_uri: "file:///src/components/PreferencesView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export const PreferencesView: React.FC<PreferencesViewProps> = ({\n  preferences,\n  onUpdatePreferences,\n  onBack,\n  onShowToast,\n}) => {\n  const t = translations[preferences.language];\n\n  const [lang, setLang] = useState<Language>(preferences.language);\n  const [dark, setDark] = useState<boolean>(preferences.darkMode);\n  const [units, setUnits] = useState<UnitSystem>(preferences.unitSystem);\n  const [isSaving, setIsSaving] = useState(false);\n\n  const handleLanguageChange = (newLang: Language) => {\n    setLang(newLang);\n    onUpdatePreferences({ language: newLang });\n  };\n\n  const handleThemeToggle = () => {\n    const nextDark = !dark;\n    setDark(nextDark);\n    onUpdatePreferences({ darkMode: nextDark });\n    if (nextDark) {\n      document.documentElement.classList.add(\'dark\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n    }\n  };\n\n  const handleUnitsChange = (newUnits: UnitSystem) => {\n    setUnits(newUnits);\n    onUpdatePreferences({ unitSystem: newUnits });\n  };\n\n  const handleSave = () => {\n    setIsSaving(true);\n    setTimeout(() => {\n      onUpdatePreferences({\n        language: lang,\n        darkMode: dark,\n        unitSystem: units,\n      });\n      setIsSaving(false);\n      onShowToast(t.preferences.savedToast);\n      setTimeout(onBack, 300);\n    }, 400);\n  };\n\n  return (\n    <div className=\"flex-1 w-full max-w-3xl mx-auto px-3 sm:px-6 py-4 sm:py-6 flex flex-col gap-5\">\n      {/* Title */}\n      <div className=\"flex items-center gap-3\">\n        <button\n          onClick={onBack}\n          aria-label=\"Volver\"\n          className=\"w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">arrow_back</span>\n        </button>\n        <h2 className=\"text-2xl font-bold text-[#191c20] dark:text-[#f8f9ff]\">\n          {t.preferences.title}\n        </h2>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {/* Language Settings Card */}\n        <section className=\"bg-white dark:bg-[#1e2124] rounded-xl p-5 shadow-sm border border-[#bfc9bd]/60 dark:border-[#404940] flex flex-col gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[26px]\">\n              language\n            </span>\n            <h3 className=\"font-semibold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n              {t.preferences.languageTitle}\n            </h3>\n          </div>\n          <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n            {t.preferences.languageDesc}\n          </p>\n\n          <div className=\"mt-2 flex flex-col gap-2\">\n            <label\n              onClick={() => handleLanguageChange(\'es\')}\n              className={`flex items-center justify-between p-3 rounded-lg cursor-pointer transition-colors border ${\n                lang === \'es\'\n                  ? \'bg-[#096430]/10 border-[#004a21] dark:border-[#87d897]\'\n                  : \'bg-[#f8f9ff] dark:bg-[#2e3135] border-transparent hover:bg-[#e1e2e8]\'\n              }`}\n            >\n              <span className=\"text-sm font-medium text-[#191c20] dark:text-[#f8f9ff]\">\n                {t.preferences.spanish}\n              </span>\n              <input\n                type=\"radio\"\n                name=\"language\"\n                value=\"es\"\n                checked={lang === \'es\'}\n                onChange={() => handleLanguageChange(\'es\')}\n                className=\"w-4 h-4 text-[#004a21] focus:ring-[#004a21]\"\n              />\n            </label>\n\n            <label\n              onClick={() => handleLanguageChange(\'en\')}\n              className={`flex items-center justify-between p-3 rounded-lg cursor-pointer transition-colors border ${\n                lang === \'en\'\n                  ? \'bg-[#096430]/10 border-[#004a21] dark:border-[#87d897]\'\n                  : \'bg-[#f8f9ff] dark:bg-[#2e3135] border-transparent hover:bg-[#e1e2e8]\'\n              }`}\n            >\n              <span className=\"text-sm font-medium text-[#191c20] dark:text-[#f8f9ff]\">\n                {t.preferences.english}\n              </span>\n              <input\n                type=\"radio\"\n                name=\"language\"\n                value=\"en\"\n                checked={lang === \'en\'}\n                onChange={() => handleLanguageChange(\'en\')}\n                className=\"w-4 h-4 text-[#004a21] focus:ring-[#004a21]\"\n              />\n            </label>\n          </div>\n        </section>\n\n        {/* Theme Settings Card */}\n        <section className=\"bg-white dark:bg-[#1e2124] rounded-xl p-5 shadow-sm border border-[#bfc9bd]/60 dark:border-[#404940] flex flex-col gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[26px]\">\n              dark_mode\n            </span>\n            <h3 className=\"font-semibold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n              {t.preferences.appearanceTitle}\n            </h3>\n          </div>\n          <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n            {t.preferences.appearanceDesc}\n          </p>\n\n          <div className=\"mt-auto pt-4 flex items-center justify-between p-3 bg-[#f8f9ff] dark:bg-[#2e3135] rounded-lg\">\n            <span className=\"text-sm font-medium text-[#191c20] dark:text-[#f8f9ff]\">\n              {t.preferences.darkMode}\n            </span>\n            <button\n              type=\"button\"\n              role=\"switch\"\n              aria-checked={dark}\n              onClick={handleThemeToggle}\n              className={`relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none ${\n                dark ? \'bg-[#004a21] dark:bg-[#87d897]\' : \'bg-[#bfc9bd]\'\n              }`}\n            >\n              <span\n                className={`pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out ${\n                  dark ? \'translate-x-5\' : \'translate-x-0\'\n                }`}\n              />\n            </button>\n          </div>\n        </section>\n\n        {/* Units Settings Card */}\n        <section className=\"bg-white dark:bg-[#1e2124] rounded-xl p-5 shadow-sm border border-[#bfc9bd]/60 dark:border-[#404940] flex flex-col gap-3 md:col-span-2\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[26px]\">\n              scale\n            </span>\n            <h3 className=\"font-semibold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n              {t.preferences.unitsTitle}\n            </h3>\n          </div>\n          <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n            {t.preferences.unitsDesc}\n          </p>\n\n          <div className=\"grid grid-cols-2 gap-3 mt-2\">\n            <label\n              onClick={() => handleUnitsChange(\'metric\')}\n              className={`p-4 text-center border-2 rounded-xl cursor-pointer transition-all flex flex-col justify-center ${\n                units === \'metric\'\n                  ? \'border-[#004a21] bg-[#096430] text-white\'\n                  : \'border-[#bfc9bd]/60 bg-[#f8f9ff] dark:bg-[#2e3135] text-[#191c20] dark:text-[#f8f9ff] hover:bg-[#e1e2e8]\'\n              }`}\n            >\n              <input\n                type=\"radio\"\n                name=\"units\"\n                value=\"metric\"\n                checked={units === \'metric\'}\n                onChange={() => handleUnitsChange(\'metric\')}\n                className=\"sr-only\"\n              />\n              <span className=\"text-sm font-bold\">{t.preferences.metric}</span>\n              <span className=\"text-[11px] mt-0.5 opacity-80\">\n                {t.preferences.metricDetails}\n              </span>\n            </label>\n\n            <label\n              onClick={() => handleUnitsChange(\'imperial\')}\n              className={`p-4 text-center border-2 rounded-xl cursor-pointer transition-all flex flex-col justify-center ${\n                units === \'imperial\'\n                  ? \'border-[#004a21] bg-[#096430] text-white\'\n                  : \'border-[#bfc9bd]/60 bg-[#f8f9ff] dark:bg-[#2e3135] text-[#191c20] dark:text-[#f8f9ff] hover:bg-[#e1e2e8]\'\n              }`}\n            >\n              <input\n                type=\"radio\"\n                name=\"units\"\n                value=\"imperial\"\n                checked={units === \'imperial\'}\n                onChange={() => handleUnitsChange(\'imperial\')}\n                className=\"sr-only\"\n              />\n              <span className=\"text-sm font-bold\">{t.preferences.imperial}</span>\n              <span className=\"text-[11px] mt-0.5 opacity-80\">\n                {t.preferences.imperialDetails}\n              </span>\n            </label>\n          </div>\n        </section>\n      </div>\n\n      {/* Save Button */}\n      <div className=\"mt-4 flex justify-end\">\n        <button\n          onClick={handleSave}\n          disabled={isSaving}\n          className=\"bg-[#004a21] hover:bg-[#096430] text-white text-xs font-semibold py-3 px-8 rounded-full shadow-sm active:scale-95 transition-all flex items-center justify-center gap-2 w-full md:w-auto\"\n        >\n          <span\n            className={`material-symbols-outlined text-[18px] ${\n              isSaving ? \'animate-spin\' : \'\'\n            }`}\n          >\n            {isSaving ? \'sync\' : \'save\'}\n          </span>\n          <span>{isSaving ? \'Guardando...\' : t.preferences.saveChanges}</span>\n        </button>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { Language, UnitSystem, UserPreferences } from \'../types\';\nimport { translations } from \'../utils/i18n\';\n\ninterface PreferencesViewProps {\n  preferences: UserPreferences;\n  onUpdatePreferences: (updated: Partial<UserPreferences>) => void;\n  onBack: () => void;\n  onShowToast: (message: string) => void;\n}\n\nexport const PreferencesView: React.FC<PreferencesViewProps> = ({\n  preferences,\n  onUpdatePreferences,\n  onBack,\n  onShowToast,\n}) => {\n  const t = translations[preferences.language];\n\n  const [lang, setLang] = useState<Language>(preferences.language);\n  const [dark, setDark] = useState<boolean>(preferences.darkMode);\n  const [units, setUnits] = useState<UnitSystem>(preferences.unitSystem);\n  const [isSaving, setIsSaving] = useState(false);\n\n  useEffect(() => {\n    setLang(preferences.language);\n    setDark(preferences.darkMode);\n    setUnits(preferences.unitSystem);\n  }, [preferences]);\n\n  const handleLanguageChange = (newLang: Language) => {\n    setLang(newLang);\n    onUpdatePreferences({ language: newLang });\n    onShowToast(\n      newLang === \'es\' ? \'Idioma cambiado a Espa\303\261ol\' : \'Language changed to English\'\n    );\n  };\n\n  const handleThemeToggle = (targetDark?: boolean) => {\n    const nextDark = typeof targetDark === \'boolean\' ? targetDark : !dark;\n    setDark(nextDark);\n    onUpdatePreferences({ darkMode: nextDark });\n    if (nextDark) {\n      document.documentElement.classList.add(\'dark\');\n      onShowToast(preferences.language === \'es\' ? \'Modo Oscuro activado\' : \'Dark mode enabled\');\n    } else {\n      document.documentElement.classList.remove(\'dark\');\n      onShowToast(preferences.language === \'es\' ? \'Modo Claro activado\' : \'Light mode enabled\');\n    }\n  };\n\n  const handleUnitsChange = (newUnits: UnitSystem) => {\n    setUnits(newUnits);\n    onUpdatePreferences({ unitSystem: newUnits });\n    onShowToast(\n      newUnits === \'metric\'\n        ? (preferences.language === \'es\' ? \'Sistema M\303\251trico seleccionado (kg, g, L, ml)\' : \'Metric system selected (kg, g, L, ml)\')\n        : (preferences.language === \'es\' ? \'Sistema Imperial seleccionado (lb, oz, fl oz)\' : \'Imperial system selected (lb, oz, fl oz)\')\n    );\n  };\n\n  const handleSave = () => {\n    setIsSaving(true);\n    setTimeout(() => {\n      onUpdatePreferences({\n        language: lang,\n        darkMode: dark,\n        unitSystem: units,\n      });\n      setIsSaving(false);\n      onShowToast(t.preferences.savedToast);\n      setTimeout(onBack, 300);\n    }, 400);\n  };\n\n  return (\n    <div className=\"flex-1 w-full max-w-3xl mx-auto px-3 sm:px-6 py-4 sm:py-6 flex flex-col gap-5\">\n      {/* Title */}\n      <div className=\"flex items-center gap-3\">\n        <button\n          onClick={onBack}\n          aria-label=\"Volver\"\n          className=\"w-10 h-10 rounded-full flex items-center justify-center text-[#404940] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#2e3135] transition-colors\"\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">arrow_back</span>\n        </button>\n        <h2 className=\"text-2xl font-bold text-[#191c20] dark:text-[#f8f9ff]\">\n          {t.preferences.title}\n        </h2>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {/* Language Settings Card */}\n        <section className=\"bg-white dark:bg-[#1e2124] rounded-2xl p-5 shadow-sm border border-[#bfc9bd]/60 dark:border-[#404940] flex flex-col gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[26px]\">\n              language\n            </span>\n            <h3 className=\"font-semibold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n              {t.preferences.languageTitle}\n            </h3>\n          </div>\n          <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n            {t.preferences.languageDesc}\n          </p>\n\n          <div className=\"mt-2 flex flex-col gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => handleLanguageChange(\'es\')}\n              className={`flex items-center justify-between p-3.5 rounded-xl cursor-pointer transition-all border text-left ${\n                lang === \'es\'\n                  ? \'bg-[#096430]/10 dark:bg-[#87d897]/15 border-[#004a21] dark:border-[#87d897] font-semibold\'\n                  : \'bg-[#f8f9ff] dark:bg-[#2e3135] border-transparent hover:bg-[#e1e2e8] dark:hover:bg-[#383c41]\'\n              }`}\n            >\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"text-base\">\360\237\207\262\360\237\207\275</span>\n                <span className=\"text-sm text-[#191c20] dark:text-[#f8f9ff]\">\n                  {t.preferences.spanish}\n                </span>\n              </div>\n              <span className={`material-symbols-outlined text-[20px] ${lang === \'es\' ? \'text-[#004a21] dark:text-[#87d897]\' : \'text-transparent\'}`}>\n                check_circle\n              </span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleLanguageChange(\'en\')}\n              className={`flex items-center justify-between p-3.5 rounded-xl cursor-pointer transition-all border text-left ${\n                lang === \'en\'\n                  ? \'bg-[#096430]/10 dark:bg-[#87d897]/15 border-[#004a21] dark:border-[#87d897] font-semibold\'\n                  : \'bg-[#f8f9ff] dark:bg-[#2e3135] border-transparent hover:bg-[#e1e2e8] dark:hover:bg-[#383c41]\'\n              }`}\n            >\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"text-base\">\360\237\207\272\360\237\207\270</span>\n                <span className=\"text-sm text-[#191c20] dark:text-[#f8f9ff]\">\n                  {t.preferences.english}\n                </span>\n              </div>\n              <span className={`material-symbols-outlined text-[20px] ${lang === \'en\' ? \'text-[#004a21] dark:text-[#87d897]\' : \'text-transparent\'}`}>\n                check_circle\n              </span>\n            </button>\n          </div>\n        </section>\n\n        {/* Theme Settings Card (Light / Dark Mode Selector) */}\n        <section className=\"bg-white dark:bg-[#1e2124] rounded-2xl p-5 shadow-sm border border-[#bfc9bd]/60 dark:border-[#404940] flex flex-col gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[26px]\">\n              {dark ? \'dark_mode\' : \'light_mode\'}\n            </span>\n            <h3 className=\"font-semibold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n              {t.preferences.appearanceTitle}\n            </h3>\n          </div>\n          <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n            {t.preferences.appearanceDesc}\n          </p>\n\n          <div className=\"mt-2 grid grid-cols-2 gap-2\">\n            {/* Light Mode Option */}\n            <button\n              type=\"button\"\n              onClick={() => handleThemeToggle(false)}\n              className={`p-3 rounded-xl border flex flex-col items-center gap-2 transition-all ${\n                !dark\n                  ? \'bg-[#f8f9ff] border-[#004a21] text-[#004a21] shadow-sm font-semibold ring-2 ring-[#004a21]/20\'\n                  : \'bg-[#f8f9ff] dark:bg-[#2e3135] border-transparent text-[#707a6f] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#383c41]\'\n              }`}\n            >\n              <div className=\"w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600\">\n                <span className=\"material-symbols-outlined text-[22px]\">wb_sunny</span>\n              </div>\n              <span className=\"text-xs sm:text-sm\">\n                {preferences.language === \'es\' ? \'Modo Claro\' : \'Light Mode\'}\n              </span>\n              {!dark && (\n                <span className=\"text-[10px] bg-[#004a21] text-white px-2 py-0.5 rounded-full font-medium\">\n                  {preferences.language === \'es\' ? \'Activo\' : \'Active\'}\n                </span>\n              )}\n            </button>\n\n            {/* Dark Mode Option */}\n            <button\n              type=\"button\"\n              onClick={() => handleThemeToggle(true)}\n              className={`p-3 rounded-xl border flex flex-col items-center gap-2 transition-all ${\n                dark\n                  ? \'bg-[#111318] border-[#87d897] text-[#87d897] shadow-sm font-semibold ring-2 ring-[#87d897]/30\'\n                  : \'bg-[#f8f9ff] dark:bg-[#2e3135] border-transparent text-[#707a6f] dark:text-[#bfc9bd] hover:bg-[#e1e2e8] dark:hover:bg-[#383c41]\'\n              }`}\n            >\n              <div className=\"w-10 h-10 rounded-full bg-indigo-950 flex items-center justify-center text-indigo-300\">\n                <span className=\"material-symbols-outlined text-[22px]\">nightlight</span>\n              </div>\n              <span className=\"text-xs sm:text-sm\">\n                {preferences.language === \'es\' ? \'Modo Oscuro\' : \'Dark Mode\'}\n              </span>\n              {dark && (\n                <span className=\"text-[10px] bg-[#87d897] text-[#00210b] px-2 py-0.5 rounded-full font-bold\">\n                  {preferences.language === \'es\' ? \'Activo\' : \'Active\'}\n                </span>\n              )}\n            </button>\n          </div>\n        </section>\n\n        {/* Units Settings Card */}\n        <section className=\"bg-white dark:bg-[#1e2124] rounded-2xl p-5 shadow-sm border border-[#bfc9bd]/60 dark:border-[#404940] flex flex-col gap-3 md:col-span-2\">\n          <div className=\"flex items-center gap-2.5\">\n            <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[26px]\">\n              scale\n            </span>\n            <div>\n              <h3 className=\"font-semibold text-base text-[#191c20] dark:text-[#f8f9ff]\">\n                {t.preferences.unitsTitle}\n              </h3>\n              <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n                {t.preferences.unitsDesc}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 mt-1\">\n            <button\n              type=\"button\"\n              onClick={() => handleUnitsChange(\'metric\')}\n              className={`p-4 text-left border-2 rounded-xl cursor-pointer transition-all flex flex-col gap-2 ${\n                units === \'metric\'\n                  ? \'border-[#004a21] dark:border-[#87d897] bg-[#096430]/10 dark:bg-[#87d897]/10\'\n                  : \'border-[#bfc9bd]/60 dark:border-[#404940] bg-[#f8f9ff] dark:bg-[#2e3135] hover:bg-[#e1e2e8] dark:hover:bg-[#383c41]\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-sm font-bold text-[#191c20] dark:text-[#f8f9ff]\">\n                  {t.preferences.metric}\n                </span>\n                {units === \'metric\' && (\n                  <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[20px]\">\n                    check_circle\n                  </span>\n                )}\n              </div>\n              <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n                {preferences.language === \'es\'\n                  ? \'Predetermina unidades de uso com\303\272n: Kilogramos (kg), Gramos (g), Litros (L), Mililitros (ml) y Unidades.\'\n                  : \'Defaults to common units: Kilograms (kg), Grams (g), Liters (L), Milliliters (ml) and Units.\'}\n              </p>\n              <div className=\"flex flex-wrap gap-1 mt-1\">\n                {[\'kg\', \'g\', \'L\', \'ml\', \'unidades\'].map((u) => (\n                  <span\n                    key={u}\n                    className=\"text-[11px] font-medium px-2 py-0.5 rounded-md bg-white dark:bg-[#1e2124] border border-[#bfc9bd]/60 dark:border-[#404940] text-[#191c20] dark:text-[#f8f9ff]\"\n                  >\n                    {u}\n                  </span>\n                ))}\n              </div>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleUnitsChange(\'imperial\')}\n              className={`p-4 text-left border-2 rounded-xl cursor-pointer transition-all flex flex-col gap-2 ${\n                units === \'imperial\'\n                  ? \'border-[#004a21] dark:border-[#87d897] bg-[#096430]/10 dark:bg-[#87d897]/10\'\n                  : \'border-[#bfc9bd]/60 dark:border-[#404940] bg-[#f8f9ff] dark:bg-[#2e3135] hover:bg-[#e1e2e8] dark:hover:bg-[#383c41]\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-sm font-bold text-[#191c20] dark:text-[#f8f9ff]\">\n                  {t.preferences.imperial}\n                </span>\n                {units === \'imperial\' && (\n                  <span className=\"material-symbols-outlined text-[#004a21] dark:text-[#87d897] text-[20px]\">\n                    check_circle\n                  </span>\n                )}\n              </div>\n              <p className=\"text-xs text-[#404940] dark:text-[#bfc9bd]\">\n                {preferences.language === \'es\'\n                  ? \'Predetermina unidades est\303\241ndar: Libras (lb), Onzas (oz), Onzas l\303\255quidas (fl oz) y Unidades.\'\n                  : \'Defaults to standard units: Pounds (lb), Ounces (oz), Fluid Ounces (fl oz) and Units.\'}\n              </p>\n              <div className=\"flex flex-wrap gap-1 mt-1\">\n                {[\'lb\', \'oz\', \'unidades\', \'L\', \'g\'].map((u) => (\n                  <span\n                    key={u}\n                    className=\"text-[11px] font-medium px-2 py-0.5 rounded-md bg-white dark:bg-[#1e2124] border border-[#bfc9bd]/60 dark:border-[#404940] text-[#191c20] dark:text-[#f8f9ff]\"\n                  >\n                    {u}\n                  </span>\n                ))}\n              </div>\n            </button>\n          </div>\n        </section>\n      </div>\n\n      {/* Save Button */}\n      <div className=\"mt-2 flex justify-end\">\n        <button\n          onClick={handleSave}\n          disabled={isSaving}\n          className=\"bg-[#004a21] hover:bg-[#096430] text-white text-xs font-semibold py-3 px-8 rounded-full shadow-sm active:scale-95 transition-all flex items-center justify-center gap-2 w-full md:w-auto\"\n        >\n          <span\n            className={`material-symbols-outlined text-[18px] ${\n              isSaving ? \'animate-spin\' : \'\'\n            }`}\n          >\n            {isSaving ? \'sync\' : \'save\'}\n          </span>\n          <span>{isSaving ? (preferences.language === \'es\' ? \'Guardando...\' : \'Saving...\') : t.preferences.saveChanges}</span>\n        </button>\n      </div>\n    </div>\n  );\n};"
