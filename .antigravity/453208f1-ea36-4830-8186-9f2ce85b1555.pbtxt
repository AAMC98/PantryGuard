    instruction: "Remove live chat imports, state, methods and UI from AIInsightsView"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect } from \'react\';\nimport ReactMarkdown from \'react-markdown\';\nimport {\n  AIRecipe,\n  AIRecipeResponse,\n  Product,\n  ShoppingItem,\n  UserPreferences,\n  UserProfile,\n  ProductCategory,\n  UnitType,\n} from \'../types\';\nimport { translations } from \'../utils/i18n\';\nimport { getContextualChefResponse } from \'../utils/chefKnowledge\';\n\ninterface AIInsightsViewProps {\n  products: Product[];\n  shoppingItems: ShoppingItem[];\n  preferences: UserPreferences;\n  user: UserProfile;\n  onAddShoppingItem: (item: Omit<ShoppingItem, \'id\'>) => void;\n  onShowToast: (message: string) => void;\n  onNavigateTab: (tab: any) => void;\n}\n\ninterface ChatMessage {\n  id: string;\n  sender: \'user\' | \'assistant\';\n  text: string;\n  timestamp: string;\n}\n\ntype MealCategoryFilter = \'all\' | \'desayuno\' | \'almuerzo_cena\' | \'express\' | \'postre_snack\' | \'saved\';\n\nexport const AIInsightsView: React.FC<AIInsightsViewProps> = ({\n  products,\n  preferences,\n  user,\n  onAddShoppingItem,\n  onShowToast,\n}) => {\n  const t = translations[preferences.language || \'es\'];\n  const isSpanish = preferences.language !== \'en\';\n\n  const [recipeData, setRecipeData] = useState<AIRecipeResponse | null>(null);\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [selectedCategory, setSelectedCategory] = useState<MealCategoryFilter>(\'all\');\n  const [customPrompt, setCustomPrompt] = useState<string>(\'\');\n  const [savedRecipes, setSavedRecipes] = useState<AIRecipe[]>(() => {\n    try {\n      const stored = localStorage.getItem(\'pantry_guard_saved_recipes\');\n      return stored ? JSON.parse(stored) : [];\n    } catch {\n      return [];\n    }\n  });\n\n  const [activeRecipeDetails, setActiveRecipeDetails] = useState<AIRecipe | null>(null);\n  const [addedExtraItems, setAddedExtraItems] = useState<Record<string, boolean>>({});\n  const [completedSteps, setCompletedSteps] = useState<Record<string, boolean>>({});\n\n  // Live Chef IA Chat State\n  const [chatMessages, setChatMessages] = useState<ChatMessage[]>([]);\n  const [chefQuery, setChefQuery] = useState<string>(\'\');\n  const [isChefAsking, setIsChefAsking] = useState<boolean>(false);\n\n  // Expiration calculation for pantry safety indicators\n  const now = new Date();\n  const validPantryItems = products.filter((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n    return diffDays >= 0;\n  });\n\n  const expiringSoonItems = products.filter((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n    return diffDays >= 0 && diffDays <= 5;\n  });\n\n  const expiredItems = products.filter((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n    return diffDays < 0;\n  });\n\n  // Fetch or generate zero-waste recipes\n  const fetchRecipes = async (promptOverride?: string, mealTypeOverride?: string) => {\n    setIsLoading(true);\n    try {\n      const response = await fetch(\'/api/ai/recipes\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          products,\n          mealType: mealTypeOverride || selectedCategory,\n          customPrompt: promptOverride !== undefined ? promptOverride : customPrompt,\n          preferences,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(`HTTP error ${response.status}`);\n      }\n\n      const data: AIRecipeResponse = await response.json();\n      setRecipeData(data);\n      onShowToast(\n        isSpanish\n          ? \'\302\241El Chef IA ha creado nuevas recetas con tu despensa!\'\n          : \'AI Chef created new zero-waste recipes!\'\n      );\n    } catch (error) {\n      console.error(\'Failed to generate recipes:\', error);\n      onShowToast(\n        isSpanish\n          ? \'Se generaron recetas locales de aprovechamiento.\'\n          : \'Loaded local zero-waste recipes.\'\n      );\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchRecipes();\n    // Initialize Chef Greeting\n    setChatMessages([\n      {\n        id: \'msg-chef-init\',\n        sender: \'assistant\',\n        text: isSpanish\n          ? `\302\241Hola ${user.name.split(\' \')[0]}! Soy tu Chef IA especializado en Cocina Cero Desperdicio. He revisado tus ${validPantryItems.length} ingredientes v\303\241lidos${expiringSoonItems.length > 0 ? ` y tengo listos los ${expiringSoonItems.length} que vencen pronto para darles prioridad.` : \'.\'} \302\277Quieres una receta espec\303\255fica o tienes dudas sobre c\303\263mo cocinar o conservar alg\303\272n ingrediente?`\n          : `Hello ${user.name.split(\' \')[0]}! I am your Zero-Waste AI Chef. I inspected your ${validPantryItems.length} valid pantry staples${expiringSoonItems.length > 0 ? ` with top priority on the ${expiringSoonItems.length} near expiry.` : \'.\'} Feel free to ask for custom recipes, cooking advice, or ingredient substitutions!`,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      },\n    ]);\n  }, [preferences.language]);\n\n  // Handle saving recipe to local favorites\n  const toggleSaveRecipe = (recipe: AIRecipe) => {\n    const isAlreadySaved = savedRecipes.some((r) => r.id === recipe.id || r.title === recipe.title);\n    let updated: AIRecipe[];\n    if (isAlreadySaved) {\n      updated = savedRecipes.filter((r) => r.id !== recipe.id && r.title !== recipe.title);\n      onShowToast(isSpanish ? \'Receta eliminada de guardadas.\' : \'Recipe removed from saved.\');\n    } else {\n      updated = [{ ...recipe, isSaved: true }, ...savedRecipes];\n      onShowToast(isSpanish ? \'\302\241Receta guardada en tus favoritas!\' : \'Recipe saved to favorites!\');\n    }\n    setSavedRecipes(updated);\n    try {\n      localStorage.setItem(\'pantry_guard_saved_recipes\', JSON.stringify(updated));\n    } catch (e) {\n      console.warn(\'Could not save to localStorage:\', e);\n    }\n  };\n\n  // Add extra ingredients to shopping list\n  const handleAddExtraToShopping = (ingredientName: string, category: ProductCategory = \'otros\') => {\n    onAddShoppingItem({\n      name: ingredientName,\n      category,\n      quantity: 1,\n      unit: \'unidades\' as UnitType,\n      checked: false,\n      reason: \'low_stock\',\n      notes: isSpanish ? \'A\303\261adido para receta del Chef IA\' : \'Added for AI Chef recipe\',\n    });\n    setAddedExtraItems((prev) => ({ ...prev, [ingredientName]: true }));\n    onShowToast(\n      isSpanish\n        ? `\"${ingredientName}\" a\303\261adido a la lista de compras.`\n        : `\"${ingredientName}\" added to shopping list.`\n    );\n  };\n\n  // Reset Chef Chat\n  const handleResetChat = () => {\n    setChatMessages([\n      {\n        id: `msg-chef-init-${Date.now()}`,\n        sender: \'assistant\',\n        text: isSpanish\n          ? `\302\241Hola ${user.name.split(\' \')[0]}! Soy tu Chef IA especializado en Cocina Cero Desperdicio. He revisado tus ${validPantryItems.length} ingredientes v\303\241lidos${expiringSoonItems.length > 0 ? ` y tengo listos los ${expiringSoonItems.length} que vencen pronto para darles prioridad.` : \'.\'} \302\277Quieres una receta espec\303\255fica o tienes dudas sobre c\303\263mo cocinar o conservar alg\303\272n ingrediente?`\n          : `Hello ${user.name.split(\' \')[0]}! I am your Zero-Waste AI Chef. I inspected your ${validPantryItems.length} valid pantry staples${expiringSoonItems.length > 0 ? ` with top priority on the ${expiringSoonItems.length} near expiry.` : \'.\'} Feel free to ask for custom recipes, cooking advice, or ingredient substitutions!`,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      },\n    ]);\n    setChefQuery(\'\');\n    onShowToast(isSpanish ? \'Conversaci\303\263n con el Chef IA reiniciada.\' : \'Chat history cleared.\');\n  };\n\n  // Handle Chef chat query\n  const handleSendChefQuery = async (queryText?: string) => {\n    const textToSend = (queryText || chefQuery).trim();\n    if (!textToSend || isChefAsking) return;\n\n    const userMsg: ChatMessage = {\n      id: `user-${Date.now()}`,\n      sender: \'user\',\n      text: textToSend,\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n    };\n\n    setChatMessages((prev) => [...prev, userMsg]);\n    setChefQuery(\'\');\n    setIsChefAsking(true);\n\n    try {\n      const response = await fetch(\'/api/ai/ask-advisor\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          question: userMsg.text,\n          history: chatMessages.slice(-6).map((m) => ({ sender: m.sender, text: m.text })),\n          products: validPantryItems,\n          preferences,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(`HTTP ${response.status}`);\n      }\n\n      const data = await response.json();\n      const answerText = data.answer?.trim() || getContextualChefResponse(userMsg.text, validPantryItems, isSpanish);\n\n      const assistantMsg: ChatMessage = {\n        id: `chef-${Date.now()}`,\n        sender: \'assistant\',\n        text: answerText,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n\n      setChatMessages((prev) => [...prev, assistantMsg]);\n    } catch (err) {\n      console.warn(\'Chef live chat fallback active:\', err);\n      const fallbackText = getContextualChefResponse(userMsg.text, validPantryItems, isSpanish);\n      const fallbackMsg: ChatMessage = {\n        id: `chef-kb-${Date.now()}`,\n        sender: \'assistant\',\n        text: fallbackText,\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      };\n      setChatMessages((prev) => [...prev, fallbackMsg]);\n    } finally {\n      setIsChefAsking(false);\n    }\n  };"
        replacement_content: "import React, { useState, useEffect } from \'react\';\nimport {\n  AIRecipe,\n  AIRecipeResponse,\n  Product,\n  ShoppingItem,\n  UserPreferences,\n  UserProfile,\n  ProductCategory,\n  UnitType,\n} from \'../types\';\nimport { translations } from \'../utils/i18n\';\n\ninterface AIInsightsViewProps {\n  products: Product[];\n  shoppingItems: ShoppingItem[];\n  preferences: UserPreferences;\n  user: UserProfile;\n  onAddShoppingItem: (item: Omit<ShoppingItem, \'id\'>) => void;\n  onShowToast: (message: string) => void;\n  onNavigateTab: (tab: any) => void;\n}\n\ntype MealCategoryFilter = \'all\' | \'desayuno\' | \'almuerzo_cena\' | \'express\' | \'postre_snack\' | \'saved\';\n\nexport const AIInsightsView: React.FC<AIInsightsViewProps> = ({\n  products,\n  preferences,\n  user,\n  onAddShoppingItem,\n  onShowToast,\n}) => {\n  const t = translations[preferences.language || \'es\'];\n  const isSpanish = preferences.language !== \'en\';\n\n  const [recipeData, setRecipeData] = useState<AIRecipeResponse | null>(null);\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [selectedCategory, setSelectedCategory] = useState<MealCategoryFilter>(\'all\');\n  const [customPrompt, setCustomPrompt] = useState<string>(\'\');\n  const [savedRecipes, setSavedRecipes] = useState<AIRecipe[]>(() => {\n    try {\n      const stored = localStorage.getItem(\'pantry_guard_saved_recipes\');\n      return stored ? JSON.parse(stored) : [];\n    } catch {\n      return [];\n    }\n  });\n\n  const [activeRecipeDetails, setActiveRecipeDetails] = useState<AIRecipe | null>(null);\n  const [addedExtraItems, setAddedExtraItems] = useState<Record<string, boolean>>({});\n  const [completedSteps, setCompletedSteps] = useState<Record<string, boolean>>({});\n\n  // Expiration calculation for pantry safety indicators\n  const now = new Date();\n  const validPantryItems = products.filter((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n    return diffDays >= 0;\n  });\n\n  const expiringSoonItems = products.filter((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n    return diffDays >= 0 && diffDays <= 5;\n  });\n\n  const expiredItems = products.filter((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n    return diffDays < 0;\n  });\n\n  // Fetch or generate zero-waste recipes\n  const fetchRecipes = async (promptOverride?: string, mealTypeOverride?: string) => {\n    setIsLoading(true);\n    try {\n      const response = await fetch(\'/api/ai/recipes\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          products,\n          mealType: mealTypeOverride || selectedCategory,\n          customPrompt: promptOverride !== undefined ? promptOverride : customPrompt,\n          preferences,\n        }),\n      });\n\n      if (!response.ok) {\n        throw new Error(`HTTP error ${response.status}`);\n      }\n\n      const data: AIRecipeResponse = await response.json();\n      setRecipeData(data);\n      onShowToast(\n        isSpanish\n          ? \'\302\241El Chef IA ha creado nuevas recetas con tu despensa!\'\n          : \'AI Chef created new zero-waste recipes!\'\n      );\n    } catch (error) {\n      console.error(\'Failed to generate recipes:\', error);\n      onShowToast(\n        isSpanish\n          ? \'Se generaron recetas locales de aprovechamiento.\'\n          : \'Loaded local zero-waste recipes.\'\n      );\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  useEffect(() => {\n    fetchRecipes();\n  }, [preferences.language]);\n\n  // Handle saving recipe to local favorites\n  const toggleSaveRecipe = (recipe: AIRecipe) => {\n    const isAlreadySaved = savedRecipes.some((r) => r.id === recipe.id || r.title === recipe.title);\n    let updated: AIRecipe[];\n    if (isAlreadySaved) {\n      updated = savedRecipes.filter((r) => r.id !== recipe.id && r.title !== recipe.title);\n      onShowToast(isSpanish ? \'Receta eliminada de guardadas.\' : \'Recipe removed from saved.\');\n    } else {\n      updated = [{ ...recipe, isSaved: true }, ...savedRecipes];\n      onShowToast(isSpanish ? \'\302\241Receta guardada en tus favoritas!\' : \'Recipe saved to favorites!\');\n    }\n    setSavedRecipes(updated);\n    try {\n      localStorage.setItem(\'pantry_guard_saved_recipes\', JSON.stringify(updated));\n    } catch (e) {\n      console.warn(\'Could not save to localStorage:\', e);\n    }\n  };\n\n  // Add extra ingredients to shopping list\n  const handleAddExtraToShopping = (ingredientName: string, category: ProductCategory = \'otros\') => {\n    onAddShoppingItem({\n      name: ingredientName,\n      category,\n      quantity: 1,\n      unit: \'unidades\' as UnitType,\n      checked: false,\n      reason: \'low_stock\',\n      notes: isSpanish ? \'A\303\261adido para receta del Chef IA\' : \'Added for AI Chef recipe\',\n    });\n    setAddedExtraItems((prev) => ({ ...prev, [ingredientName]: true }));\n    onShowToast(\n      isSpanish\n        ? `\"${ingredientName}\" a\303\261adido a la lista de compras.`\n        : `\"${ingredientName}\" added to shopping list.`\n    );\n  };"
      }
      num_matches: 1
    }
  }
}
