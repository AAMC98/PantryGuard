    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { createServer as createViteServer } from \'vite\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\n// Lazy Gemini client helper\nfunction getGeminiClient() {\n  const apiKey = process.env.GEMINI_API_KEY;\n  if (!apiKey) return null;\n  return new GoogleGenAI({\n    apiKey,\n    httpOptions: {\n      headers: {\n        \'User-Agent\': \'aistudio-build\',\n      },\n    },\n  });\n}\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  app.use(express.json({ limit: \'10mb\' }));\n\n  // API Health Check\n  app.get(\'/api/health\', (req, res) => {\n    res.json({\n      status: \'ok\',\n      hasApiKey: !!process.env.GEMINI_API_KEY,\n      timestamp: new Date().toISOString(),\n    });\n  });\n\n  // POST /api/ai/analyze-trends\n  app.post(\'/api/ai/analyze-trends\', async (req, res) => {\n    try {\n      const { products = [], shoppingItems = [], preferences = { language: \'es\', unitSystem: \'metric\' } } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const ai = getGeminiClient();\n\n      // If no Gemini client is available, compute high-quality deterministic smart analysis\n      if (!ai) {\n        return res.json(generateLocalAnalysis(products, shoppingItems, preferences));\n      }\n\n      const promptContext = `\nEres el motor de Inteligencia Artificial experto en despensa, h\303\241bitos de compra y prevenci\303\263n de desperdicio de alimentos de la aplicaci\303\263n \"Pantry Guard\".\n\nAnaliza minuciosamente el siguiente inventario de la despensa y la lista de compras del usuario:\n\nINVENTARIO ACTUAL (${products.length} productos):\n${JSON.stringify(\n  products.map((p: any) => ({\n    name: p.name,\n    category: p.category,\n    quantity: p.quantity,\n    unit: p.unit,\n    expiryDate: p.expiryDate,\n    location: p.location,\n    notes: p.notes,\n  })),\n  null,\n  2\n)}\n\nLISTA DE COMPRAS ACTUAL (${shoppingItems.length} art\303\255culos):\n${JSON.stringify(\n  shoppingItems.map((s: any) => ({\n    name: s.name,\n    category: s.category,\n    quantity: s.quantity,\n    unit: s.unit,\n    reason: s.reason,\n  })),\n  null,\n  2\n)}\n\nPREFERENCIAS DEL USUARIO:\n- Idioma: ${preferences.language}\n- Sistema de unidades: ${preferences.unitSystem}\n- Fecha actual: ${new Date().toISOString().split(\'T\')[0]}\n\nTU OBJETIVO:\n1. **Analizar la tendencia de compras y rotaci\303\263n**: Identifica qu\303\251 productos se consumen m\303\241s r\303\241pido, cu\303\241les se agotan frecuentemente y requieren comprarse m\303\241s o reponerse proactivamente.\n2. **Identificar qu\303\251 NO deber\303\255a comprar el usuario ya**: Identifica productos en alto riesgo de desperdicio porque ya est\303\241n caducados, pr\303\263ximos a caducar en abundancia, o comprados en exceso que no se consumen a tiempo.\n3. **Pron\303\263stico semanal inteligente**: Qu\303\251 comprar exactamente y qu\303\251 evitar comprar.\n4. **Calcular un Puntaje de Eficiencia y Cero Desperdicio (0 a 100)** basado en la proporci\303\263n de productos frescos vs caducados/en riesgo.\n5. **Recomendaciones y Recetas de Rescate R\303\241pido**: Preparaciones culinarias pr\303\241cticas con los ingredientes que est\303\241n por vencer.\n\nGenera la respuesta estrictamente en formato JSON con la siguiente estructura y en el idioma ${isSpanish ? \'Espa\303\261ol\' : \'English\'}.\n`;\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.7-flash\',\n        contents: promptContext,\n        config: {\n          systemInstruction: `You are an expert AI food sustainability and grocery optimization analyst. Always return structured, actionable, and friendly recommendations strictly in JSON matching the specified schema. Language must be ${preferences.language === \'en\' ? \'English\' : \'Spanish\'}.`,\n          responseMimeType: \'application/json\',\n          responseSchema: {\n            type: Type.OBJECT,\n            properties: {\n              efficiencyScore: {\n                type: Type.INTEGER,\n                description: \'Pantry efficiency and waste prevention score from 0 to 100\',\n              },\n              efficiencyRating: {\n                type: Type.STRING,\n                description: \'Brief score badge like \"Excelente\", \"Bueno\" or \"Atenci\303\263n requerida\"\',\n              },\n              summary: {\n                type: Type.STRING,\n                description: \'2-3 sentence overview of user shopping patterns and waste risk\',\n              },\n              topBoughtVelocity: {\n                type: Type.ARRAY,\n                description: \'Products with high turnover that run out quickly or need repurchase\',\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    name: { type: Type.STRING },\n                    category: { type: Type.STRING },\n                    velocity: { type: Type.STRING, enum: [\'alta\', \'media\', \'baja\'] },\n                    velocityText: { type: Type.STRING, description: \'e.g. \"Se agota cada 3-4 d\303\255as\"\' },\n                    daysLeftEstimate: { type: Type.INTEGER },\n                    recommendedQuantity: { type: Type.NUMBER },\n                    unit: { type: Type.STRING },\n                    reason: { type: Type.STRING },\n                    isLow: { type: Type.BOOLEAN },\n                  },\n                  required: [\'name\', \'category\', \'velocity\', \'velocityText\', \'daysLeftEstimate\', \'recommendedQuantity\', \'unit\', \'reason\', \'isLow\'],\n                },\n              },\n              wasteRiskItems: {\n                type: Type.ARRAY,\n                description: \'Products that should NOT be bought right now or are at risk of spoiling\',\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    name: { type: Type.STRING },\n                    category: { type: Type.STRING },\n                    riskLevel: { type: Type.STRING, enum: [\'alto\', \'medio\', \'critico\'] },\n                    riskReason: { type: Type.STRING },\n                    recommendation: { type: Type.STRING },\n                    urgency: { type: Type.STRING, enum: [\'hoy\', \'proximos_dias\', \'evitar_compra\'] },\n                    avoidBuying: { type: Type.BOOLEAN },\n                  },\n                  required: [\'name\', \'category\', \'riskLevel\', \'riskReason\', \'recommendation\', \'urgency\', \'avoidBuying\'],\n                },\n              },\n              weeklyForecast: {\n                type: Type.OBJECT,\n                properties: {\n                  recommendedToBuy: {\n                    type: Type.ARRAY,\n                    items: {\n                      type: Type.OBJECT,\n                      properties: {\n                        name: { type: Type.STRING },\n                        category: { type: Type.STRING },\n                        quantity: { type: Type.NUMBER },\n                        unit: { type: Type.STRING },\n                        reason: { type: Type.STRING },\n                      },\n                      required: [\'name\', \'category\', \'quantity\', \'unit\', \'reason\'],\n                    },\n                  },\n                  avoidBuying: {\n                    type: Type.ARRAY,\n                    items: {\n                      type: Type.OBJECT,\n                      properties: {\n                        name: { type: Type.STRING },\n                        category: { type: Type.STRING },\n                        reason: { type: Type.STRING },\n                        currentStock: { type: Type.STRING },\n                      },\n                      required: [\'name\', \'category\', \'reason\', \'currentStock\'],\n                    },\n                  },\n                  budgetSavingTip: { type: Type.STRING },\n                },\n                required: [\'recommendedToBuy\', \'avoidBuying\', \'budgetSavingTip\'],\n              },\n              actionableTips: {\n                type: Type.ARRAY,\n                items: { type: Type.STRING },\n              },\n              recipeSuggestions: {\n                type: Type.ARRAY,\n                items: {\n                  type: Type.OBJECT,\n                  properties: {\n                    title: { type: Type.STRING },\n                    description: { type: Type.STRING },\n                    ingredientsToRescue: {\n                      type: Type.ARRAY,\n                      items: { type: Type.STRING },\n                    },\n                    prepTime: { type: Type.STRING },\n                    difficulty: { type: Type.STRING, enum: [\'F\303\241cil\', \'Media\', \'R\303\241pida\'] },\n                  },\n                  required: [\'title\', \'description\', \'ingredientsToRescue\', \'prepTime\', \'difficulty\'],\n                },\n              },\n            },\n            required: [\n              \'efficiencyScore\',\n              \'efficiencyRating\',\n              \'summary\',\n              \'topBoughtVelocity\',\n              \'wasteRiskItems\',\n              \'weeklyForecast\',\n              \'actionableTips\',\n              \'recipeSuggestions\',\n            ],\n          },\n        },\n      });\n\n      const parsed = JSON.parse(response.text || \'{}\');\n      parsed.lastAnalyzedAt = new Date().toISOString();\n      return res.json(parsed);\n    } catch (err: any) {\n      console.error(\'Error in /api/ai/analyze-trends:\', err);\n      // Fallback to local heuristic engine on any error so user experience is always fluid\n      const fallback = generateLocalAnalysis(req.body.products || [], req.body.shoppingItems || [], req.body.preferences);\n      return res.json(fallback);\n    }\n  });\n\n  // POST /api/ai/ask-advisor\n  app.post(\'/api/ai/ask-advisor\', async (req, res) => {\n    try {\n      const { question, products = [], shoppingItems = [], preferences = { language: \'es\' } } = req.body;\n      const isSpanish = preferences.language !== \'en\';\n      const ai = getGeminiClient();\n\n      if (!question || !question.trim()) {\n        return res.status(400).json({ error: \'Question is required\' });\n      }\n\n      if (!ai) {\n        return res.json({\n          answer: isSpanish\n            ? `Tu despensa cuenta actualmente con ${products.length} productos. Te sugiero priorizar el consumo de los l\303\241cteos y frutas m\303\241s pr\303\263ximos a caducar para evitar desperdicio.`\n            : `Your pantry currently has ${products.length} items. I recommend consuming dairy and fruits closest to expiration first to minimize waste.`,\n        });\n      }\n\n      const prompt = `\nEres el Asistente y Consultor de Despensa de Pantry Guard.\nResponde de manera c\303\241lida, concisa, pr\303\241ctica y directamente \303\272til a la siguiente pregunta del usuario:\n\"${question}\"\n\nCONTEXTO DE LA DESPENSA DEL USUARIO:\nProductos actuales (${products.length}):\n${JSON.stringify(products.map((p: any) => ({ name: p.name, category: p.category, qty: `${p.quantity} ${p.unit}`, exp: p.expiryDate, loc: p.location })))}\n\nLista de compras (${shoppingItems.length}):\n${JSON.stringify(shoppingItems.map((s: any) => ({ name: s.name, qty: `${s.quantity} ${s.unit}` })))}\n\nResponde en el idioma ${isSpanish ? \'Espa\303\261ol\' : \'English\'} con formato markdown limpio (negritas, vi\303\261etas breves si aplica) sin rodeos innecesarios.\n`;\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.7-flash\',\n        contents: prompt,\n      });\n\n      return res.json({\n        answer: response.text || (isSpanish ? \'No pude generar la respuesta en este momento.\' : \'Unable to generate response at this time.\'),\n      });\n    } catch (err: any) {\n      console.error(\'Error in /api/ai/ask-advisor:\', err);\n      const isSpanish = req.body.preferences?.language !== \'en\';\n      return res.json({\n        answer: isSpanish\n          ? \'Para optimizar tus compras, revisa primero los productos marcados en rojo en tu inventario y a\303\261ade solo aquellos con alta rotaci\303\263n a tu lista de compras.\'\n          : \'To optimize your grocery shopping, check the expiring items in your inventory first and add only high-velocity essentials to your list.\',\n      });\n    }\n  });\n\n  // Vite middleware setup\n  if (process.env.NODE_ENV !== \'production\') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Pantry Guard Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\n// Deterministic heuristic fallback generator when API key is offline or cold\nfunction generateLocalAnalysis(products: any[], shoppingItems: any[], preferences: any) {\n  const isSpanish = preferences?.language !== \'en\';\n  const now = new Date();\n  \n  let expiredCount = 0;\n  let expiringCount = 0;\n  let freshCount = 0;\n\n  const wasteRiskItems: any[] = [];\n  const velocityItems: any[] = [];\n\n  products.forEach((p) => {\n    const exp = new Date(p.expiryDate);\n    const diffDays = Math.ceil((exp.getTime() - now.getTime()) / (1000 * 3600 * 24));\n\n    if (diffDays < 0) {\n      expiredCount++;\n      wasteRiskItems.push({\n        name: p.name,\n        category: p.category,\n        riskLevel: \'critico\',\n        riskReason: isSpanish\n          ? `Caduc\303\263 hace ${Math.abs(diffDays)} d\303\255as (${p.quantity} ${p.unit}) en ${p.location}.`\n          : `Expired ${Math.abs(diffDays)} days ago (${p.quantity} ${p.unit}) in ${p.location}.`,\n        recommendation: isSpanish\n          ? `Evita recomprar hasta reevaluar tu ritmo de consumo real.`\n          : `Avoid repurchasing until evaluating your actual consumption rate.`,\n        urgency: \'evitar_compra\',\n        avoidBuying: true,\n      });\n    } else if (diffDays <= 4) {\n      expiringCount++;\n      wasteRiskItems.push({\n        name: p.name,\n        category: p.category,\n        riskLevel: \'alto\',\n        riskReason: isSpanish\n          ? `Vence en ${diffDays} d\303\255as (${p.quantity} ${p.unit}). Riesgo inminente de desperdicio.`\n          : `Expires in ${diffDays} days (${p.quantity} ${p.unit}). Imminent food waste risk.`,\n        recommendation: isSpanish\n          ? `Consumir hoy o incorporar en preparaciones r\303\241pidas.`\n          : `Consume today or incorporate into quick recipes.`,\n        urgency: \'hoy\',\n        avoidBuying: true,\n      });\n    } else {\n      freshCount++;\n      // If low quantity or essential staples\n      if (p.quantity <= 2 || [\'huevos\', \'leche\', \'yogurt\', \'pan\', \'frutas\'].some((k) => p.name.toLowerCase().includes(k))) {\n        velocityItems.push({\n          name: p.name,\n          category: p.category,\n          velocity: \'alta\',\n          velocityText: isSpanish ? \'Consumo frecuente estimado (cada 3-5 d\303\255as)\' : \'Estimated frequent consumption (every 3-5 days)\',\n          daysLeftEstimate: Math.max(1, Math.min(diffDays, 4)),\n          recommendedQuantity: p.quantity === 1 ? 2 : p.quantity,\n          unit: p.unit,\n          reason: isSpanish\n            ? `Baja existencia actual en ${p.location}. Conviene reponer en la pr\303\263xima compra.`\n            : `Low current stock in ${p.location}. Recommended to refill on next trip.`,\n          isLow: p.quantity <= 2,\n        });\n      }\n    }\n  });\n\n  const total = Math.max(1, products.length);\n  const efficiencyScore = Math.max(20, Math.min(98, Math.round(100 - (expiredCount * 15 + expiringCount * 8))));\n  const efficiencyRating = efficiencyScore >= 80 ? (isSpanish ? \'Excelente\' : \'Excellent\') : efficiencyScore >= 60 ? (isSpanish ? \'Bueno\' : \'Good\') : (isSpanish ? \'Atenci\303\263n requerida\' : \'Needs Attention\');\n\n  return {\n    efficiencyScore,\n    efficiencyRating,\n    summary: isSpanish\n      ? `Tu despensa tiene ${products.length} art\303\255culos registrados. Tienes ${expiringCount + expiredCount} producto(s) en zona de riesgo que no deber\303\255as recomprar por ahora, mientras que los esenciales de alta rotaci\303\263n como l\303\241cteos y huevos requieren reposici\303\263n controlada.`\n      : `Your pantry has ${products.length} registered items. You have ${expiringCount + expiredCount} item(s) at risk that shouldn\'t be repurchased yet, while high-velocity staples need controlled replenishment.`,\n    topBoughtVelocity: velocityItems.slice(0, 4),\n    wasteRiskItems: wasteRiskItems.slice(0, 4),\n    weeklyForecast: {\n      recommendedToBuy: velocityItems.slice(0, 3).map((v) => ({\n        name: v.name,\n        category: v.category,\n        quantity: v.recommendedQuantity,\n        unit: v.unit,\n        reason: v.reason,\n      })),\n      avoidBuying: wasteRiskItems.slice(0, 3).map((w) => ({\n        name: w.name,\n        category: w.category,\n        reason: w.riskReason,\n        currentStock: \'En existencia pr\303\263xima a vencer\',\n      })),\n      budgetSavingTip: isSpanish\n        ? \'Revisa tus verduras y l\303\241cteos antes de ir al supermercado: comprar solo las porciones de 3 d\303\255as reduce hasta un 30% el gasto mensual.\'\n        : \'Check your produce and dairy before shopping: buying 3-day portions reduces monthly food waste by up to 30%.\',\n    },\n    actionableTips: isSpanish\n      ? [\n          \'Agrupa los productos que vencen en menos de 4 d\303\255as en la bandeja frontal del refrigerador.\',\n          \'Si tienes fruta madura pr\303\263xima a caducar, c\303\263rtala y cong\303\251lala en porciones para licuados.\',\n          \'No compres paquetes familiares de productos perecederos si vives en un hogar de 1 o 2 personas.\',\n        ]\n      : [\n          \'Group items expiring in under 4 days on the front shelf of your fridge.\',\n          \'Freeze overripe fruits in portion bags for quick smoothies.\',\n          \'Avoid bulk buying perishable items unless you have an immediate meal plan.\',\n        ],\n    recipeSuggestions: [\n      {\n        title: isSpanish ? \'Bowl de Rescate con Fruta y Yogurt\' : \'Rescue Yogurt & Fruit Bowl\',\n        description: isSpanish\n          ? \'Combina los yogurts y frutas maduras con avena o semillas para un desayuno nutritivo sin desperdicio.\'\n          : \'Mix ripe fruits and yogurts with oats or seeds for a zero-waste nutritious breakfast.\',\n        ingredientsToRescue: [\'Yogurt\', \'Manzanas\', \'Avena\'],\n        prepTime: \'5 min\',\n        difficulty: \'R\303\241pida\',\n      },\n      {\n        title: isSpanish ? \'Tortilla R\303\241pida de Huevo y Verduras\' : \'Quick Egg & Veggie Frittata\',\n        description: isSpanish\n          ? \'Saltea las verduras pr\303\263ximas a vencer y a\303\261ade huevos batidos para una cena rica y r\303\241pida.\'\n          : \'Saut\303\251 near-expiry vegetables and fold with eggs for a fast, delicious dinner.\',\n        ingredientsToRescue: [\'Huevos\'],\n        prepTime: \'10 min\',\n        difficulty: \'F\303\241cil\',\n      },\n    ],\n    lastAnalyzedAt: new Date().toISOString(),\n  };\n}\n\nstartServer();\n"
    }
