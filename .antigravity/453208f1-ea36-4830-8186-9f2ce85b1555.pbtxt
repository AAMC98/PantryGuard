          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      case \'g\':"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return qty >= 1000 ? `\342\211\210 ${(qty / 1000).toFixed(2)} kg` : `\342\211\210 ${(qty * 0.035274).toFixed(2)} oz`;"
