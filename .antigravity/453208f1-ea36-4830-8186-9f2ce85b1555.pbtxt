    instruction: "Update handleImageUpload to handle ImageDecodeResult directly"
    replacement_infos {
      original_chunk {
        target_content: "  // Upload image / photo of barcode from gallery or camera capture\n  const handleImageUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (!e.target.files || e.target.files.length === 0) return;\n    const file = e.target.files[0];\n\n    setImageDecodingStatus(\'Analizando imagen del c\303\263digo de barras...\');\n    setIsResolving(true);\n\n    try {\n      // 1. Decode with multi-engine ZXing / Native BarcodeDetector (doesn\'t conflict with active camera)\n      const decoded = await decodeBarcodeFromImageFile(file);\n\n      if (decoded && decoded.trim().length > 0) {\n        setImageDecodingStatus(null);\n        await handleProcessBarcode(decoded.trim());\n      } else {\n        // Fallback: If camera is currently not active, try html5QrCode scanFile\n        setImageDecodingStatus(null);\n        alert(\n          \'No se pudo leer el c\303\263digo de barras en la foto de forma n\303\255tida. Prueba tomando la foto m\303\241s cerca con buena luz, o ingresa los n\303\272meros del c\303\263digo directamente.\'\n        );\n        setManualModalOpen(true);\n      }\n    } catch (err) {\n      console.warn(\'Image barcode decode notice:\', err);\n      setImageDecodingStatus(null);\n      alert(\'Hubo un problema al procesar la imagen. Puedes ingresar el c\303\263digo num\303\251rico directamente.\');\n      setManualModalOpen(true);\n    } finally {\n      setIsResolving(false);\n      setImageDecodingStatus(null);\n      if (fileInputRef.current) fileInputRef.current.value = \'\';\n    }\n  };"
        replacement_content: "  // Upload image / photo of barcode from gallery or camera capture\n  const handleImageUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (!e.target.files || e.target.files.length === 0) return;\n    const file = e.target.files[0];\n\n    setImageDecodingStatus(\n      preferences.language === \'en\'\n        ? \'Scanning image with AI Vision...\'\n        : \'Analizando imagen y extrayendo producto con IA...\'\n    );\n    setIsResolving(true);\n\n    try {\n      // Decode with Native BarcodeDetector / 1D ZXing / Gemini Vision Multimodal\n      const decoded = await decodeBarcodeFromImageFile(file, preferences?.language || \'es\');\n\n      if (decoded && decoded.lookupResult) {\n        playBeep();\n        setImageDecodingStatus(null);\n        setScannedResult(decoded.lookupResult);\n      } else if (decoded && decoded.barcode) {\n        setImageDecodingStatus(null);\n        await handleProcessBarcode(decoded.barcode);\n      } else {\n        setImageDecodingStatus(null);\n        alert(\n          preferences.language === \'en\'\n            ? \'Could not clearly recognize the product or barcode. Please try a closer photo or enter the numbers manually.\'\n            : \'No se pudo leer el c\303\263digo o empaque en la foto. Intenta con una foto m\303\241s cercana o escribe el c\303\263digo num\303\251rico.\'\n        );\n        setManualModalOpen(true);\n      }\n    } catch (err) {\n      console.warn(\'Image barcode decode notice:\', err);\n      setImageDecodingStatus(null);\n      alert(\n        preferences.language === \'en\'\n          ? \'There was an issue processing the image. You can enter the barcode numbers directly.\'\n          : \'Hubo un problema al procesar la imagen. Puedes ingresar el c\303\263digo num\303\251rico directamente.\'\n      );\n      setManualModalOpen(true);\n    } finally {\n      setIsResolving(false);\n      setImageDecodingStatus(null);\n      if (fileInputRef.current) fileInputRef.current.value = \'\';\n    }\n  };"
      }
      num_matches: 1
    }
  }
